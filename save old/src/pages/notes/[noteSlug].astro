---
import { entrySlug, isPublished } from '../../utils/content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import { imgSrc } from '../../utils/image';

export async function getStaticPaths() {
  const notes = await getCollection('notes', isPublished);
  return notes.map((note) => {
    const cleanSlug = entrySlug(note);
    return {
      params: { noteSlug: cleanSlug },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const { Content } = await render(note);
const noteSlug = entrySlug(note);

const displayImage = note.data.image || note.data.minimalImage;

// تشخیص خودکار اینکه author یک مدرس شناخته‌شده است (با اسلاگ یا نام کامل او نوشته شده)
// یا صرفاً یک نام آزاد (نویسنده مهمان بدون پروفایل مستقل) است.
const instructors = await getCollection('instructors', isPublished);
const matchedInstructor = note.data.author
  ? instructors.find((i) => {
      const iSlug = entrySlug(i);
      return iSlug === note.data.author || i.data.name === note.data.author;
    })
  : undefined;
const instructorSlug = matchedInstructor
  ? entrySlug(matchedInstructor)
  : '';

// برای Schema.org (که موتورهای جستجو می‌خوانند) همیشه نام رسمی و کامل استفاده می‌شود
const authorFullName = matchedInstructor ? matchedInstructor.data.name : note.data.author;
// برای نمایش بصری در خود صفحه، نام کوتاه (در صورت وجود) ترجیح داده می‌شود
const authorDisplayName = matchedInstructor
  ? (matchedInstructor.data.shortName || matchedInstructor.data.name)
  : note.data.author;
---

<Layout
  title={note.data.title}
  description={note.data.description}
  image={imgSrc(displayImage)}
  type="article"
  pubDate={note.data.pubDate}
  author={authorFullName}
  authorUrl={matchedInstructor ? `/instructors/${instructorSlug}/` : undefined}
  breadcrumbs={[
    { name: 'خانه', url: '/' },
    { name: 'یادداشت‌ها', url: '/notes/' },
    { name: note.data.title },
  ]}
>

  <main class="max-w-3xl mx-auto px-6 py-12 flex-grow w-full">
     
    <div class="mb-6">
      <a href="/notes/" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت به یادداشت‌ها</span>
      </a>
    </div>

    <article>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          {note.data.category && (
            <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {note.data.category}
            </span>
          )}
          {note.data.pubDate && (
            <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              <i class="fa-regular fa-calendar text-[var(--site-primary)]"></i>
              <span>{note.data.pubDate.toLocaleDateString('fa-IR')}</span>
            </span>
          )}
          {note.data.author && (
            matchedInstructor ? (
              <a
                href={`/instructors/${instructorSlug}/`}
                class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)]/20 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs transition"
              >
                <i class="fa-regular fa-user text-[var(--site-primary)]"></i>
                <span>{authorDisplayName}</span>
                <i class="fa-solid fa-arrow-left text-[9px] opacity-60"></i>
              </a>
            ) : (
              <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
                <i class="fa-regular fa-user text-[var(--site-primary)]"></i>
                <span>{authorDisplayName}</span>
              </span>
            )
          )}
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-6 leading-tight">
        {note.data.title}
      </h1>

      {note.data.description && (
        <p class="text-[var(--site-text)] text-base md:text-lg leading-relaxed mb-6 bg-[var(--site-card)] p-5 rounded-2xl border border-[var(--site-border)] shadow-xs">
          {note.data.description}
        </p>
      )}

      {displayImage && (
        <div class="w-full rounded-2xl overflow-hidden border border-[var(--site-border)] mb-6 bg-[var(--site-card)] flex items-center justify-center shadow-md">
          {typeof displayImage === 'string' ? (
            <img src={displayImage} alt={note.data.title} class="w-full h-auto object-contain" />
          ) : (
            <Image src={displayImage} alt={note.data.title} class="w-full h-auto object-contain" />
          )}
        </div>
      )}

      <hr class="border-[var(--site-border)] mb-10" />

      <div class="prose max-w-none leading-loose text-[var(--site-text)] space-y-6">
        <Content />
      </div>

      <hr class="border-[var(--site-border)] mb-10" />

      <TelegramCTA
        icon="fa-headset"
        heading="مشاوره و ارتباط با ما"
        description="برای مشاوره و ثبت‌نام در دوره‌ها و دریافت پروژه‌ها با آیدی"
      />

      <RelatedContent currentSlug={noteSlug} tags={note.data.tags} />

    </article>

  </main>

</Layout>
