{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "gams",
  "scopeName": "source.gams",
  "patterns": [
    {
      "name": "comment.line.asterisk.gams",
      "match": "^\\*.*$"
    },
    {
      "name": "keyword.control.gams",
      "match": "(?i)\\b(Sets?|Parameters?|Variables?|Equations?|Models?|Solve|using|minimizing|maximizing|lp|mip|nlp|minlp|all)\\b"
    },
    {
      "name": "keyword.operator.gams",
      "match": "(\\=e\\=|\\=l\\=|\\=g\\=|\\+|\\-|\\*|\\/|\\=)"
    },
    {
      "name": "constant.numeric.gams",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "variable.parameter.gams",
      "match": "\\b(up|lo|fx|m|l)\\b"
    }
  ]
}