---
// src/components/TelegramCTA.astro
// کارت مشترک تماس/ثبت‌نام تلگرامی - برای جلوگیری از تکرار در صفحات یادداشت/پروژه/دوره
interface Props {
  icon: string;      // مثل "fa-headset"
  heading: string;
  description: string; // متن قبل از آیدی؛ @pypyid خودکار اضافه می‌شود
  buttonText?: string;
}

const { icon, heading, description, buttonText = "ارتباط در تلگرام" } = Astro.props;
---

<div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-2xl shadow-xs mb-10 flex flex-col sm:flex-row items-center justify-between gap-6">
  <div class="text-right">
    <h3 class="text-base font-bold text-[var(--site-heading)] mb-1 flex items-center gap-2">
      <i class={`fa-solid ${icon} text-[var(--site-primary)]`}></i>
      <span>{heading}</span>
    </h3>
    <p class="text-xs sm:text-sm text-[var(--site-muted)] leading-relaxed">
      {description} <span class="font-bold text-[var(--site-text)]" dir="ltr">@pypyid</span> در تلگرام در تماس باشید.
    </p>
  </div>
  
  <a 
    href="https://t.me/pypyid"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-[var(--site-primary)] hover:bg-[var(--site-primary-hover)] text-white font-medium px-5 py-2.5 rounded-xl transition-all shadow-sm shadow-[var(--site-primary)]/20 text-xs sm:text-sm flex items-center gap-2 shrink-0 hover:-translate-y-0.5"
  >
    <i class="fa-brands fa-telegram text-base"></i>
    <span>{buttonText}</span>
  </a>
</div>