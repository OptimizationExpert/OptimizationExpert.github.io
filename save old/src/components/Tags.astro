---
interface Props {
  tags?: string[];
}

const { tags } = Astro.props;
---

{tags && tags.length > 0 && (
  <div class="flex flex-wrap items-center gap-2 mb-8">
    <span class="text-xs text-[var(--site-muted)] flex items-center gap-1">
      <i class="fa-solid fa-tags text-[var(--site-primary)]"></i>
      <span>برچسب‌ها:</span>
    </span>
    {tags.map((tag) => (
      <a 
        href={`/search/?tag=${encodeURIComponent(tag.trim())}`}
        class="text-xs bg-[var(--site-card)] text-[var(--site-text)] hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/50 px-3 py-1 rounded-full border border-[var(--site-border)] transition-all duration-300 shadow-2xs group"
      >
        <span class="text-[var(--site-primary)] opacity-80 group-hover:opacity-100">#</span>{tag}
      </a>
    ))}
  </div>
)}