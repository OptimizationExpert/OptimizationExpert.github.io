---
// src/components/ContentCard.astro
// کارت نمایش محتوا (دوره/مقاله/پروژه) - نسخه واحد برای جلوگیری از تکرار کد
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: string | ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  badge?: string;
  metaIcon: string;
  metaText: string;
  actionText: string;
  widthClass?: string;
}

const {
  href, image, imageAlt, title, description, badge, metaIcon, metaText, actionText,
  widthClass = "w-[250px] sm:w-[280px] md:w-[300px]",
} = Astro.props;
---

<article class={`${widthClass} flex-shrink-0 snap-start bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-4 flex flex-col justify-between hover:border-[var(--site-primary)]/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 shadow-sm group`}>
  <div>
    <div class="w-full aspect-video rounded-xl bg-[var(--site-bg)] mb-3 overflow-hidden border border-[var(--site-border)] relative">
      {typeof image === 'string' ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" />
      ) : (
        <Image src={image} alt={imageAlt} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" />
      )}
    </div>
    {badge && (
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="text-[10px] font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-2.5 py-1 rounded-lg border border-[var(--site-primary)]/20">
          {badge}
        </span>
      </div>
    )}
    <h5 class="text-sm font-bold leading-6 text-[var(--site-heading)] mb-2 min-h-[3rem] line-clamp-2 group-hover:text-[var(--site-primary)] transition-colors">
      <a href={href}>{title}</a>
    </h5>
    <p class="text-[var(--site-muted)] text-[11px] leading-5 line-clamp-2 mb-3">
      {description}
    </p>
  </div>
  <div class="pt-3 border-t border-[var(--site-border)]/60 flex items-center justify-between">
    <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 font-medium">
      <i class={`${metaIcon} text-[var(--site-primary)]`}></i>
      <span>{metaText}</span>
    </span>
    <a href={href} class="text-xs text-[var(--site-primary)] hover:opacity-80 font-bold inline-flex items-center gap-1.5 group/btn">
      <span>{actionText}</span>
      <i class="fa-solid fa-arrow-left text-[10px] group-hover/btn:-translate-x-1 transition-transform"></i>
    </a>
  </div>
</article>