---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="مشاوره تخصصی و پروژه‌ها" description="دریافت مشاوره تخصصی در زمینه بهینه‌سازی ریاضی، برنامه‌نویسی پایتون، سیستم‌های قدرت و توسعه وب‌سایت‌های مدرن استاتیک.">

  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 flex-grow w-full">
    
    <!-- هدر صفحه -->
    <div class="mb-10 border-b border-[var(--site-border)] pb-6">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3">
        مشاوره تخصصی و همکاری در پروژه‌ها
      </h1>
      <p class="text-[var(--site-muted)] text-xs sm:text-sm md:text-base leading-relaxed">
        اگر در زمینه برنامه‌نویسی پایتون، مدل‌سازی ریاضی، سالورهای بهینه‌سازی، سیستم‌های قدرت یا پیاده‌سازی وب‌سایت‌های استاتیک نیاز به مشاوره یا هم‌فکری دارید، می‌توانید از طریق راه‌های زیر در ارتباط باشید.
      </p>
    </div>

    <!-- کارت‌های حوزه‌های مشاوره -->
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 mb-12">
      
      <!-- کارت حوزه اول -->
      <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 rounded-2xl flex flex-col justify-between shadow-xs hover:border-[var(--site-primary)]/40 transition">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 flex items-center justify-center text-[var(--site-primary)] text-xl mb-4">
            <i class="fa-solid fa-code"></i>
          </div>
          <h2 class="text-base font-bold text-[var(--site-heading)] mb-2">بهینه‌سازی و پایتون</h2>
          <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed mb-4">
            مشاوره در پیاده‌سازی مدل‌های ریاضی، استفاده از Pyomo و تنظیم سالورهای HiGHS، CBC و IPOPT.
          </p>
        </div>
        <span class="text-xs text-[var(--site-primary)] font-medium bg-[var(--site-primary)]/10 px-3 py-1 rounded-full border border-[var(--site-primary)]/20 w-fit">
          تخصصی
        </span>
      </div>

      <!-- کارت حوزه دوم -->
      <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 rounded-2xl flex flex-col justify-between shadow-xs hover:border-[var(--site-primary)]/40 transition">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 flex items-center justify-center text-[var(--site-primary)] text-xl mb-4">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h2 class="text-base font-bold text-[var(--site-heading)] mb-2">سیستم‌های قدرت</h2>
          <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed mb-4">
            بررسی شبکه‌های الکتریکی، محاسبات پخش بار.
          </p>
        </div>
        <span class="text-xs text-[var(--site-primary)] font-medium bg-[var(--site-primary)]/10 px-3 py-1 rounded-full border border-[var(--site-primary)]/20 w-fit">
          مهندسی برق
        </span>
      </div>

      <!-- کارت حوزه سوم -->
      <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 rounded-2xl flex flex-col justify-between shadow-xs hover:border-[var(--site-primary)]/40 transition sm:col-span-2 md:col-span-1">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 flex items-center justify-center text-[var(--site-primary)] text-xl mb-4">
            <i class="fa-solid fa-globe"></i>
          </div>
          <h2 class="text-base font-bold text-[var(--site-heading)] mb-2">توسعه وب استاتیک</h2>
          <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed mb-4">
            ساخت وب‌سایت‌های مدرن، امن و فوق‌سریع مبتنی بر Astro و Markdown بدون دیتابیس و وردپرس.
          </p>
        </div>
        <span class="text-xs text-[var(--site-primary)] font-medium bg-[var(--site-primary)]/10 px-3 py-1 rounded-full border border-[var(--site-primary)]/20 w-fit">
          وب مدرن
        </span>
      </div>

    </div>

    <!-- بخش راه‌های ارتباطی مستقیم (طراحی عمودی و استاندارد) -->
    <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-2xl shadow-sm text-center">
      <h2 class="text-2xl font-bold text-[var(--site-heading)] mb-2">راه‌های ارتباطی</h2>
      <p class="text-[var(--site-muted)] text-xs md:text-sm mb-8">
        برای طرح سوالات، جزئیات پروژه‌ها و هماهنگی جلسات مشاوره می‌توانید از طریق راه‌های زیر پیام ارسال کنید.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-xl mx-auto">
        
        <!-- کارت ارتباطی: تلگرام -->
        <a href="https://t.me/pypyid" target="_blank" rel="noopener noreferrer" class="bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-primary)] p-6 rounded-2xl flex flex-col items-center text-center transition group">
          <div class="w-14 h-14 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-500 text-2xl mb-4 group-hover:scale-110 transition shadow-xs">
            <i class="fa-brands fa-telegram"></i>
          </div>
          <span class="text-xs text-[var(--site-muted)] mb-1 font-medium">تلگرام</span>
          <span class="text-sm sm:text-base font-bold text-[var(--site-heading)] tracking-wide" dir="ltr">@pypyid</span>
        </a>

        <!-- کارت ارتباطی: ایمیل -->
        <a href="mailto:optimizationteamonline@gmail.com" class="bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-primary)] p-6 rounded-2xl flex flex-col items-center text-center transition group">
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 text-xl mb-4 group-hover:scale-110 transition shadow-xs">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <span class="text-xs text-[var(--site-muted)] mb-1 font-medium">ایمیل</span>
          <span class="text-xs sm:text-sm md:text-base font-bold text-[var(--site-heading)] tracking-tight" dir="ltr">optimizationteamonline@gmail.com</span>
        </a>

      </div>
    </div>

  </main>

  <Footer />

</Layout>