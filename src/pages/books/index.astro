---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

let books = [];
try {
  books = await getCollection('books');
} catch (e) {
  books = [];
}

const defaultImage = "/images/courses/python-optimization.png";
---

<Layout title="کتاب‌ها و جزوات تخصصی" description="مجموعه‌ای از جزوات علمی، کتاب‌های مرجع و راهنماهای کاربردی در حوزه‌های مهندسی برق، سیستم‌های قدرت و بهینه‌سازی با پایتون.">


  <main class="flex-grow">
    
    <section class="bg-[var(--site-card)] border-b border-[var(--site-border)] py-16 px-6">
      <div class="max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/20">
          <i class="fa-solid fa-book"></i>
          <span>منابع مطالعاتی و مرجع</span>
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-[var(--site-heading)] tracking-tight">
          کتاب‌ها و جزوات تخصصی
        </h1>
        <p class="text-[var(--site-muted)] text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
          مجموعه‌ای از جزوات علمی، کتاب‌های مرجع و راهنماهای کاربردی در حوزه‌های مهندسی برق، سیستم‌های قدرت و بهینه‌سازی با پایتون.
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-12">
      {books.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {books.map((book) => {
            const cleanSlug = book.id.replace(/\.md$/, '').split('/').pop();
            const bookImg = book.data.image || defaultImage;
            return (
              <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)]/40 hover:shadow-md transition-all duration-300 shadow-xs">
                <div>
                  <div class="w-full aspect-[3/4] rounded-xl bg-[var(--site-bg)] mb-4 overflow-hidden border border-[var(--site-border)] relative group">
                    {typeof bookImg === 'string' ? (
                      <img src={bookImg} alt={book.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    ) : (
                      <Image src={bookImg} alt={book.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    )}
                    {book.data.format && (
                      <span class="absolute top-3 left-3 bg-[var(--site-card)]/90 backdrop-blur text-[var(--site-primary)] text-[10px] font-semibold px-2.5 py-1 rounded-full border border-[var(--site-border)]">
                        {book.data.format}
                      </span>
                    )}
                  </div>

                  <div class="flex items-center gap-2 mb-2">
                    {book.data.category && (
                      <span class="text-[11px] text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-2.5 py-0.5 rounded-full border border-[var(--site-primary)]/20 font-medium">
                        {book.data.category}
                      </span>
                    )}
                    {book.data.pages && (
                      <span class="text-[11px] text-[var(--site-muted)]">
                        <i class="fa-regular fa-file-lines ml-1 text-[var(--site-primary)]"></i>
                        {book.data.pages} صفحه
                      </span>
                    )}
                  </div>

                  <h3 class="text-base font-bold text-[var(--site-heading)] mb-2 line-clamp-2">
                    <a href={`/books/${cleanSlug}`} class="hover:text-[var(--site-primary)] transition">{book.data.title}</a>
                  </h3>

                  <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-3 mb-4">
                    {book.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-[var(--site-border)] flex items-center justify-between">
                  <span class="text-xs font-semibold text-emerald-600">{book.data.price || "رایگان"}</span>
                  <a href={`/books/${cleanSlug}`} class="text-xs text-[var(--site-primary)] hover:opacity-80 font-medium inline-flex items-center gap-1 transition">
                    <span>دانلود / مطالعه</span>
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 space-y-4">
          <div class="w-16 h-16 bg-[var(--site-card)] rounded-full flex items-center justify-center mx-auto text-[var(--site-primary)] text-2xl border border-[var(--site-border)] shadow-xs">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <h3 class="text-lg font-bold text-[var(--site-heading)]">به‌زودی جزوات و کتاب‌های جدید اضافه خواهند شد</h3>
          <p class="text-[var(--site-muted)] text-xs max-w-md mx-auto leading-relaxed">
            در حال آماده‌سازی و تدوین جزوات و منابع تخصصی مهندسی و برنامه‌نویسی هستیم. لطفاً بعداً سر بزنید.
          </p>
        </div>
      )}
    </section>

  </main>


</Layout>