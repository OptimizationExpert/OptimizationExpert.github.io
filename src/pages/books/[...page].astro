---
import { entrySlug, isPublished } from '../../utils/content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
  let books = [];
  try {
    books = await getCollection('books', isPublished);
  } catch (e) {
    books = [];
  }

  const sortedBooks = books.sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  });

  return paginate(sortedBooks, { pageSize: 10 });
}

const { page } = Astro.props;
// تصویر پیش‌فرض یکسان با بقیه‌ی سایت (قبلاً به‌اشتباه تصویر یک دوره استفاده می‌شد)
const defaultImage = "/images/hero.webp";
import { sized, CARD } from '../../utils/image-sizes';
---

<Layout title="کتاب و جزوه بهینه‌سازی و پایتون (دانلود PDF)" description="جزوات و کتاب‌های مرجع بهینه‌سازی ریاضی، Pyomo، OR-Tools و سیستم‌های قدرت به زبان فارسی — آماده دانلود برای دانشجویان و مهندسان." 
  pageNumber={page.currentPage}
  breadcrumbs={[{ name: 'خانه', url: '/' }, { name: 'کتاب‌ها و جزوات' }]}>

  <main class="flex-grow">
    
    <section class="bg-[var(--site-card)] border-b border-[var(--site-border)] py-16 px-6">
      <div class="max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/20">
          <i class="fa-solid fa-book"></i>
          <span>منابع مطالعاتی و مرجع</span>
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-[var(--site-heading)] tracking-tight">
          کتاب و جزوه بهینه‌سازی و پایتون (دانلود PDF)
        </h1>
        <p class="text-[var(--site-muted)] text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
          جزوات و کتاب‌های مرجع بهینه‌سازی ریاضی، Pyomo، OR-Tools و سیستم‌های قدرت به زبان فارسی — آماده دانلود برای دانشجویان و مهندسان.
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-12">
      {page.data.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.data.map((book) => {
            const cleanSlug = entrySlug(book);
            const bookImg = book.data.image || defaultImage;
            return (
              <div class="card-stretched relative bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)]/40 hover:shadow-md transition-all duration-300 shadow-xs">
                <div>
                  <div class="w-full aspect-[3/4] rounded-xl bg-[var(--site-bg)] mb-4 overflow-hidden border border-[var(--site-border)] relative group">
                    {typeof bookImg === 'string' ? (
                      <img src={bookImg} alt={book.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    ) : (
                      <Image src={bookImg} alt={book.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" {...sized(bookImg, CARD)} />
                    )}
                    {book.data.format && (
                      <span class="absolute top-3 left-3 bg-[var(--site-card)]/90 backdrop-blur text-[var(--site-primary)] text-[10px] font-semibold px-2.5 py-1 rounded-full border border-[var(--site-border)]">
                        {book.data.format}
                      </span>
                    )}
                  </div>

                  <div class="flex items-center gap-2 mb-2">
                    {book.data.category && (
                      <span class="text-[11px] text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-2.5 py-0.5 rounded-full border border-[var(--site-primary)]/20 font-medium">
                        {book.data.category}
                      </span>
                    )}
                    {book.data.pages && (
                      <span class="text-[11px] text-[var(--site-muted)]">
                        <i class="fa-regular fa-file-lines ml-1 text-[var(--site-primary)]"></i>
                        {book.data.pages} صفحه
                      </span>
                    )}
                  </div>

                  <h3 class="text-base font-bold text-[var(--site-heading)] mb-2 line-clamp-2">
                    <a href={`/books/${cleanSlug}/`} class="stretched-card-link hover:text-[var(--site-primary)] transition">{book.data.title}</a>
                  </h3>

                  <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-3 mb-4">
                    {book.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-[var(--site-border)] flex items-center justify-between">
                  <span class="text-xs font-semibold text-[var(--site-accent)]">{book.data.price || "رایگان"}</span>
                  <a href={`/books/${cleanSlug}/`} class="card-action-link text-xs text-[var(--site-primary)] hover:opacity-80 font-medium inline-flex items-center gap-1 transition">
                    <span>دانلود / مطالعه</span>
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 space-y-4">
          <div class="w-16 h-16 bg-[var(--site-card)] rounded-full flex items-center justify-center mx-auto text-[var(--site-primary)] text-2xl border border-[var(--site-border)] shadow-xs">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <h3 class="text-lg font-bold text-[var(--site-heading)]">به‌زودی جزوات و کتاب‌های جدید اضافه خواهند شد</h3>
          <p class="text-[var(--site-muted)] text-xs max-w-md mx-auto leading-relaxed">
            در حال آماده‌سازی و تدوین جزوات و منابع تخصصی مهندسی و برنامه‌نویسی هستیم. لطفاً بعداً سر بزنید.
          </p>
        </div>
      )}

      <!-- بخش شماره‌گذاری صفحات (Pagination) -->
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        basePath="/books/"
      />
    </section>

    {page.currentPage === 1 && (
      <section class="max-w-4xl mx-auto px-6 pb-16 text-[var(--site-text)] text-sm md:text-base leading-loose" aria-labelledby="about-books-title">
        <h2 id="about-books-title" class="text-2xl font-black text-[var(--site-heading)] mb-4">دربارهٔ این منابع</h2>
        <p class="mb-4">
          <a href="/books/pyomo-optimization-guide/" class="text-[var(--site-primary)] font-bold hover:underline">راهنمای جامع بهینه‌سازی با Pyomo و پایتون</a> یک جزوهٔ فارسی ۲۱۰ صفحه‌ای و رایگان است. از مبانی مدل‌سازی ریاضی و دسته‌بندی مسائل (LP، MILP، NLP و MINLP) شروع می‌کند، نصب Pyomo و سالورهای HiGHS، CBC و IPOPT را توضیح می‌دهد، و به مدل‌سازی مسائل مهندسی و شبکه‌های قدرت می‌رسد.
        </p>
        <p class="mb-4">
          این جزوه برای دانشجویان تحصیلات تکمیلی، پژوهشگران و مهندسانی نوشته شده که می‌خواهند مدل‌های بهینه‌سازی را بدون نیاز به نرم‌افزار تجاری، در پایتون پیاده کنند؛ به‌ویژه در مهندسی برق و سیستم‌های قدرت.
        </p>

        <p class="mb-4">
          برای کسانی که با OR-Tools کار می‌کنند، کتاب انگلیسی و رایگان <a href="/books/cpsat-declarative-modeling/" class="text-[var(--site-primary)] font-bold hover:underline">Declarative Modeling with CP-SAT</a> نوشتهٔ دومینیک کروپکه هم در این بخش قرار دارد. این کتاب روشی منظم برای تبدیل یک مسئلهٔ واقعی به مدل درست CP-SAT آموزش می‌دهد و با مجوز CC BY 4.0 منتشر شده است.
        </p>

        <h2 class="text-2xl font-black text-[var(--site-heading)] mt-10 mb-4">چطور از این جزوه بیشترین استفاده را ببرید؟</h2>
        <p class="mb-4">
          جزوه را کنار <a href="/pyomo/" class="text-[var(--site-primary)] font-bold hover:underline">راهنمای جامع آموزش Pyomo</a> بخوانید. راهنما مسیر یادگیری را مرحله‌به‌مرحله نشان می‌دهد و برای هر فصل، یادداشت‌های عملی با مسئلهٔ واقعی دارد. اگر تازه شروع کرده‌اید، پیش از جزوه یادداشت <a href="/notes/mathematical-modeling-art/" class="text-[var(--site-primary)] font-bold hover:underline">مدل‌سازی ریاضی و اهمیت آن برای برنامه‌نویسی</a> را مطالعه کنید.
        </p>
        <p class="mb-4">
          برای یادگیری ساختاریافته با تمرین و پشتیبانی، دوره‌های <a href="/courses/optimization-modeling/" class="text-[var(--site-primary)] font-bold hover:underline">مدل‌سازی مسائل بهینه‌سازی</a> و <a href="/courses/advanced-power-system/" class="text-[var(--site-primary)] font-bold hover:underline">بهینه‌سازی پیشرفتهٔ سیستم قدرت</a> همین مسیر را به‌صورت پروژه‌محور پوشش می‌دهند.
        </p>

        <h2 class="text-2xl font-black text-[var(--site-heading)] mt-10 mb-4">کتاب انگلیسی: Power System Optimization Modeling in GAMS</h2>
        <p>
          کتاب انگلیسی دکتر علیرضا سرودی دربارهٔ مدل‌سازی بهینه‌سازی سیستم قدرت در GAMS، در سال ۲۰۱۷ توسط انتشارات Springer منتشر شده است. معرفی کتاب و کتابخانهٔ مدل‌های همراه آن در صفحهٔ <a href="/softwares/gamsopt/" class="text-[var(--site-primary)] font-bold hover:underline">بهینه‌سازی سیستم قدرت در GAMS</a> آمده است. اگر با GAMS کار کرده‌اید و می‌خواهید به پایتون مهاجرت کنید، سری یادداشت‌های <a href="/pyomo/#gams" class="text-[var(--site-primary)] font-bold hover:underline">از GAMS به پایتون</a> برای شما نوشته شده است.
        </p>
      </section>
    )}

  </main>

</Layout>