---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// حوزه‌های تخصصی
const skills = [
  { title: "پایتون و بهینه‌سازی", desc: "مدل‌سازی ریاضی، برنامه‌نویسی و استفاده از سالورهای Pyomo و HiGHS", icon: "fa-terminal" },
  { title: "مهندسی برق قدرت", desc: "تحلیل شبکه‌های توزیع", icon: "fa-bolt" },
  { title: "گمز و بهینه سازی", desc: "مدل‌سازی ریاضی، برنامه‌نویسی در گمز", icon: "fa-solar-panel" },
];
---

<Layout title="درباره ما" description="نگاهی کوتاه به مسیر تخصصی، تجربیات و حوزه‌های فعالیت من در دنیای مهندسی، برنامه‌نویسی و سیستم‌های انرژی.">

  <Header />

  <!-- ساختار استاندارد و هماهنگ با سایر صفحات سایت -->
  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">

    <!-- هدر صفحه -->
    <div class="mb-10 border-b border-[var(--site-border)] pb-6">
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3">
        درباره ما
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed">
        نگاهی کوتاه به مسیر تخصصی، تجربیات و حوزه‌های فعالیت من در دنیای مهندسی و فناوری.
      </p>
    </div>

    <!-- بخش بیوگرافی و معرفی با استفاده از کارت‌های سازگار با تم -->
    <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-2xl mb-10 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-xs">

        <!-- آواتار / تصویر پروفایل -->
        <div class="w-32 h-32 rounded-2xl bg-[var(--site-bg)] border border-[var(--site-border)] flex items-center justify-center flex-shrink-0 shadow-xs overflow-hidden">
          <img src="/images/instructors/dr-soroudi.jpg" alt="نام مدرس" class="w-full h-full object-cover" />
        </div>

      <!-- متن بیوگرافی -->
      <div class="space-y-4 text-[var(--site-text)] text-sm md:text-base leading-relaxed text-right">
        <h2 class="text-xl font-bold text-[var(--site-heading)]">دکتر علیرضا سرودی</h2>
        <p>
          فعال در حوزه‌ی تلاقی مهندسی برق، زنجیره تامین و مدل‌سازی ریاضی با پایتون . هدف این مجموعه ارائه راهکارهای بهینه و کاربردی برای حل مسائل پیچیده مهندسی است.
        </p>
        <p class="text-[var(--site-muted)] text-xs md:text-sm">
          باور داریم ترکیب دانش تخصصی مهندسی و ابزارهای نرم‌افزاری دقیق، کلید اصلی خلق راه‌حل‌های پایدار و سریع می باشد.
        </p>
      </div>

    </div>

    <!-- بخش تخصص‌ها و مهارت‌ها -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--site-heading)] mb-6">حوزه‌های تخصص و مهارت‌ها</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          skills.map((skill) => (
            <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-5 rounded-2xl hover:border-[var(--site-primary)]/40 hover:shadow-md transition flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center flex-shrink-0 text-base mt-1">
                <i class={`fa-solid ${skill.icon}`}></i>
              </div>
              <div>
                <h3 class="text-base font-bold text-[var(--site-heading)] mb-1">{skill.title}</h3>
                <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed">{skill.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- دکمه‌های اقدام (Call to action) -->
    <div class="pt-6 border-t border-[var(--site-border)] flex flex-wrap items-center gap-4">
      <a href="/contact" class="bg-[var(--site-primary)] hover:opacity-90 text-white font-medium px-6 py-3 rounded-xl transition shadow-md shadow-sky-500/20 text-sm inline-flex items-center gap-2">
        <i class="fa-solid fa-paper-plane text-xs"></i>
        <span>ارتباط با من</span>
      </a>
      <a href="/projects" class="bg-[var(--site-card)] hover:bg-[var(--site-bg)] text-[var(--site-primary)] border border-[var(--site-border)] font-medium px-6 py-3 rounded-xl transition text-sm inline-flex items-center gap-2">
        <i class="fa-solid fa-code-branch text-xs"></i>
        <span>مشاهده پروژه‌ها</span>
      </a>
    </div>

  </main>

  <Footer />

</Layout>
