---
import Layout from '../layouts/Layout.astro';

const contactInfo = [
  {
    title: "ایمیل",
    value: "optimizationteamonline@gmail.com",
    icon: "fa-envelope",
    iconSet: "fa-solid",
    href: "mailto:optimizationteamonline@gmail.com",
    desc: "مناسب برای ارسال شرح پروژه، فایل داده و کد"
  },
  { 
    title: "تلگرام", 
    value: "@pypyid", 
    icon: "fa-telegram", 
    href: "https://t.me/pypyid", 
    desc: "ارتباط مستقیم و گفتگو در پیام‌رسان" 
  },
  { 
    title: "لینکدین", 
    value: "linkedin.com/in/soroudi", 
    icon: "fa-linkedin", 
    href: "https://www.linkedin.com/in/soroudi/", 
    desc: "مشاهده سوابق حرفه‌ای و شبکه تخصصی" 
  },
  { 
    title: "گیت‌هاب", 
    value: "github.com/OptimizationExpert", 
    icon: "fa-github", 
    href: "https://github.com/OptimizationExpert", 
    desc: "بررسی پروژه‌ها و کدهای منبع" 
  },
];
---

<Layout title="تماس با ما" description="راه‌های ارتباط با optexpert.org و دکتر علیرضا سرودی: ایمیل، تلگرام، لینکدین و گیت‌هاب؛ برای مشاوره پروژه، پرسش دربارهٔ دوره‌ها و همکاری علمی." breadcrumbs={[{ name: 'خانه', url: '/' }, { name: 'تماس با ما' }]}>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12 flex-grow w-full">
    
    <div class="mb-10 text-center border-b border-[var(--site-border)] pb-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3">
        تماس با ما
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed max-w-xl mx-auto">
        اگر سؤالی دارید و یا می‌خواهید در پروژه‌ای همکاری کنید، می‌توانید از طریق راه‌های زیر در ارتباط باشید.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 max-w-xl mx-auto">
      {
        contactInfo.map((item) => (
          <a 
            href={item.href} 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-[var(--site-card)] border border-[var(--site-border)] p-5 rounded-2xl hover:border-[var(--site-primary)]/60 transition flex items-center gap-4 group block shadow-xs"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center flex-shrink-0 text-xl group-hover:scale-110 transition">
              <i class={`${item.iconSet ?? "fa-brands"} ${item.icon}`} aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0 text-right">
              <div class="text-xs text-[var(--site-muted)] font-medium mb-0.5">{item.title}</div>
              <div class="text-sm sm:text-base font-bold text-[var(--site-text)] truncate" dir="ltr">{item.value}</div>
              <div class="text-xs text-[var(--site-muted)] mt-1">{item.desc}</div>
            </div>
          </a>
        ))
      }
    </div>

    <section class="max-w-xl mx-auto mt-10 bg-[var(--site-card)] border border-[var(--site-border)] p-6 rounded-2xl shadow-xs" aria-labelledby="route-title">
      <h2 id="route-title" class="text-lg font-bold text-[var(--site-heading)] mb-4">پیامتان را به کجا بفرستید؟</h2>
      <ul class="space-y-3 text-sm leading-loose text-[var(--site-text)]">
        <li><i class="fa-solid fa-briefcase text-[var(--site-primary)] ml-2" aria-hidden="true"></i><strong class="text-[var(--site-heading)]">پروژه و مشاوره:</strong> ابتدا صفحهٔ <a href="/consultation/" class="text-[var(--site-primary)] font-bold hover:underline">مشاوره تخصصی</a> را ببینید تا بدانید چه اطلاعاتی همراه پیام بفرستید؛ سپس از طریق ایمیل یا تلگرام پیام دهید.</li>
        <li><i class="fa-solid fa-graduation-cap text-[var(--site-primary)] ml-2" aria-hidden="true"></i><strong class="text-[var(--site-heading)]">پرسش دربارهٔ دوره‌ها:</strong> برای سؤال دربارهٔ محتوا و ثبت‌نام <a href="/courses/" class="text-[var(--site-primary)] font-bold hover:underline">دوره‌ها</a>، تلگرام سریع‌ترین راه است.</li>
        <li><i class="fa-solid fa-handshake text-[var(--site-primary)] ml-2" aria-hidden="true"></i><strong class="text-[var(--site-heading)]">همکاری علمی و حرفه‌ای:</strong> برای همکاری پژوهشی، سخنرانی یا آموزش سازمانی از طریق لینکدین یا ایمیل در ارتباط باشید.</li>
      </ul>
    </section>

  </main>

</Layout>