---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// دریافت کل محتواها از هر سه مجموعه
const allNotes = await getCollection('notes');
const allProjects = await getCollection('projects');
const allCourses = await getCollection('courses');

// ترکیب همه مطالب در یک آرایه واحد با مشخص کردن نوع آن‌ها
const allItems = [
  ...allNotes.map(item => ({ ...item, type: 'مقاله', url: `/notes/${item.id.replace(/\.md$/, '').split('/').pop()}` })),
  ...allProjects.map(item => ({ ...item, type: 'پروژه', url: `/projects/${item.id.replace(/\.md$/, '').split('/').pop()}` })),
  ...allCourses.map(item => ({ ...item, type: 'دوره آموزشی', url: `/courses/${item.id.replace(/\.md$/, '').split('/').pop()}` })),
];
---

<Layout title="نتیجه جستجو" description="جستجو در یادداشت‌ها، پروژه‌ها، دوره‌های آموزشی و کتاب‌های تخصصی مدل‌سازی و بهینه‌سازی سیستم قدرت در پایتون.">

  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
     
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-[var(--site-heading)] mb-2">نتایج جستجو</h1>
      <p id="search-query-text" class="text-[var(--site-muted)] text-sm"></p>
    </div>

    <!-- کانتینر نتایج که با جاوااسکریپت پر می‌شود -->
    <div id="search-results-container" class="space-y-4">
      <!-- نتایج اینجا لود می‌شوند -->
    </div>

  </main>

  <Footer />

  <!-- اسکریپت پردازش کلمه جستجوشده از URL -->
  <script define:vars={{ allItems }}>
    const urlParams = new URLSearchParams(window.location.search);
    const query = (urlParams.get('q') || '').trim().toLowerCase();
    
    const queryTextEl = document.getElementById('search-query-text');
    const resultsContainer = document.getElementById('search-results-container');

    if (query) {
      queryTextEl.textContent = `نمایش نتایج برای جستجوی: "${query}"`;

      // فیلتر کردن مطالب بر اساس عنوان یا توضیحات
      const filtered = allItems.filter(item => {
        const title = (item.data.title || '').toLowerCase();
        const desc = (item.data.description || '').toLowerCase();
        return title.includes(query) || desc.includes(query);
      });

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `
          <div class="text-center py-12 bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl shadow-xs">
            <p class="text-[var(--site-muted)]">متأسفانه موردی مطابق با جستجوی شما پیدا نشد.</p>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = filtered.map(item => `
          <article class="bg-[var(--site-card)] border border-[var(--site-border)] p-5 rounded-2xl hover:border-[var(--site-primary)]/40 transition shadow-xs flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
              <span class="text-[11px] text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-2.5 py-0.5 rounded-full border border-[var(--site-primary)]/20 font-medium mb-2 inline-block">
                ${item.type}
              </span>
              <h2 class="text-lg font-bold text-[var(--site-heading)] mb-1">
                <a href="${item.url}" class="hover:text-[var(--site-primary)] transition">${item.data.title}</a>
              </h2>
              <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-2">
                ${item.data.description}
              </p>
            </div>
            <a href="${item.url}" class="text-xs text-[var(--site-primary)] hover:opacity-80 font-medium whitespace-nowrap inline-flex items-center gap-1">
              <span>مشاهده</span>
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
            </a>
          </article>
        `).join('');
      }
    } else {
      queryTextEl.textContent = 'لطفاً کلمه‌ای را برای جستجو وارد کنید.';
    }
  </script>

</Layout>
