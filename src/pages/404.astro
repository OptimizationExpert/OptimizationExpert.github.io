---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="صفحه پیدا نشد | ۴۰۴" description="صفحه‌ای که به دنبال آن بودید یافت نشد یا به آدرس دیگری منتقل شده است.">

  <Header />

  <main class="max-w-xl mx-auto px-6 py-24 flex-grow flex flex-col items-center justify-center text-center">
    
    <!-- عدد ۴۰۴ بزرگ و هماهنگ با تم و سایه ملایم -->
    <div class="text-9xl md:text-[180px] font-extrabold text-[var(--site-primary)]/80 mb-4 tracking-wider drop-shadow-[0_15px_30px_rgba(2,132,199,0.15)] leading-none select-none">
      ۴۰۴
    </div>

    <!-- عنوان خطا -->
    <h1 class="text-2xl md:text-3xl font-bold text-[var(--site-heading)] mb-4">
      صفحه‌ای که دنبالش بودید پیدا نشد!
    </h1>

    <!-- توضیحات متناسب با رنگ‌های استاندارد سایت -->
    <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed mb-8 max-w-md">
      به نظر می‌آید آدرسی که وارد کرده‌اید وجود ندارد یا به صفحه دیگری منتقل شده است. می‌توانید به صفحه اصلی برگردید.
    </p>

    <!-- دکمه بازگشت به خانه با استفاده از رنگ اصلی برند -->
    <a href="/" class="inline-flex items-center gap-2 bg-[var(--site-primary)] hover:opacity-90 text-white font-medium px-6 py-3 rounded-xl transition shadow-md shadow-sky-500/20 text-xs sm:text-sm">
      <i class="fa-solid fa-house text-xs"></i>
      <span>بازگشت به صفحه اصلی</span>
    </a>

  </main>

  <Footer />

</Layout>