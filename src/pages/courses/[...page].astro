---
import { entrySlug, isPublished } from '../../utils/content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
  const allCourses = await getCollection('courses', isPublished);
  
  const sortedCourses = allCourses.sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  });

  return paginate(sortedCourses, { pageSize: 10 });
}

const { page } = Astro.props;
const siteUrl = new URL(Astro.site || Astro.url.origin).origin;
const courseListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${new URL(Astro.url.pathname, siteUrl).href}#course-list`,
  "itemListElement": page.data.map((course, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `${siteUrl}/courses/${entrySlug(course)}/`,
    "item": {
      "@type": "Course",
      "name": course.data.title,
      "description": course.data.description,
      "url": `${siteUrl}/courses/${entrySlug(course)}/`,
      "provider": {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "Optimization Expert",
        "sameAs": siteUrl,
      },
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(courseListSchema)} />

<Layout 
  title="دوره‌های آموزشی" 
  description="مجموعه‌ای از دوره‌های تخصصی مهندسی، برنامه‌نویسی پایتون و سیستم‌های قدرت با رویکرد کاربردی."
  
  pageNumber={page.currentPage}
  breadcrumbs={[
    { name: 'خانه', url: '/' },
    { name: 'دوره‌ها' },
  ]}
>

  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- هدر صفحه -->
    <div class="mb-12 border-b border-[var(--site-border)] pb-8">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4 shadow-xs">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>آرشیو آموزشی</span>
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        دوره‌های آموزشی
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed max-w-2xl">
        مجموعه‌ای از دوره‌های تخصصی مهندسی، برنامه‌نویسی پایتون و سیستم‌های قدرت با رویکرد کاربردی.
      </p>
    </div>

    <!-- لیست دوره‌ها -->
    <div class="grid gap-6">
      {
        page.data.length === 0 ? (
          <div class="text-center py-16 bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl shadow-xs">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center text-lg mb-3">
              <i class="fa-solid fa-folder-open"></i>
            </div>
            <p class="text-[var(--site-muted)] font-medium text-sm">به زودی دوره‌های جدید اضافه خواهد شد...</p>
          </div>
        ) : (
          page.data.map((course) => {
            const cleanSlug = entrySlug(course);
            const cardImage = course.data.minimalImage || course.data.image;
            const cardImageAlt = course.data.minimalImageAlt || course.data.imageAlt || course.data.title;

            return (
              <article class="card-stretched relative bg-[var(--site-card)] border border-[var(--site-border)] p-5 sm:p-6 rounded-3xl hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col md:flex-row-reverse items-start justify-between gap-6 shadow-xs group">
                
                {cardImage && (
                  <div class="w-full md:w-56 flex-shrink-0">
                    <div class="bg-[var(--site-bg)] rounded-2xl overflow-hidden border border-[var(--site-border)] flex items-center justify-center shadow-sm aspect-video">
                      {typeof cardImage === 'string' ? (
                        <img
                          src={cardImage}
                          alt={cardImageAlt}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                        />
                      ) : (
                        <Image
                          src={cardImage}
                          alt={cardImageAlt}
                          class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                        />
                      )}
                    </div>
                  </div>
                )}

                <div class="flex-grow w-full flex flex-col justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-1.5 mb-3">
                      {course.data.level && (
                        <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                          {course.data.level}
                        </span>
                      )}
                      {course.data.duration && (
                        <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                          <i class="fa-regular fa-clock text-[var(--site-primary)]"></i>
                          <span>{course.data.duration}</span>
                        </span>
                      )}
                      {course.data.environment && (
                        <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                          <i class="fa-solid fa-laptop-code text-[var(--site-primary)]"></i>
                          <span>{course.data.environment}</span>
                        </span>
                      )}
                      {course.data.sessions && (
                        <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                          <i class="fa-solid fa-chalkboard-user text-[var(--site-primary)]"></i>
                          <span>{course.data.sessions}</span>
                        </span>
                      )}
                    </div>

                    <h2 class="text-lg md:text-xl font-bold text-[var(--site-heading)] mb-2 group-hover:text-[var(--site-primary)] transition-colors">
                      <a href={`/courses/${cleanSlug}/`} class="stretched-card-link outline-none">
                        {course.data.title}
                      </a>
                    </h2>

                    <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed mb-4 line-clamp-2">
                      {course.data.description}
                    </p>
                  </div>

                  <div class="flex items-center gap-4 text-xs font-semibold mt-auto">
                    <a href={`/courses/${cleanSlug}/`} class="card-action-link inline-flex items-center gap-2 text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-3.5 py-1.5 rounded-xl transition-all duration-300">
                      <span>مشاهده جزئیات دوره</span>
                      <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                    </a>
                  </div>
                </div>

              </article>
            );
          })
        )
      }
    </div>

    <!-- بخش شماره‌گذاری صفحات (Pagination) -->
    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      basePath="/courses/"
    />

  </main>

</Layout>