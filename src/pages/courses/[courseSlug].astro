---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import InstructorBio from '../../components/InstructorBio.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import { imgSrc } from '../../utils/image';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: { courseSlug: course.id.replace(/\.md$/, '').split('/').pop() },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const courseSlug = course.id.replace(/\.md$/, '').split('/').pop();

const pageImage = course.data.image || course.data.minimalImage;
const pageImageAlt = course.data.imageAlt || course.data.minimalImageAlt || course.data.title;

// پشتیبانی از هر دو فرمت نام‌گذاری (مفرد یا جمع)
const prerequisite = course.data.prerequisite || course.data.prerequisites;

// نام مدرس برای غنی‌سازی Schema.org (hasCourseInstance.instructor)
const instructors = await getCollection('instructors');
const instructorData = instructors.find(
  (i) => i.id.replace(/\.md$/, '').split('/').pop() === course.data.instructor
);
---

<Layout
  title={course.data.seoTitle || course.data.title}
  description={course.data.description}
  image={imgSrc(pageImage)}
  type="course"
  courseDetails={{
    duration: course.data.duration,
    level: course.data.level,
    instructorName: instructorData?.data.name,
    price: course.data.price,
    priceCurrency: course.data.priceCurrency,
  }}
  breadcrumbs={[
    { name: 'خانه', url: '/' },
    { name: 'دوره‌ها', url: '/courses' },
    { name: course.data.title },
  ]}>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 flex-grow w-full relative pb-20">
     
    <div class="mb-6">
      <a href="/courses" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition-all duration-200">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت به دوره‌ها</span>
      </a>
    </div>

    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        {course.data.level && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-layer-group text-[11px]"></i>
            <span>{course.data.level}</span>
          </span>
        )}
        {course.data.duration && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-regular fa-clock text-[11px]"></i>
            <span>{course.data.duration}</span>
          </span>
        )}
        {course.data.environment && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-laptop-code text-[11px]"></i>
            <span>{course.data.environment}</span>
          </span>
        )}
        {course.data.sessions && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-chalkboard-user text-[11px]"></i>
            <span>{course.data.sessions}</span>
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-5 leading-snug tracking-tight">
        {course.data.title}
      </h1>

      {pageImage && (
        <div class="w-full rounded-2xl overflow-hidden border border-[var(--site-border)] bg-[var(--site-card)] flex items-center justify-center shadow-sm">
          {typeof pageImage === 'string' ? (
            <img
              src={pageImage}
              alt={pageImageAlt}
              class="w-full h-auto object-cover"
            />
          ) : (
            <Image
              src={pageImage}
              alt={pageImageAlt}
              class="w-full h-auto object-cover"
            />
          )}
        </div>
      )}

      {/* بخش طراحی‌شده برای پیش‌نیاز دوره */}
      {prerequisite && (
        <div class="mt-5 p-4 sm:p-5 bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl shadow-2xs flex items-start gap-3.5 sm:gap-4 transition-all duration-200">
          <div class="w-9 h-9 rounded-xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center shrink-0 border border-[var(--site-primary)]/20 mt-0.5">
            <i class="fa-solid fa-clipboard-check text-sm"></i>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-xs sm:text-sm font-bold text-[var(--site-heading)] mb-1.5 flex items-center gap-2">
              پیش‌نیاز دوره
            </h3>
            {Array.isArray(prerequisite) ? (
              <ul class="text-xs sm:text-sm text-[var(--site-text)] space-y-1.5 list-disc list-inside marker:text-[var(--site-primary)]">
                {prerequisite.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p class="text-xs sm:text-sm text-[var(--site-text)] leading-relaxed">
                {prerequisite}
              </p>
            )}
          </div>
        </div>
      )}
    </div>

    <article class="prose max-w-none leading-loose text-[var(--site-text)] space-y-8 mb-12">
      <Content />
    </article>

    <section id="instructor" class="scroll-mt-28 mb-12">
      <InstructorBio instructorSlug={course.data.instructor} />
    </section>

    <section id="register" class="scroll-mt-28">
      <TelegramCTA
        icon="fa-circle-question"
        heading="راهنمایی و ثبت‌نام"
        description="سوالی درباره ثبت‌نام دارید؟ با آیدی"
      />
    </section>

    <RelatedContent 
      currentSlug={courseSlug}
      tags={course.data.tags}
      relatedCourses={course.data.relatedCourses}
      relatedNotes={course.data.relatedNotes}
      relatedProjects={course.data.relatedProjects}
    />

  </main>

  <div class="fixed bottom-5 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
    <nav class="pointer-events-auto bg-[var(--site-card)]/90 backdrop-blur-xl border border-[var(--site-primary)]/30 shadow-2xl shadow-black/20 rounded-full p-1.5 transition-all duration-300 ring-1 ring-black/5">
      <ul class="flex items-center gap-1 sm:gap-2">
        <li>
          <a href="#intro" class="course-nav-link text-xs sm:text-sm font-bold text-[var(--site-muted)] px-3.5 sm:px-4 py-2 rounded-full transition-all duration-200 flex items-center gap-2 hover:text-[var(--site-primary)] hover:bg-[var(--site-primary)]/10 active:scale-95">
            <i class="fa-solid fa-book-open-reader text-xs"></i>
            <span>معرفی دوره</span>
          </a>
        </li>
        <li>
          <a href="#syllabus" class="course-nav-link text-xs sm:text-sm font-bold text-[var(--site-muted)] px-3.5 sm:px-4 py-2 rounded-full transition-all duration-200 flex items-center gap-2 hover:text-[var(--site-primary)] hover:bg-[var(--site-primary)]/10 active:scale-95">
            <i class="fa-solid fa-bars-staggered text-xs"></i>
            <span>سرفصل‌ها</span>
          </a>
        </li>
        <li>
          <a href="#instructor" class="course-nav-link text-xs sm:text-sm font-bold text-[var(--site-muted)] px-3.5 sm:px-4 py-2 rounded-full transition-all duration-200 flex items-center gap-2 hover:text-[var(--site-primary)] hover:bg-[var(--site-primary)]/10 active:scale-95">
            <i class="fa-solid fa-chalkboard-user text-xs"></i>
            <span>مدرس</span>
          </a>
        </li>
        <li>
          <a href="#register" class="course-nav-link text-xs sm:text-sm font-bold text-[var(--site-muted)] px-3.5 sm:px-4 py-2 rounded-full transition-all duration-200 flex items-center gap-2 hover:text-[var(--site-primary)] hover:bg-[var(--site-primary)]/10 active:scale-95">
            <i class="fa-solid fa-paper-plane text-xs"></i>
            <span>ثبت‌نام</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.course-nav-link');
    const sectionIds = ['intro', 'syllabus', 'instructor', 'register'];

    const updateActiveLink = () => {
      const scrollPosition = window.scrollY + 220;
      let currentSectionId = '';

      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (el) {
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (scrollPosition >= top && scrollPosition < top + height) {
            currentSectionId = id;
            break;
          }
        }
      }

      if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 150) {
        currentSectionId = 'register';
      } else if (!currentSectionId && window.scrollY < 300) {
        currentSectionId = 'intro';
      }

      navLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href === `#${currentSectionId}`) {
          link.classList.add('bg-[var(--site-primary)]', 'text-white', 'shadow-md', 'shadow-[var(--site-primary)]/30');
          link.classList.remove('text-[var(--site-muted)]');
        } else {
          link.classList.remove('bg-[var(--site-primary)]', 'text-white', 'shadow-md', 'shadow-[var(--site-primary)]/30');
          link.classList.add('text-[var(--site-muted)]');
        }
      });
    };

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
  });
</script>