---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import InstructorBio from '../../components/InstructorBio.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: { courseSlug: course.id.replace(/\.md$/, '').split('/').pop() },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const courseSlug = course.id.replace(/\.md$/, '').split('/').pop();

// یافتن نام واقعی مدرس برای استفاده در Schema (همان الگوی InstructorBio)
const instructors = await getCollection('instructors');
const instructorEntry = instructors.find(
  (i) => i.id.replace(/\.md$/, '').split('/').pop() === course.data.instructor
);

const siteUrl = "https://optexpert.org";

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": course.data.title,
  "description": course.data.description,
  "url": `${siteUrl}/courses/${courseSlug}/`,
  "inLanguage": "fa",
  "provider": {
    "@type": "Organization",
    "name": "Optimization Expert",
    "url": `${siteUrl}/`,
  },
  ...(course.data.prerequisite && { "coursePrerequisites": course.data.prerequisite }),
  ...(course.data.level && { "educationalLevel": course.data.level }),
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    ...(instructorEntry && {
      "instructor": { "@type": "Person", "name": instructorEntry.data.name },
    }),
  },
};
---

<Layout title={course.data.title} description={course.data.description} image={course.data.image}>

  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <Header />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 flex-grow w-full">
     
    <!-- دکمه بازگشت -->
    <div class="mb-6">
      <a href="/courses" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition-all duration-200">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت به دوره‌ها</span>
      </a>
    </div>

    <article>
      <!-- نشان‌های مشخصات دوره -->
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        {course.data.level && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-layer-group text-[11px]"></i>
            <span>{course.data.level}</span>
          </span>
        )}
        {course.data.duration && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-regular fa-clock text-[11px]"></i>
            <span>{course.data.duration}</span>
          </span>
        )}
        {course.data.environment && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-laptop-code text-[11px]"></i>
            <span>{course.data.environment}</span>
          </span>
        )}
        {course.data.sessions && (
          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-xl border border-[var(--site-primary)]/20 shadow-2xs flex items-center gap-1.5">
            <i class="fa-solid fa-chalkboard-user text-[11px]"></i>
            <span>{course.data.sessions}</span>
          </span>
        )}
      </div>

      <!-- عنوان دوره -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-5 leading-snug tracking-tight">
        {course.data.title}
      </h1>

      <!-- توضیحات دوره -->
      <p class="text-[var(--site-muted)] text-sm sm:text-base leading-relaxed mb-8 bg-[var(--site-card)]/60 backdrop-blur-md p-5 rounded-2xl border border-[var(--site-border)] shadow-xs">
        {course.data.description}
      </p>

      <!-- تصویر اصلی دوره -->
      {course.data.image && (
        <div class="w-full rounded-2xl overflow-hidden border border-[var(--site-border)] mb-8 bg-[var(--site-card)] flex items-center justify-center shadow-sm">
          <img 
            src={course.data.image} 
            alt={course.data.title} 
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      <!-- کامپوننت پیش‌نیاز دوره (تمیز و بدون هیچ نقطه اضافی) -->
      {course.data.prerequisite && (
        <div class="relative overflow-hidden bg-[var(--site-card)]/70 backdrop-blur-md border border-[var(--site-border)] hover:border-[var(--site-primary)]/40 p-5 rounded-2xl mb-10 shadow-xs transition-all duration-300 group">
          <div class="absolute right-0 top-0 bottom-0 w-1.5 bg-[var(--site-primary)] rounded-r-2xl"></div>
          
          <div class="flex items-center gap-4 pr-1">
            <div class="w-11 h-11 rounded-xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center flex-shrink-0 text-base border border-[var(--site-primary)]/20 group-hover:scale-105 transition-transform duration-300">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div class="space-y-1">
              <span class="text-[11px] font-bold text-[var(--site-primary)] tracking-wide block">
                پیش‌نیاز این دوره
              </span>
              <p class="text-sm sm:text-base font-bold text-[var(--site-heading)] leading-snug">
                {course.data.prerequisite}
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- محتوای کامل دوره -->
      <div class="prose max-w-none leading-loose text-[var(--site-text)] space-y-6 mb-10">
        <Content />
      </div>

      <hr class="border-[var(--site-border)]/60 mb-10" />

      <!-- کامپوننت راهنمایی و ثبت‌نام -->
      <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-2xl shadow-xs mb-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-right">
          <h3 class="text-base font-bold text-[var(--site-heading)] mb-1 flex items-center gap-2">
            <i class="fa-solid fa-circle-question text-[var(--site-primary)]"></i>
            <span>راهنمایی و ثبت‌نام</span>
          </h3>
          <p class="text-xs sm:text-sm text-[var(--site-muted)]">
            سوالی درباره ثبت نام دارید؟ با آیدی <span class="font-bold text-[var(--site-text)]" dir="ltr">@pypyid</span> در تلگرام تماس بگیرید.
          </p>
        </div>
        <a 
          href="https://t.me/pypyid" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-sky-500 hover:bg-sky-600 text-white font-medium px-5 py-2.5 rounded-xl transition shadow-sm shadow-sky-500/20 text-xs sm:text-sm flex items-center gap-2 shrink-0"
        >
          <i class="fa-brands fa-telegram text-base"></i>
          <span>ارتباط در تلگرام</span>
        </a>
      </div>

      <!-- معرفی مدرس -->
      <InstructorBio instructorSlug={course.data.instructor} />

      <!-- مطالب پیشنهادی -->
      <RelatedContent 
        currentSlug={courseSlug}
        tags={course.data.tags}
        relatedCourses={course.data.relatedCourses}
        relatedNotes={course.data.relatedNotes}
        relatedProjects={course.data.relatedProjects}
      />

    </article>

  </main>

  <Footer />

</Layout>
