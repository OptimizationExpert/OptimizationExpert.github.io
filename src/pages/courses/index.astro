---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const allCourses = await getCollection('courses');
---

<Layout 
  title="دوره‌های آموزشی تخصصی" 
  description="مجموعه‌ای از دوره‌های تخصصی مهندسی، برنامه‌نویسی پایتون و سیستم‌های قدرت با رویکرد کاربردی."
>


  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- هدر صفحه -->
    <div class="mb-12 border-b border-[var(--site-border)] pb-8">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4 shadow-xs">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>آرشیو آموزشی</span>
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        دوره‌های آموزشی
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed max-w-2xl">
        مجموعه‌ای از دوره‌های تخصصی مهندسی، برنامه‌نویسی پایتون و سیستم‌های قدرت با رویکرد کاربردی.
      </p>
    </div>

    <!-- لیست دوره‌ها -->
    <div class="grid gap-6">
      {
        allCourses.length === 0 ? (
          <div class="text-center py-16 bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl shadow-xs">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center text-lg mb-3">
              <i class="fa-solid fa-folder-open"></i>
            </div>
            <p class="text-[var(--site-muted)] font-medium text-sm">به زودی دوره‌های جدید اضافه خواهد شد...</p>
          </div>
        ) : (
          allCourses.map((course) => {
            const cleanSlug = course.id.replace(/\.md$/, '').split('/').pop();
            return (
              <article class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-3xl hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col sm:flex-row items-stretch justify-between gap-6 shadow-xs group">
                
                <!-- بخش متن دوره (راست) -->
                <div class="flex-grow w-full flex flex-col justify-between">
                  <div>
                    <!-- المان‌های بالای کارت (همه متغیرها حفظ شده و دقیقاً با استایل پروژه‌ها هماهنگ شده‌اند) -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                      <div class="flex flex-wrap items-center gap-2">
                        {course.data.level && (
                          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            {course.data.level}
                          </span>
                        )}
                        {course.data.duration && (
                          <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            <i class="fa-regular fa-clock text-[var(--site-primary)]"></i>
                            <span>{course.data.duration}</span>
                          </span>
                        )}
                        {course.data.environment && (
                          <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            <i class="fa-solid fa-laptop-code text-[var(--site-primary)]"></i>
                            <span>{course.data.environment}</span>
                          </span>
                        )}
                        {course.data.sessions && (
                          <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            <i class="fa-solid fa-chalkboard-user text-[var(--site-primary)]"></i>
                            <span>{course.data.sessions}</span>
                          </span>
                        )}
                      </div>
                    </div>

                    <h2 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] mb-3 group-hover:text-[var(--site-primary)] transition-colors">
                      <a href={`/courses/${cleanSlug}`} class="outline-none">
                        {course.data.title}
                      </a>
                    </h2>

                    <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed mb-6 line-clamp-2">
                      {course.data.description}
                    </p>
                  </div>

                  <div class="flex items-center gap-4 text-xs font-semibold mt-auto">
                    <a href={`/courses/${cleanSlug}`} class="inline-flex items-center gap-2 text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-4 py-2 rounded-xl transition-all duration-300">
                      <span>مشاهده جزئیات دوره</span>
                      <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                    </a>
                  </div>
                </div>

                <!-- تصویر دوره (تنظیم‌شده برای پر کردن ارتفاع دقیقاً مشابه پروژه‌ها) -->
                {course.data.image && (
                  <div class="w-full sm:w-60 flex-shrink-0 bg-[var(--site-bg)] rounded-2xl overflow-hidden border border-[var(--site-border)] flex items-center justify-center shadow-sm min-h-[220px] sm:min-h-full">
                    {typeof course.data.image === 'string' ? (
                      <img
                        src={course.data.image}
                        alt={course.data.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                      />
                    ) : (
                      <Image
                        src={course.data.image}
                        alt={course.data.title}
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                      />
                    )}
                  </div>
                )}

              </article>
            );
          })
        )
      }
    </div>

  </main>


</Layout>