---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// دسته‌بندی لینک‌های مفید (همراه با کانال و گروه تلگرام در ابتدا)
const linkCategories = [
  {
    category: "جامعه و کانال‌های تخصصی",
    links: [
      {
        title: "Pyomo, python, optimization",
        description: "بهینه سازی و تحقيق در عمليات در پایتون (@pyomochannel)",
        url: "https://t.me/pyomochannel",
        icon: "fa-brands fa-telegram"
      },
      {
        title: "Optimization Expert (GitHub)",
        description: "مخازن کد، پروژه‌های بهینه‌سازی و نمونه کدهای تخصصی در گیت‌هاب.",
        url: "https://github.com/OptimizationExpert",
        icon: "fa-brands fa-github"
      },
      {
        title: "Pyomo Q&A",
        description: "گروه پرسش و پاسخ تخصصی پیرامون فریمورک پایتونی Pyomo و مباحث مرتبط.",
        url: "#",
        icon: "fa-solid fa-users",
        noLink: true
      }
    ]
  },
  {
    category: "سالورها و ابزارهای بهینه‌سازی",
    links: [
      {
        title: "Pyomo Documentation",
        description: "مستندات رسمی و راهنمای جامع فریمورک پایتونی Pyomo برای مدل‌سازی ریاضی.",
        url: "https://pyomo.readthedocs.io/",
        icon: "fa-solid fa-book"
      },
      {
        title: "HiGHS Optimization Solver",
        description: "سالور متن‌باز، مدرن و پرسرعت برای مسائل برنامه‌ریزی خطی و اعداد صحیح مختلط (MIP).",
        url: "https://highs.dev/",
        icon: "fa-solid fa-bolt"
      },
      {
        title: "COIN-OR Initiative",
        description: "مجموعه ابزارها و سالورهای متن‌باز صنعتی برای بهینه‌سازی (شامل CBC، IPOPT و...).",
        url: "https://www.coin-or.org/",
        icon: "fa-solid fa-cubes"
      }
    ]
  },
  {
    category: "برنامه‌نویسی و محیط‌های توسعه پایتون",
    links: [
      {
        title: "Python Official Website",
        description: "مرجع اصلی زبان برنامه‌نویسی پایتون، دانلود مفسر و مستندات رسمی کتابخانه‌ها.",
        url: "https://www.python.org/",
        icon: "fa-brands fa-python"
      },
      {
        title: "Jupyter Project",
        description: "محیط برنامه‌نویسی تعاملی و نوت‌بوک‌های قدرتمند برای تحلیل داده و شبیه‌سازی.",
        url: "https://jupyter.org/",
        icon: "fa-solid fa-code"
      }
    ]
  },
  {
    category: "سیستم‌های قدرت و مهندسی",
    links: [
      {
        title: "IEEE Xplore Digital Library",
        description: "مرجع بین‌المللی مقالات علمی، استانداردها و پژوهش‌های مهندسی برق و سیستم‌های قدرت.",
        url: "https://ieeexplore.ieee.org/",
        icon: "fa-solid fa-graduation-cap"
      }
    ]
  }
];
---

<Layout title="لینک‌های مفید و مراجع تخصصی" description="مجموعه‌ای از وب‌سایت‌های مرجع، مستندات رسمی و ابزارهای کاربردی در حوزه بهینه‌سازی، برنامه‌نویسی و مهندسی.">

  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
    
    <!-- هدر صفحه -->
    <div class="mb-12 text-center md:text-right">
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        لینک‌های مفید و مراجع تخصصی
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed">
        مجموعه‌ای از وب‌سایت‌های مرجع، مستندات رسمی و ابزارهای کاربردی برای توسعه، پژوهش و یادگیری.
      </p>
    </div>

    <!-- فهرست دسته‌بندی‌ها و لینک‌ها -->
    <div class="space-y-12">
      {linkCategories.map((section) => (
        <div>
          <h2 class="text-xl font-bold text-[var(--site-primary)] mb-6 flex items-center gap-2 border-b border-[var(--site-border)] pb-3">
            <i class="fa-solid fa-folder-open text-sm"></i>
            <span>{section.category}</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {section.links.map((item) => (
              item.noLink ? (
                <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5 flex flex-col justify-between shadow-xs">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <span class="w-10 h-10 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] flex items-center justify-center text-sm">
                        <i class={item.icon}></i>
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-[var(--site-heading)] mb-1.5 leading-snug">
                      {item.title}
                    </h3>
                    <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </div>
              ) : (
                <a 
                  href={item.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/40 rounded-2xl p-5 transition-all duration-300 flex flex-col justify-between group shadow-xs hover:shadow-md"
                >
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <span class="w-10 h-10 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] flex items-center justify-center text-sm group-hover:scale-110 transition-transform">
                        <i class={item.icon}></i>
                      </span>
                      <span class="text-xs text-[var(--site-muted)] group-hover:text-[var(--site-primary)] transition inline-flex items-center gap-1 font-medium">
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                      </span>
                    </div>

                    <h3 class="text-lg font-bold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition mb-1.5 leading-snug">
                      {item.title}
                    </h3>

                    <p class="text-[var(--site-muted)] text-xs md:text-sm leading-relaxed line-clamp-2">
                      {item.description}
                    </p>
                  </div>
                </a>
              )
            ))}
          </div>
        </div>
      ))}
    </div>

  </main>

  <Footer />

</Layout>