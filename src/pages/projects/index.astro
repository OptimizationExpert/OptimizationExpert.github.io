---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
---

<Layout 
  title="پروژه‌ها" 
  description="مجموعه‌ای از پروژه‌های مهندسی، توسعه نرم‌افزار، بهینه‌سازی با پایتون و سیستم‌های قدرت."
>


  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- هدر صفحه -->
    <div class="mb-12 border-b border-[var(--site-border)] pb-8">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4 shadow-xs">
        <i class="fa-solid fa-layer-group"></i>
        <span>پروژه‌ها</span>
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        پروژه‌های کاربردی
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed max-w-2xl">
        مجموعه‌ای از پروژه‌های مهندسی، توسعه نرم‌افزار، بهینه‌سازی با پایتون و سیستم‌های قدرت.
      </p>
    </div>

    <!-- لیست پروژه‌ها -->
    <div class="grid gap-6">
      {
        allProjects.length === 0 ? (
          <div class="text-center py-16 bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl shadow-xs">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-[var(--site-primary)]/10 text-[var(--site-primary)] flex items-center justify-center text-lg mb-3">
              <i class="fa-solid fa-folder-open"></i>
            </div>
            <p class="text-[var(--site-muted)] font-medium text-sm">به زودی پروژه‌های جدید اضافه خواهد شد...</p>
          </div>
        ) : (
          allProjects.map((project) => {
            const cleanSlug = project.id.replace(/\.md$/, '').split('/').pop();
            return (
              <article class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-3xl hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col sm:flex-row items-stretch justify-between gap-6 shadow-xs group">
                
                <!-- بخش متن پروژه (راست) -->
                <div class="flex-grow w-full flex flex-col justify-between">
                  <div>
                    <!-- المان‌های بالای کارت -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                      <div class="flex flex-wrap items-center gap-2">
                        {project.data.category && (
                          <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            {project.data.category}
                          </span>
                        )}
                        {project.data.environment && (
                          <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            {project.data.environment}
                          </span>
                        )}
                        {project.data.status && (
                          <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            {project.data.status}
                          </span>
                        )}
                        {project.data.level && (
                          <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-2xs">
                            {project.data.level}
                          </span>
                        )}
                      </div>
                      
                      {project.data.pubDate && (
                        <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 bg-[var(--site-bg)] px-3.5 py-1.5 rounded-full border border-[var(--site-border)] shadow-2xs self-start sm:self-auto shrink-0">
                          <i class="fa-regular fa-calendar text-[var(--site-primary)]"></i>
                          <span>{project.data.pubDate.toLocaleDateString('fa-IR')}</span>
                        </span>
                      )}
                    </div>

                    <h2 class="text-xl md:text-2xl font-bold text-[var(--site-heading)] mb-3 group-hover:text-[var(--site-primary)] transition-colors">
                      <a href={`/projects/${cleanSlug}`} class="outline-none">
                        {project.data.title}
                      </a>
                    </h2>

                    <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed mb-6 line-clamp-2">
                      {project.data.description}
                    </p>
                  </div>

                  <div class="flex items-center gap-4 text-xs font-semibold mt-auto">
                    <a href={`/projects/${cleanSlug}`} class="inline-flex items-center gap-2 text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-4 py-2 rounded-xl transition-all duration-300">
                      <span>جزئیات بیشتر</span>
                      <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                    </a>
                  </div>
                </div>

                <!-- تصویر پروژه (تنظیم‌شده برای پر کردن ارتفاع و حذف فضای خالی) -->
                {project.data.image && (
                  <div class="w-full sm:w-60 flex-shrink-0 bg-[var(--site-bg)] rounded-2xl overflow-hidden border border-[var(--site-border)] flex items-center justify-center shadow-sm min-h-[220px] sm:min-h-full">
                    {typeof project.data.image === 'string' ? (
                      <img
                        src={project.data.image}
                        alt={project.data.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                      />
                    ) : (
                      <Image
                        src={project.data.image}
                        alt={project.data.title}
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                      />
                    )}
                  </div>
                )}

              </article>
            );
          })
        )
      }
    </div>

  </main>


</Layout>