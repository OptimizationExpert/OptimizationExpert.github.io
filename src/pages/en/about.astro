---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import LayoutEn from '../../layouts/LayoutEn.astro';
import { sized, PORTRAIT } from '../../utils/image-sizes';

const [me] = await getCollection('instructors', (e) => e.id.includes('dr-soroudi'));
const d = me.data as any;
const siteUrl = new URL(Astro.site || Astro.url.origin).origin;
const personId = `${siteUrl}/instructors/dr-soroudi/#person`;

const profiles = [
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/soroudi/', icon: 'fa-brands fa-linkedin' },
  { label: 'Google Scholar', url: 'https://scholar.google.com/citations?user=w74f9yAAAAAJ', icon: 'fa-solid fa-graduation-cap' },
  { label: 'ORCID', url: 'https://orcid.org/0000-0002-3651-6290', icon: 'fa-brands fa-orcid' },
  { label: 'ResearchGate', url: 'https://www.researchgate.net/profile/Alireza-Soroudi', icon: 'fa-brands fa-researchgate' },
];
---

<LayoutEn
  title="About Alireza Soroudi"
  description="Alireza Soroudi leads optimization projects at EirGrid. Former UCD faculty member, IEEE Senior Member and Springer author on power system optimization."
  schema={[
    {
      '@type': 'Person',
      '@id': personId,
      name: d.nameEn,
      alternateName: d.alternateName,
      jobTitle: 'Senior Data Scientist, Optimization & Operations Research',
      description: d.descriptionEn,
      url: `${siteUrl}/en/about/`,
      worksFor: { '@type': 'Organization', name: d.worksFor?.name, url: d.worksFor?.url },
      alumniOf: (d.alumniOf ?? []).map((n: string) => ({ '@type': 'CollegeOrUniversity', name: n })),
      award: d.award,
      knowsAbout: d.knowsAbout,
      sameAs: d.sameAs,
    },
    { '@type': 'ProfilePage', '@id': `${siteUrl}/en/about/#profile`, url: `${siteUrl}/en/about/`, mainEntity: { '@id': personId }, inLanguage: 'en' },
  ]}
>
  <main class="flex-grow w-full max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <header class="flex flex-col sm:flex-row items-start gap-8 mb-12">
      {d.image && (
        <Image src={d.image} alt="Alireza Soroudi" width={160} height={160} class="w-40 h-40 rounded-3xl object-cover border border-[var(--site-border)] shrink-0" {...sized(d.image, PORTRAIT)} />
      )}
      <div>
        <h1 class="text-4xl sm:text-5xl font-black text-[var(--site-heading)] tracking-tight mb-3">Alireza Soroudi</h1>
        <p class="text-lg text-[var(--site-text)]">Senior data scientist · Optimization &amp; operations research · IEEE Senior Member</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {profiles.map((p) => (
            <li><a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 min-h-10 rounded-full border border-[var(--site-border)] text-xs font-bold hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/40 transition"><i class={p.icon} aria-hidden="true"></i>{p.label}</a></li>
          ))}
        </ul>
      </div>
    </header>

    <div class="prose max-w-none text-[var(--site-text)] leading-relaxed">
      <p>
        I lead optimization and operations research projects at EirGrid. Before that, I spent nearly a decade on the faculty of University College Dublin, working on power system and supply chain optimization. My work sits where mathematical modeling meets real operational decisions: models that have to respect every rule of the system and still give an answer in time to be useful.
      </p>
      <p>
        I am the author of <a href="https://doi.org/10.1007/978-3-319-62350-4" target="_blank" rel="noopener noreferrer"><em>Power System Optimization Modeling in GAMS</em></a> (Springer, 2017). I also founded <a href="/" hreflang="fa">optexpert.org</a>, a Persian-language platform where engineers and graduate students learn optimization with OR-Tools, Pyomo and Python.
      </p>

      <h2>Background</h2>
      <ul>
        <li>PhD in electrical engineering, Grenoble Institute of Technology (Grenoble INP), France</li>
        <li>BSc and MSc in electrical engineering, Sharif University of Technology</li>
        <li>Nearly a decade on the faculty of University College Dublin</li>
      </ul>

      <h2>Recognition</h2>
      <ul>
        <li>INFORMS ENRE Young Researcher Prize (2013)</li>
        <li>Science Foundation Ireland Industry Fellowship (2016)</li>
        <li>IEEE Senior Member</li>
      </ul>

      <h2>Areas of expertise</h2>
      <p>
        Power system optimization, mathematical programming, constraint programming, vehicle routing, production and workforce scheduling, supply chain optimization and modeling under uncertainty. I work mainly in Python with Pyomo and Google OR-Tools, and in GAMS.
      </p>
    </div>

    <section class="mt-12 p-8 rounded-2xl bg-[var(--site-card)] border border-[var(--site-border)] flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-black text-[var(--site-heading)] mb-1">Working on an optimization problem?</h2>
        <p class="text-[var(--site-muted)]">See how I can help, or get in touch directly.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/en/services/" class="h-11 px-5 inline-flex items-center rounded-xl border border-[var(--site-border)] font-bold hover:border-[var(--site-primary)]/50 transition">Services</a>
        <a href="/en/contact/" class="h-11 px-5 inline-flex items-center rounded-xl bg-[var(--site-primary)] text-white font-bold hover:opacity-90 transition">Contact</a>
      </div>
    </section>
  </main>
</LayoutEn>
