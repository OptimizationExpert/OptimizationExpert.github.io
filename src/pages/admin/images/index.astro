---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { buildImageAudit } from '../../../utils/image-audit';

const pages = await buildImageAudit();
const totalImages = pages.reduce((s, p) => s + p.bodyImageCount + (p.featuredImageKind !== 'missing' ? 1 : 0), 0);
const errorPages = pages.filter(p => p.issues.some(i => i.severity === 'error'));
const externalCount = pages.filter(p => p.featuredImageKind === 'external').length;
const missingFeaturedCount = pages.filter(p => p.featuredImageKind === 'missing').length;
const cleanCount = pages.filter(p => p.issues.length === 0).length;

const typeChips: [string, string][] = [['all', 'همه انواع'], ['note', 'یادداشت'], ['project', 'پروژه'], ['course', 'دوره'], ['book', 'کتاب'], ['software', 'نرم‌افزار']];

const guide = [
  { title: 'همیشه imageAlt واقعی و توصیفی بنویسید', detail: 'به‌جای «تصویر» یا «عکس»، بنویسید چه چیزی در تصویر است — هم برای کاربران کم‌بینا، هم برای گوگل ایمیج مهم است.' },
  { title: 'برای تصاویر داخل متن هم توضیح [بین کروشه] را خالی نگذارید', detail: 'در ![توضیح تصویر](./file.webp)، بخش «توضیح تصویر» همان alt است؛ خالی گذاشتنش هم به کاربر هم به سئو ضربه می‌زند.' },
  { title: 'تصویر را از کنار فایل md ایمپورت کنید، نه لینک بیرونی', detail: 'وقتی تصویر را به‌صورت فایل محلی کنار مطلب می‌گذارید (مثل ./cover.webp)، Astro خودش فشرده و بهینه‌اش می‌کند؛ لینک به تصاویر روی دامنه‌های دیگر این بهینه‌سازی را ندارد و به در دسترس بودن آن سرور هم وابسته می‌شود.' },
  { title: 'SVG هم کاملاً پشتیبانی می‌شود — برای نمودار و آیکون ترجیح بدهید', detail: 'برای تصاویر خطی/نموداری (نه عکس واقعی)، svg هم سبک‌تر است هم در هر اندازه‌ای تار نمی‌شود. minimalImage و image هر دو با svg مثل webp/png/jpg رفتار می‌کنند — در کارت‌ها، جست‌وجو، og:image و JSON-LD یکسان کار می‌کند.' },
  { title: 'اگر فایل تصویر گم باشد، اصلاً build انجام نمی‌شود', detail: 'خیالتان راحت باشد — اگر مسیر یک تصویر محلی اشتباه باشد، Astro همان لحظه با خطا جلوی build را می‌گیرد، نه اینکه یک صفحه‌ی خراب منتشر شود.' },
];

function kindLabel(kind: string) {
  if (kind === 'optimized') return { label: 'بهینه‌شده خودکار', cls: 'text-green-600 dark:text-green-400' };
  if (kind === 'external') return { label: 'دامنه‌ی بیرونی', cls: 'text-amber-600 dark:text-amber-400' };
  return { label: 'بدون تصویر شاخص', cls: 'text-red-600 dark:text-red-400' };
}
---
<AdminLayout title="بررسی تصاویر" description="بررسی خودکار کیفیت تصاویر سایت: متن جایگزین، مسیرهای بهینه‌نشده و فایل‌های حجیم." breadcrumbs={[{name:'خانه',url:'/'},{name:'پنل مدیریت',url:'/admin/'},{name:'بررسی تصاویر'}]}>
<main class="max-w-7xl mx-auto px-4 sm:px-6 py-10 w-full flex-grow">
<header class="mb-8">
<span class="inline-flex items-center gap-2 text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/20"><i class="fa-solid fa-images" aria-hidden="true"></i>ابزار داخلی — فقط مدیر سایت</span>
<h1 class="text-3xl md:text-4xl font-black text-[var(--site-heading)] mt-4 mb-3">بررسی تصاویر</h1>
<p class="text-sm leading-7 text-[var(--site-muted)] max-w-3xl">این ابزار چیزهایی را بررسی می‌کند که خود Astro در زمان build چک نمی‌کند: کیفیت متن جایگزین (alt) و مسیرهای تصویری که از بهینه‌سازی خودکار عبور نمی‌کنند. اگر یک تصویر داخل متن اصلاً وجود نداشته باشد، خود build با خطا متوقف می‌شود — پس آن حالت اینجا لازم نیست بررسی شود. <a href="/admin/seo/" class="text-[var(--site-primary)] hover:underline font-bold">سلامت سئو ←</a></p>
</header>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-10">
<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5"><p class="text-2xl font-black text-[var(--site-heading)]">{totalImages}</p><p class="text-xs text-[var(--site-muted)] mt-1">کل تصاویر سایت</p></div>
<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5"><p class="text-2xl font-black text-green-600 dark:text-green-400">{cleanCount}</p><p class="text-xs text-[var(--site-muted)] mt-1">صفحه بدون مشکل</p></div>
<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5"><p class="text-2xl font-black text-red-600 dark:text-red-400">{errorPages.length}</p><p class="text-xs text-[var(--site-muted)] mt-1">صفحه با مشکل جدی</p></div>
<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5"><p class="text-2xl font-black text-amber-600 dark:text-amber-400">{externalCount}</p><p class="text-xs text-[var(--site-muted)] mt-1">تصویر شاخص از دامنه‌ی بیرونی</p></div>
<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5"><p class="text-2xl font-black text-[var(--site-muted)]">{missingFeaturedCount}</p><p class="text-xs text-[var(--site-muted)] mt-1">بدون تصویر شاخص</p></div>
</div>

<section class="mb-10 rounded-3xl border border-[var(--site-primary)]/25 bg-[var(--site-primary)]/[0.04] p-5 sm:p-7">
<div class="flex items-start gap-3 mb-5">
<div class="w-10 h-10 rounded-2xl bg-[var(--site-primary)]/15 flex items-center justify-center shrink-0"><i class="fa-solid fa-lightbulb text-[var(--site-primary)]" aria-hidden="true"></i></div>
<div><h2 class="text-lg font-black text-[var(--site-heading)]">راهنمای استفاده‌ی درست از تصویر</h2><p class="text-xs text-[var(--site-muted)] mt-1">این چند نکته را قبل از افزودن تصویر جدید به یک مطلب رعایت کنید.</p></div>
</div>
<div class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
{guide.map((g,i)=><div class="flex items-start gap-3">
<span class="w-6 h-6 rounded-full bg-[var(--site-primary)]/15 text-[var(--site-primary)] text-[11px] font-black flex items-center justify-center shrink-0 mt-0.5">{i+1}</span>
<div><p class="text-sm font-bold text-[var(--site-heading)]">{g.title}</p><p class="text-xs text-[var(--site-muted)] leading-relaxed mt-0.5">{g.detail}</p></div>
</div>)}
</div>
</section>

<div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-4 sm:p-5 mb-6 shadow-xs space-y-4">
<input id="img-search" type="search" placeholder="جستجوی عنوان..." class="w-full bg-[var(--site-bg)] border border-[var(--site-border)] rounded-xl px-4 py-3 text-sm text-[var(--site-text)] focus:outline-none focus:border-[var(--site-primary)]"/>
<div>
<p class="text-[10px] font-bold text-[var(--site-muted)] uppercase tracking-widest mb-2">نوع محتوا</p>
<div class="flex flex-wrap gap-2">{typeChips.map(([id,label])=><button type="button" data-type-filter={id} class="img-type-filter px-3.5 py-1.5 rounded-lg border border-[var(--site-border)] text-xs font-bold text-[var(--site-text)]">{label}</button>)}</div>
</div>
<label class="flex items-center gap-2 text-xs font-bold text-[var(--site-muted)] pt-1 border-t border-[var(--site-border)]"><input id="img-only-issues" type="checkbox" class="accent-[var(--site-primary)]"/> فقط صفحات دارای مشکل</label>
</div>
<p id="img-count" class="text-xs text-[var(--site-muted)] mb-3"></p>

<div class="grid gap-3">
{pages.map(p=>{const k=kindLabel(p.featuredImageKind);return(
<article class="img-row bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5" data-title={p.title} data-type={p.typeId} data-has-issues={p.issues.length>0?'1':'0'}>
<div class="flex flex-wrap items-start justify-between gap-3">
<div class="min-w-0">
<span class="text-[10px] font-bold text-[var(--site-primary)]">{p.typeLabel}</span>
<h3 class="text-base font-bold text-[var(--site-heading)] mt-1 truncate"><a href={p.url} class="hover:text-[var(--site-primary)]">{p.title}</a></h3>
<code class="text-[10px] text-[var(--site-muted)]" dir="ltr">{p.filePath}</code>
</div>
<div class="text-left shrink-0"><p class={`text-xs font-bold ${k.cls}`}>{k.label}</p><p class="text-[10px] text-[var(--site-muted)] mt-0.5">{p.bodyImageCount} تصویر در متن</p></div>
</div>
{p.issues.length>0&&<ul class="mt-3 space-y-1">{p.issues.map(i=><li class={`text-xs flex items-start gap-2 ${i.severity==='error'?'text-red-600 dark:text-red-400':i.severity==='warning'?'text-amber-600 dark:text-amber-400':'text-[var(--site-muted)]'}`}><i class={`fa-solid ${i.severity==='error'?'fa-circle-exclamation':i.severity==='warning'?'fa-triangle-exclamation':'fa-circle-info'} mt-0.5`} aria-hidden="true"></i><span>{i.message}</span></li>)}</ul>}
</article>
)})}
</div>
</main>
<script>
const q=document.getElementById('img-search'),onlyIssues=document.getElementById('img-only-issues'),typeFilters=[...document.querySelectorAll('.img-type-filter')],rows=[...document.querySelectorAll('.img-row')],count=document.getElementById('img-count');
let activeType='all';
function update(){
  const term=(q&&'value' in q?q.value:'').toLocaleLowerCase('fa-IR').trim();
  const issuesOnly=onlyIssues&&'checked' in onlyIssues?onlyIssues.checked:false;
  let n=0;
  rows.forEach(r=>{
    const title=(r.getAttribute('data-title')||'').toLocaleLowerCase('fa-IR');
    const type=r.getAttribute('data-type');
    const hasIssues=r.getAttribute('data-has-issues')==='1';
    const visible=(!term||title.includes(term))&&(activeType==='all'||type===activeType)&&(!issuesOnly||hasIssues);
    r.hidden=!visible;
    if(visible)n++;
  });
  if(count)count.textContent=`${n} صفحه نمایش داده می‌شود.`;
  typeFilters.forEach(b=>{const a=b.getAttribute('data-type-filter')===activeType;b.classList.toggle('bg-[var(--site-primary)]',a);b.classList.toggle('text-white',a);b.classList.toggle('border-[var(--site-primary)]',a);});
}
q?.addEventListener('input',update);
onlyIssues?.addEventListener('change',update);
typeFilters.forEach(b=>b.addEventListener('click',()=>{activeType=b.getAttribute('data-type-filter')||'all';update();}));
update();
</script>
</AdminLayout>
