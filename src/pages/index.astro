---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const courses = await getCollection('courses');
const projects = await getCollection('projects');
const notes = await getCollection('notes');

const defaultImage = "/images/hero.png";

// داده‌ساختاریافته: سازمان آموزشی + فهرست دوره‌ها (برای نتایج غنی گوگل)
const siteUrl = "https://optexpert.org";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Optimization Expert",
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}${defaultImage}`,
  "description": "دوره‌های تخصصی و پروژه‌محور در حوزه بهینه‌سازی، سیستم‌های قدرت، عدم قطعیت و مسیریابی وسایل نقلیه در Python.",
  "sameAs": [
    "https://github.com/OptimizationExpert",
    "https://t.me/pypyid"
  ]
};

const courseListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": courses.map((course, index) => {
    const slug = course.id.replace(/\.md$/, '').split('/').pop();
    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Course",
        "name": course.data.title,
        "description": course.data.description,
        "url": `${siteUrl}/courses/${slug}/`,
        "provider": {
          "@type": "EducationalOrganization",
          "name": "Optimization Expert",
          "url": `${siteUrl}/`
        }
      }
    };
  })
};
---

<Layout title="مدل‌سازی و بهینه‌سازی کاربردی" description="مرجع تخصصی مدل‌سازی ریاضی، برنامه‌نویسی پایتون، سالورهای بهینه‌سازی و تحلیل سیستم‌های قدرت به صورت پروژه‌محور.">

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(courseListSchema)} />

  <Header />

  <main class="flex-grow w-full overflow-hidden">
    
    <!-- ۱. بخش بنر (Hero Section) کاملاً سبک و بدون انیمیشن‌های پس‌زمینه -->
    <section class="relative bg-[var(--site-bg)] border-b border-[var(--site-border)] overflow-hidden py-32 md:py-40 px-6">
      <!-- تصویر بک‌گراند ثابت، ایستا و بدون تغییر مقیاس -->
      <div class="absolute inset-0 opacity-85 bg-cover bg-center" style={`background-image: url('${defaultImage}');`}></div>
      
      <!-- لایه تیره عمیق برای خوانایی کامل متن -->
      <div class="absolute inset-0 bg-black/35 dark:bg-black/90"></div>

      <div class="max-w-4xl mx-auto relative z-10 text-center space-y-9">
        
        <!-- برچسب بالا کاملاً ایستا و سبک -->
        <div class="inline-flex items-center gap-2.5 text-xs font-bold text-white bg-black/80 px-6 py-3 rounded-full border border-white/20 shadow-lg">
          <i class="fa-solid fa-bolt text-amber-400 text-sm"></i>
          <span>مرجع تخصصی مدل‌سازی، بهینه‌سازی و سیستم‌های قدرت</span>
        </div>

        <!-- عنوان اصلی با تایپ‌کننده بومی سریع و سبک -->
        <div class="min-h-[4rem] flex items-center justify-center w-full overflow-x-hidden">
          <h1 class="text-xl sm:text-3xl md:text-5xl font-black tracking-tight whitespace-nowrap" style="text-shadow: 0 4px 25px rgba(0,0,0,0.95);">
            <span id="typewriter-output" class="text-white"></span>
          </h1>
        </div>

        <p class="text-gray-100 text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-medium" style="text-shadow: 0 2px 12px rgba(0,0,0,0.95);">
          توسعه مدل‌های ریاضی پیشرفته، سالورهای بهینه‌سازی در پایتون، و تحلیل شبکه‌های قدرت با رویکردی کاملاً کاربردی و پروژه‌محور.
        </p>

        <!-- دکمه‌ها بدون افکت‌های سنگین -->
        <div class="flex flex-wrap justify-center items-center gap-6 pt-4">
          <a href="/courses" class="bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold px-9 py-4 rounded-2xl transition-all duration-200 shadow-xl shadow-sky-500/20 text-sm flex items-center gap-3 border border-sky-400/30">
            <i class="fa-solid fa-graduation-cap text-base text-sky-200"></i>
            <span>مشاهده دوره‌های آموزشی</span>
          </a>
          <a href="/consultation" class="bg-slate-950 hover:bg-slate-900 text-white border-2 border-amber-400 hover:border-amber-300 font-bold px-9 py-4 rounded-2xl transition-all duration-200 text-sm flex items-center gap-3 shadow-xl shadow-amber-500/5">
            <i class="fa-solid fa-comments text-amber-400"></i>
            <span>درخواست مشاوره تخصصی</span>
          </a>
        </div>

      </div>
    </section>

    <!-- اسکریپت بومی تایپ‌کننده استاندارد و فوق‌العاده سبک -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const output = document.getElementById('typewriter-output');
        if (!output) return;

        const text1 = "ابتدا ";
        const text2 = "مدل‌سازی درست";
        const text3 = "، سپس حل بهینه.";
        const totalLen = text1.length + text2.length + text3.length;
        
        const cursorHTML = `<span class="inline-block w-1.5 h-5 sm:h-8 bg-amber-400 mr-1.5 align-middle rounded-full opacity-90"></span>`;

        let charIndex = 0;
        let isDeleting = false;
        let delay = 100;

        function loop() {
          if (!isDeleting) {
            charIndex++;
            if (charIndex > totalLen) {
              isDeleting = true;
              delay = 3000; 
            } else {
              delay = 80; 
            }
          } else {
            charIndex--;
            if (charIndex === 0) {
              isDeleting = false;
              delay = 1000; 
            } else {
              delay = 35; 
            }
          }

          let currentHTML = "";
          let t1End = text1.length;
          let t2End = text1.length + text2.length;

          if (charIndex <= t1End) {
            currentHTML = text1.substring(0, charIndex);
          } else if (charIndex <= t2End) {
            let part1Str = text1;
            let typedPart2 = text2.substring(0, charIndex - t1End);
            let part2Str = `<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-300 to-amber-400 font-black inline mx-1">${typedPart2}</span>`;
            currentHTML = part1Str + part2Str;
          } else {
            let part1Str = text1;
            let part2Str = `<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-300 to-amber-400 font-black inline mx-1">${text2}</span>`;
            let part3Str = text3.substring(0, charIndex - t2End);
            currentHTML = part1Str + part2Str + part3Str;
          }

          output.innerHTML = currentHTML + cursorHTML;
          setTimeout(loop, delay);
        }

        setTimeout(loop, 500);
      });
    </script>

    <!-- ۲. بخش دوره‌های آموزشی -->
    <section class="max-w-6xl mx-auto px-6 py-24">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1.5">آموزش تخصصی</span>
          <h2 class="text-2xl md:text-3xl font-black text-[var(--site-heading)]">آخرین دوره‌های آموزشی</h2>
        </div>
        <a href="/courses" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-4 py-2.5 rounded-xl transition-all duration-200 inline-flex items-center gap-2">
          <span>مشاهده همه</span>
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {courses.slice(0, 3).map((course) => {
          const cleanSlug = course.id.replace(/\.md$/, '').split('/').pop();
          const courseImg = course.data.image || defaultImage;
          return (
            <article class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)] hover:shadow-xl transition-all duration-200 shadow-sm">
              <div>
                <div class="w-full aspect-video rounded-2xl bg-[var(--site-bg)] mb-5 overflow-hidden border border-[var(--site-border)] relative">
                  <img src={courseImg} alt={course.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  {course.data.level && (
                    <span class="text-[10px] font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3 py-1 rounded-lg border border-[var(--site-primary)]/20">
                      {course.data.level}
                    </span>
                  )}
                </div>
                <h3 class="text-base md:text-lg font-bold text-[var(--site-heading)] mb-2 hover:text-[var(--site-primary)] transition-colors line-clamp-1">
                  <a href={`/courses/${cleanSlug}`}>{course.data.title}</a>
                </h3>
                <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-2 mb-4">
                  {course.data.description}
                </p>
              </div>
              <div class="pt-4 border-t border-[var(--site-border)]/60 flex items-center justify-between">
                <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 font-medium">
                  <i class="fa-regular fa-clock text-[var(--site-primary)]"></i>
                  <span>{course.data.duration || "دوره کاربردی"}</span>
                </span>
                <a href={`/courses/${cleanSlug}`} class="text-xs text-[var(--site-primary)] hover:opacity-80 font-bold inline-flex items-center gap-1.5">
                  <span>مشاهده دوره</span>
                  <i class="fa-solid fa-arrow-left text-[10px]"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ۳. بخش پروژه‌ها -->
    <section class="bg-[var(--site-card)]/40 border-y border-[var(--site-border)] py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1.5">پروژه‌های اجرایی</span>
            <h2 class="text-2xl md:text-3xl font-black text-[var(--site-heading)]">پروژه‌های مهندسی و فنی</h2>
          </div>
          <a href="/projects" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-4 py-2.5 rounded-xl transition-all duration-200 inline-flex items-center gap-2">
            <span>مشاهده همه</span>
            <i class="fa-solid fa-arrow-left text-[10px]"></i>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {projects.slice(0, 3).map((project) => {
            const cleanSlug = project.id.replace(/\.md$/, '').split('/').pop();
            const projectImg = project.data.image || defaultImage;
            return (
              <article class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)] hover:shadow-xl transition-all duration-200 shadow-sm">
                <div>
                  <div class="w-full aspect-video rounded-2xl bg-[var(--site-bg)] mb-4 overflow-hidden border border-[var(--site-border)] relative">
                    <img src={projectImg} alt={project.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  </div>
                  <h3 class="text-base md:text-lg font-bold text-[var(--site-heading)] mb-2 hover:text-[var(--site-primary)] transition-colors line-clamp-1">
                    <a href={`/projects/${cleanSlug}`}>{project.data.title}</a>
                  </h3>
                  <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-2 mb-4">
                    {project.data.description}
                  </p>
                </div>
                <div class="pt-4 border-t border-[var(--site-border)]/60 flex items-center justify-between">
                  <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 font-medium">
                    <i class="fa-solid fa-layer-group text-[var(--site-primary)]"></i>
                    <span>{project.data.category || "پروژه تخصصی"}</span>
                  </span>
                  <a href={`/projects/${cleanSlug}`} class="text-xs text-[var(--site-primary)] hover:opacity-80 font-bold inline-flex items-center gap-1.5">
                    <span>بررسی پروژه</span>
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ۴. بخش یادداشت‌ها و مقالات -->
    <section class="max-w-6xl mx-auto px-6 py-24">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1.5">مقالات تخصصی</span>
          <h2 class="text-2xl md:text-3xl font-black text-[var(--site-heading)]">آخرین مقالات و یادداشت‌ها</h2>
        </div>
        <a href="/notes" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-4 py-2.5 rounded-xl transition-all duration-200 inline-flex items-center gap-2">
          <span>مشاهده همه</span>
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {notes.slice(0, 3).map((note) => {
          const cleanSlug = note.id.replace(/\.md$/, '').split('/').pop();
          const noteImg = note.data.image || defaultImage;
          return (
            <article class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)] hover:shadow-xl transition-all duration-200 shadow-sm">
              <div>
                <div class="w-full aspect-video rounded-2xl bg-[var(--site-bg)] mb-4 overflow-hidden border border-[var(--site-border)] relative">
                  <img src={noteImg} alt={note.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover" />
                </div>
                <h3 class="text-base md:text-lg font-bold text-[var(--site-heading)] mb-2 hover:text-[var(--site-primary)] transition-colors line-clamp-1">
                  <a href={`/notes/${cleanSlug}`}>{note.data.title}</a>
                </h3>
                <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-2 mb-4">
                  {note.data.description}
                </p>
              </div>
              <div class="pt-4 border-t border-[var(--site-border)]/60 flex items-center justify-between">
                <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 font-medium">
                  <i class="fa-regular fa-calendar text-[var(--site-primary)]"></i>
                  <span>{new Date(note.data.pubDate).toLocaleDateString('fa-IR')}</span>
                </span>
                <a href={`/notes/${cleanSlug}`} class="text-xs text-[var(--site-primary)] hover:opacity-80 font-bold inline-flex items-center gap-1.5">
                  <span>مطالعه مقاله</span>
                  <i class="fa-solid fa-arrow-left text-[10px]"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

  </main>

  <Footer />

</Layout>
