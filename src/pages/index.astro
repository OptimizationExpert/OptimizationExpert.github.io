---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';
import HorizontalScroller from '../components/HorizontalScroller.astro';
import ScrollerControls from '../components/ScrollerControls.astro';

const rawCourses = await getCollection('courses');
const rawProjects = await getCollection('projects');
const rawNotes = await getCollection('notes');

const sortByDateDesc = (items: any[]) => {
  return [...items].sort((a, b) => {
    const dateA = new Date(a.data.pubDate || a.data.date || a.data.createdDate || 0).getTime();
    const dateB = new Date(b.data.pubDate || b.data.date || b.data.createdDate || 0).getTime();
    return dateB - dateA;
  });
};

const courses = sortByDateDesc(rawCourses);
const projects = sortByDateDesc(rawProjects);
const notes = sortByDateDesc(rawNotes);

const defaultImage = "/images/hero.webp";
---

<Layout title="مدل‌سازی و بهینه‌سازی کاربردی" description="مرجع تخصصی مدل‌سازی ریاضی، برنامه‌نویسی پایتون، سالورهای بهینه‌سازی و تحلیل سیستم‌های قدرت به صورت پروژه‌محور.">
   
  <!-- ۱. بخش بنر (Hero Section) با نسبت 16:9 و ارتفاع فشرده و کنترل‌شده -->
  <section class="w-full relative overflow-hidden bg-slate-950 h-[220px] xs:h-[260px] sm:h-[320px] md:h-[380px] lg:h-[420px] flex items-center justify-center">
    
    <!-- تصویر اصلی با پوشش کامل -->
    <img 
      src={defaultImage} 
      alt="مرجع تخصصی مدل‌سازی و بهینه‌سازی" 
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-0 brightness-90" 
    />
    
    <!-- محتوای روی تصویر -->
    <div class="relative z-20 w-full max-w-5xl mx-auto px-3 xs:px-4 sm:px-6 flex flex-col items-center justify-center text-center space-y-2.5 sm:space-y-3.5">
        
      <!-- نشان‌گر -->
      <div class="inline-flex items-center gap-1.5 xs:gap-2 text-[10px] xs:text-[11px] sm:text-xs font-bold text-white bg-slate-950/70 backdrop-blur-md px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full border border-white/20 shadow-lg">
        <i class="fa-solid fa-bolt text-[var(--site-gold)] text-xs sm:text-sm shrink-0"></i>
        <span class="truncate">مرجع تخصصی مدل‌سازی، بهینه‌سازی و سیستم‌های قدرت</span>
      </div>

      <h1 class="sr-only">مرجع تخصصی مدل‌سازی ریاضی، برنامه‌نویسی پایتون و بهینه‌سازی سیستم‌های قدرت</h1>

      <!-- تیتر اصلی -->
      <div class="min-h-[1.75rem] xs:min-h-[2rem] sm:min-h-[2.25rem] flex items-center justify-center w-full" aria-hidden="true">
        <div class="text-sm xs:text-base sm:text-xl md:text-2xl lg:text-3xl font-black tracking-tight leading-snug text-white drop-shadow-[0_4px_12px_rgba(0,0,0,1)]">
          <span id="typewriter-output"></span>
        </div>
      </div>

      <!-- توضیحات با عرض کمتر و وسط‌چین‌شده -->
      <p class="text-white text-[15px] xs:text-xs sm:text-sm md:text-base max-w-lg mx-auto text-center leading-relaxed font-semibold [text-shadow:_0_2px_4px_rgb(0_0_0_/_90%),_0_0_16px_rgb(0_0_0_/_70%)] px-2">
        توسعه مدل‌های ریاضی پیشرفته، سالورهای بهینه‌سازی در پایتون، و تحلیل شبکه‌های قدرت با رویکردی کاملاً کاربردی و پروژه‌محور.
      </p>

      <!-- دکمه‌ها -->
      <div class="flex flex-row items-center justify-center gap-2 sm:gap-3 pt-1 w-full max-w-md sm:max-w-lg mx-auto">
        <a href="/courses" class="flex-1 bg-gradient-to-r from-[var(--site-primary)] to-[var(--site-secondary)] hover:brightness-110 text-white font-bold px-3 py-2 sm:px-6 sm:py-2.5 rounded-xl transition-transform duration-200 hover:-translate-y-0.5 text-[10px] xs:text-xs sm:text-sm flex items-center justify-center gap-1.5 sm:gap-2 border border-[var(--site-primary)]/30 shadow-xl truncate">
          <i class="fa-solid fa-graduation-cap text-xs sm:text-sm text-white/90 shrink-0"></i>
          <span class="truncate">مشاهده دوره‌های آموزشی</span>
        </a>
        
        <a href="/consultation" class="flex-1 relative bg-slate-950/85 hover:bg-slate-900/95 text-white font-bold px-3 py-2 sm:px-6 sm:py-2.5 rounded-xl transition-transform duration-200 hover:-translate-y-0.5 border border-[var(--site-gold)]/80 text-[10px] xs:text-xs sm:text-sm flex items-center justify-center gap-1.5 sm:gap-2 shadow-xl backdrop-blur-md truncate">
          <span class="absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[var(--site-gold)] to-transparent opacity-80"></span>
          <i class="fa-solid fa-comments text-[var(--site-gold)] text-xs sm:text-sm relative z-10 shrink-0"></i>
          <span class="relative z-10 truncate">درخواست مشاوره تخصصی</span>
        </a>
      </div>
    </div>
  </section>

  <!-- اسکریپت تایپ‌کننده -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const output = document.getElementById('typewriter-output');
      if (!output) return;

      const text1 = "ابتدا ";
      const text2 = "مدل‌سازی درست";
      const text3 = "، سپس حل بهینه";
      const totalLen = text1.length + text2.length + text3.length;
      
      const cursorHTML = `<span class="inline-block w-1 sm:w-1.5 h-[0.9em] bg-[var(--site-gold)] mr-1 align-middle rounded-full opacity-90"></span>`;

      let charIndex = 0;
      let isDeleting = false;
      let delay = 100;

      function loop() {
        if (!isDeleting) {
          charIndex++;
          if (charIndex > totalLen) {
            isDeleting = true;
            delay = 3000; 
          } else {
            delay = 80; 
          }
        } else {
          charIndex--;
          if (charIndex === 0) {
            isDeleting = false;
            delay = 1000; 
          } else {
            delay = 35; 
          }
        }

        let currentHTML = "";
        let t1End = text1.length;
        let t2End = text1.length + text2.length;
        const goldGradientStyle = `gold-shimmer font-black inline-block mx-0.5`;

        if (charIndex <= t1End) {
          currentHTML = text1.substring(0, charIndex);
        } else if (charIndex <= t2End) {
          currentHTML = text1 + `<span class="${goldGradientStyle}">${text2.substring(0, charIndex - t1End)}</span>`;
        } else {
          currentHTML = text1 + `<span class="${goldGradientStyle}">${text2}</span>` + text3.substring(0, charIndex - t2End);
        }

        output.innerHTML = currentHTML + cursorHTML;
        setTimeout(loop, delay);
      }
      setTimeout(loop, 500);
    });
  </script>

  <!-- بخش دوره‌های آموزشی -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20 w-full">
    <div class="flex items-end justify-between mb-8 sm:mb-12 gap-2">
      <div>
        <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1">آموزش تخصصی</span>
        <h2 class="text-xl sm:text-3xl font-black text-[var(--site-heading)]">آخرین دوره‌های آموزشی</h2>
      </div>
      <div class="shrink-0 flex items-center gap-2">
        <ScrollerControls id="scroller-courses" />
        <a href="/courses" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-4 py-2 rounded-xl transition-colors hover:bg-[var(--site-primary)] hover:text-white inline-flex items-center gap-1">
          مشاهده همه
        </a>
      </div>
    </div>
    <HorizontalScroller id="scroller-courses">
      {courses.slice(0, 10).map((course) => (
        <ContentCard
          widthClass="w-[280px] sm:w-[320px]"
          href={`/courses/${course.id.replace(/\.md$/, '').split('/').pop()}`}
          image={course.data.minimalImage || course.data.image || defaultImage}
          imageAlt={course.data.title}
          title={course.data.title}
          description={course.data.description}
          badge={course.data.level}
          metaIcon="fa-regular fa-clock"
          metaText={course.data.duration || "دوره کاربردی"}
          actionText="مشاهده دوره"
        />
      ))}
    </HorizontalScroller>
  </section>

  <!-- بخش پروژه‌ها -->
  <section class="bg-[var(--site-card)]/40 border-y border-[var(--site-border)] py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
      <div class="flex items-end justify-between mb-8 sm:mb-12 gap-2">
        <div>
          <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1">پروژه‌های اجرایی</span>
          <h2 class="text-xl sm:text-3xl font-black text-[var(--site-heading)]">پروژه‌های مهندسی</h2>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <ScrollerControls id="scroller-projects" />
          <a href="/projects" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-4 py-2 rounded-xl transition-colors hover:bg-[var(--site-primary)] hover:text-white inline-flex items-center gap-1">
            مشاهده همه
          </a>
        </div>
      </div>
      <HorizontalScroller id="scroller-projects">
        {projects.slice(0, 10).map((project) => (
          <ContentCard
            widthClass="w-[280px] sm:w-[320px]"
            href={`/projects/${project.id.replace(/\.md$/, '').split('/').pop()}`}
            image={project.data.minimalImage || project.data.image || defaultImage}
            imageAlt={project.data.title}
            title={project.data.title}
            description={project.data.description}
            metaIcon="fa-solid fa-layer-group"
            metaText={project.data.category || "پروژه تخصصی"}
            actionText="بررسی پروژه"
          />
        ))}
      </HorizontalScroller>
    </div>
  </section>

  <!-- بخش مقالات -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20 w-full">
    <div class="flex items-end justify-between mb-8 sm:mb-12 gap-2">
      <div>
        <span class="text-xs font-bold text-[var(--site-primary)] uppercase tracking-widest block mb-1">مقالات تخصصی</span>
        <h2 class="text-xl sm:text-3xl font-black text-[var(--site-heading)]">آخرین یادداشت‌ها</h2>
      </div>
      <div class="shrink-0 flex items-center gap-2">
        <ScrollerControls id="scroller-notes" />
        <a href="/notes" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-4 py-2 rounded-xl transition-colors hover:bg-[var(--site-primary)] hover:text-white inline-flex items-center gap-1">
          مشاهده همه
        </a>
      </div>
    </div>
    <HorizontalScroller id="scroller-notes">
      {notes.slice(0, 10).map((note) => (
        <ContentCard
          widthClass="w-[280px] sm:w-[320px]"
          href={`/notes/${note.id.replace(/\.md$/, '').split('/').pop()}`}
          image={note.data.minimalImage || note.data.image || defaultImage}
          imageAlt={note.data.title}
          title={note.data.title}
          description={note.data.description}
          metaIcon="fa-regular fa-calendar"
          metaText={note.data.pubDate ? new Date(note.data.pubDate).toLocaleDateString('fa-IR') : "مقاله تخصصی"}
          actionText="مطالعه مقاله"
        />
      ))}
    </HorizontalScroller>
  </section>
</Layout>
