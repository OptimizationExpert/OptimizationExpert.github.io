---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { imgSrc } from '../../utils/image';

export async function getStaticPaths() {
  const instructors = await getCollection('instructors');
  return instructors.map((instructor) => ({
    params: { instructorSlug: instructor.id.replace(/\.md$/, '').split('/').pop() },
    props: { instructor },
  }));
}

const { instructor } = Astro.props;
const instructorSlug = instructor.id.replace(/\.md$/, '').split('/').pop();
const { Content } = await render(instructor);

// دریافت مجموعه‌ها به صورت موازی برای بهینه‌سازی عملکرد
const [allCourses, allNotes, allProjects] = await Promise.all([
  getCollection('courses'),
  getCollection('notes'),
  getCollection('projects')
]);

const instructorCourses = allCourses.filter(c => c.data.instructor === instructorSlug);
const instructorNotes = allNotes.filter(n => n.data.author === instructor.data.name || n.data.author === instructorSlug);
const instructorProjects = allProjects.filter(p => p.data.instructor === instructorSlug);

const siteUrl = (Astro.site || new URL(Astro.url.origin)).href.replace(/\/$/, '');
const sameAs = [instructor.data.githubUrl, instructor.data.linkedinUrl].filter(Boolean);
const instructorImg = imgSrc(instructor.data.image);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": instructor.data.name,
  "url": `${siteUrl}/instructors/${instructorSlug}/`,
  ...(instructor.data.title && { "jobTitle": instructor.data.title }),
  // new URL(...) هم مسیر نسبی (/images/x.png) و هم لینک مطلق (https://...) را درست مدیریت می‌کند؛
  // قبلاً با الحاق مستقیم رشته، تصویرهای خارجی به یک URL خراب مثل site.orghttps://... تبدیل می‌شدند.
  ...(instructorImg && { "image": new URL(instructorImg, siteUrl).href }),
  ...(instructor.data.email && { "email": instructor.data.email }),
  ...(sameAs.length > 0 && { "sameAs": sameAs }),
};
---

<Layout 
  title={instructor.data.seoTitle || `پروفایل ${instructor.data.name}`} 
  description={instructor.data.title || `مقاله‌ها، دوره‌ها و پروژه‌های ${instructor.data.name}`} 
  image={instructorImg}
  breadcrumbs={[
    { name: 'خانه', url: '/' },
    { name: instructor.data.name },
  ]}
>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- دکمه بازگشت -->
    <div class="mb-8">
      <a href="/courses/" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت</span>
      </a>
    </div>

    <!-- کارت معرفی مدرس -->
    <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-6 md:p-10 mb-12 shadow-xs">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        {instructor.data.image && (
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden border-2 border-[var(--site-primary)]/30 bg-[var(--site-bg)] flex-shrink-0 shadow-md">
            {typeof instructor.data.image === 'string' ? (
              <img src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover" />
            ) : (
              <Image src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover" />
            )}
          </div>
        )}
        <div class="flex-grow text-center md:text-right">
          <h1 class="text-2xl md:text-3xl font-extrabold text-[var(--site-heading)] mb-2">
            {instructor.data.name}
          </h1>
          {instructor.data.title && (
            <p class="text-sm text-[var(--site-primary)] font-medium mb-4">
              {instructor.data.title}
            </p>
          )}
          <div class="text-[var(--site-text)] text-sm leading-relaxed prose max-w-none">
            <Content />
          </div>
        </div>
      </div>
    </div>

    <!-- دوره‌های آموزشی مدرس -->
    {instructorCourses.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-[var(--site-heading)] mb-6 flex items-center gap-2 border-b border-[var(--site-border)] pb-3">
          <i class="fa-solid fa-graduation-cap text-[var(--site-primary)]"></i>
          <span>دوره‌های آموزشی مدرس</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {instructorCourses.map((course) => {
            const slug = course.id.replace(/\.md$/, '').split('/').pop();
            const image = course.data.minimalImage || course.data.image;
            return (
              <a href={`/courses/${slug}/`} class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 rounded-2xl p-4 sm:p-5 transition-all duration-300 group shadow-xs flex flex-col justify-between">
                <div>
                  {image && (
                    <div class="w-full aspect-video rounded-xl overflow-hidden border border-[var(--site-border)] bg-[var(--site-bg)] mb-4 shadow-2xs">
                      {typeof image === 'string' ? (
                        <img src={image} alt={course.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      ) : (
                        <Image src={image} alt={course.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      )}
                    </div>
                  )}
                  <h3 class="text-base font-bold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition mb-2">{course.data.title}</h3>
                  <p class="text-[var(--site-muted)] text-xs line-clamp-2 leading-relaxed">{course.data.description}</p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--site-border)] flex items-center justify-between text-xs font-semibold text-[var(--site-primary)]">
                  <span>مشاهده دوره</span>
                  <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- مقالات و یادداشت‌های مدرس -->
    {instructorNotes.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-[var(--site-heading)] mb-6 flex items-center gap-2 border-b border-[var(--site-border)] pb-3">
          <i class="fa-solid fa-pen-nib text-[var(--site-primary)]"></i>
          <span>مقاله‌ها و یادداشت‌ها</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {instructorNotes.map((note) => {
            const slug = note.id.replace(/\.md$/, '').split('/').pop();
            const image = note.data.minimalImage || note.data.image;
            return (
              <a href={`/notes/${slug}/`} class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 rounded-2xl p-4 sm:p-5 transition-all duration-300 group shadow-xs flex flex-col justify-between">
                <div>
                  {image && (
                    <div class="w-full aspect-video rounded-xl overflow-hidden border border-[var(--site-border)] bg-[var(--site-bg)] mb-4 shadow-2xs">
                      {typeof image === 'string' ? (
                        <img src={image} alt={note.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      ) : (
                        <Image src={image} alt={note.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      )}
                    </div>
                  )}
                  <h3 class="text-base font-bold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition mb-2">{note.data.title}</h3>
                  <p class="text-[var(--site-muted)] text-xs line-clamp-2 leading-relaxed">{note.data.description}</p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--site-border)] flex items-center justify-between text-xs font-semibold text-[var(--site-primary)]">
                  <span>مطالعه مقاله</span>
                  <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- پروژه‌های مدرس -->
    {instructorProjects.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-[var(--site-heading)] mb-6 flex items-center gap-2 border-b border-[var(--site-border)] pb-3">
          <i class="fa-solid fa-code text-[var(--site-primary)]"></i>
          <span>پروژه‌های تخصصی</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {instructorProjects.map((project) => {
            const slug = project.id.replace(/\.md$/, '').split('/').pop();
            const image = project.data.minimalImage || project.data.image;
            return (
              <a href={`/projects/${slug}/`} class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:shadow-xl hover:-translate-y-1 rounded-2xl p-4 sm:p-5 transition-all duration-300 group shadow-xs flex flex-col justify-between">
                <div>
                  {image && (
                    <div class="w-full aspect-video rounded-xl overflow-hidden border border-[var(--site-border)] bg-[var(--site-bg)] mb-4 shadow-2xs">
                      {typeof image === 'string' ? (
                        <img src={image} alt={project.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      ) : (
                        <Image src={image} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      )}
                    </div>
                  )}
                  <h3 class="text-base font-bold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition mb-2">{project.data.title}</h3>
                  <p class="text-[var(--site-muted)] text-xs line-clamp-2 leading-relaxed">{project.data.description}</p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--site-border)] flex items-center justify-between text-xs font-semibold text-[var(--site-primary)]">
                  <span>مشاهده پروژه</span>
                  <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </main>

</Layout>