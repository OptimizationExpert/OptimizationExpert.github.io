---
import { entrySlug, isPublished } from '../../utils/content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
  let softwares = [];
  try {
    softwares = await getCollection('softwares', isPublished);
  } catch (e) {
    softwares = [];
  }

  const sortedSoftwares = softwares.sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  });

  return paginate(sortedSoftwares, { pageSize: 10 });
}

const { page } = Astro.props;
// تصویر پیش‌فرض یکسان با بقیه‌ی سایت (قبلاً به‌اشتباه تصویر یک دوره استفاده می‌شد)
const defaultImage = "/images/hero.webp";
import { sized, CARD } from '../../utils/image-sizes';

// Tools used across the site's tutorials (shown on page 1 only).
const tools = [
  { name: 'Python', url: 'https://www.python.org/', use: 'زبان همهٔ آموزش‌ها و پروژه‌ها', license: 'رایگان (PSF)' },
  { name: 'Pyomo', url: 'https://www.pyomo.org/', use: 'زبان مدل‌سازی جبری برای LP، MILP و مسائل غیرخطی؛ ابزار اصلی آموزش‌های سیستم قدرت', license: 'متن‌باز (BSD)' },
  { name: 'OR-Tools', url: 'https://developers.google.com/optimization', use: 'سالور CP-SAT برای زمان‌بندی و تخصیص، و کتابخانهٔ مسیریابی برای VRP', license: 'متن‌باز (Apache 2.0)' },
  { name: 'HiGHS', url: 'https://highs.dev/', use: 'سالور سریع برنامه‌ریزی خطی و عدد صحیح (LP و MILP)', license: 'متن‌باز (MIT)' },
  { name: 'CBC', url: 'https://github.com/coin-or/Cbc', use: 'سالور برنامه‌ریزی عدد صحیح از پروژهٔ COIN-OR؛ سالور پیش‌فرض PuLP', license: 'متن‌باز (EPL)' },
  { name: 'IPOPT', url: 'https://coin-or.github.io/Ipopt/', use: 'سالور مسائل غیرخطی پیوسته، مثل پخش بار بهینهٔ AC', license: 'متن‌باز (EPL)' },
  { name: 'GLPK', url: 'https://www.gnu.org/software/glpk/', use: 'سالور سبک برنامه‌ریزی خطی و عدد صحیح برای مدل‌های کوچک', license: 'متن‌باز (GPL)' },
  { name: 'Gurobi', url: 'https://www.gurobi.com/', use: 'سالور تجاری بسیار سریع برای مسائل بزرگ عدد صحیح', license: 'تجاری؛ لایسنس دانشگاهی رایگان' },
  { name: 'GAMS', url: 'https://www.gams.com/', use: 'زبان مدل‌سازی جبری کلاسیک؛ مرجع کتاب سیستم قدرت دکتر سرودی', license: 'تجاری؛ نسخهٔ رایگان محدود' },
];
---

<Layout title="نرم‌افزارها و ابزارها" description="دانلود و راهنمای نصب نرم‌افزارها و سالورهای بهینه‌سازی و محیط‌های توسعهٔ تخصصی مهندسی، برای کار با پایتون، Pyomo، OR-Tools و GAMS." 
  pageNumber={page.currentPage}
  breadcrumbs={[{ name: 'خانه', url: '/' }, { name: 'دانلود نرم‌افزار' }]}>

  <main class="flex-grow">
    
    <section class="bg-[var(--site-card)] border-b border-[var(--site-border)] py-16 px-6">
      <div class="max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/20">
          <i class="fa-solid fa-laptop-code"></i>
          <span>ابزارها و محیط‌های توسعه</span>
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-[var(--site-heading)] tracking-tight">
          نرم‌افزارها و ابزارها
        </h1>
        <p class="text-[var(--site-muted)] text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
          ابزارها، سالورها و منابع نرم‌افزاری که در آموزش‌های بهینه‌سازی این سایت به کار می‌روند؛ همراه با کاربرد، مجوز و راهنمای نصب.
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-12">
      {page.data.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.data.map((software) => {
            const cleanSlug = entrySlug(software);
            const softwareImg = software.data.image || defaultImage;
            return (
              <div class="card-stretched relative bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-5 flex flex-col justify-between hover:border-[var(--site-primary)]/40 hover:shadow-md transition-all duration-300 shadow-xs">
                <div>
                  <div class="w-full aspect-video rounded-xl bg-[var(--site-bg)] mb-4 overflow-hidden border border-[var(--site-border)] relative group">
                    {typeof softwareImg === 'string' ? (
                      <img src={softwareImg} alt={software.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    ) : (
                      <Image src={softwareImg} alt={software.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" {...sized(softwareImg, CARD)} />
                    )}
                    {software.data.version && (
                      <span class="absolute top-3 left-3 bg-[var(--site-card)]/90 backdrop-blur text-[var(--site-primary)] text-[10px] font-semibold px-2.5 py-1 rounded-full border border-[var(--site-border)]">
                        نسخه {software.data.version}
                      </span>
                    )}
                  </div>

                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    {software.data.category && (
                      <span class="text-[11px] text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-2.5 py-0.5 rounded-full border border-[var(--site-primary)]/20 font-medium">
                        {software.data.category}
                      </span>
                    )}
                    {software.data.size && (
                      <span class="text-[11px] text-[var(--site-muted)]">
                        <i class="fa-solid fa-hard-drive ml-1 text-[var(--site-primary)]"></i>
                        {software.data.size}
                      </span>
                    )}
                  </div>

                  <h3 class="text-base font-bold text-[var(--site-heading)] mb-2 line-clamp-2">
                    <a href={`/softwares/${cleanSlug}/`} class="stretched-card-link hover:text-[var(--site-primary)] transition">{software.data.title}</a>
                  </h3>

                  <p class="text-[var(--site-muted)] text-xs leading-relaxed line-clamp-3 mb-4">
                    {software.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-[var(--site-border)] flex items-center justify-between">
                  <span class="text-xs font-semibold text-[var(--site-accent)]">{software.data.price || "رایگان"}</span>
                  <a href={`/softwares/${cleanSlug}/`} class="card-action-link text-xs text-[var(--site-primary)] hover:opacity-80 font-medium inline-flex items-center gap-1 transition">
                    <span>مشاهده و دانلود</span>
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 space-y-4">
          <div class="w-16 h-16 bg-[var(--site-card)] rounded-full flex items-center justify-center mx-auto text-[var(--site-primary)] text-2xl border border-[var(--site-border)] shadow-xs">
            <i class="fa-solid fa-laptop-code"></i>
          </div>
          <h3 class="text-lg font-bold text-[var(--site-heading)]">به‌زودی نرم‌افزار و ابزارهای جدید اضافه خواهند شد</h3>
          <p class="text-[var(--site-muted)] text-xs max-w-md mx-auto leading-relaxed">
            در حال جمع‌آوری و بسته‌بندی ابزارها و نرم‌افزارهای کاربردی هستیم. لطفاً بعداً سر بزنید.
          </p>
        </div>
      )}

      <!-- بخش شماره‌گذاری صفحات (Pagination) -->
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        basePath="/softwares/"
      />
    </section>

    {page.currentPage === 1 && (
      <section class="max-w-4xl mx-auto px-6 pb-16" aria-labelledby="tools-title">
        <h2 id="tools-title" class="text-2xl font-black text-[var(--site-heading)] mb-4">ابزارها و سالورهای به‌کاررفته در آموزش‌ها</h2>
        <p class="text-[var(--site-text)] text-sm md:text-base leading-loose mb-6">
          همهٔ آموزش‌های این سایت با پایتون و ابزارهای متن‌باز نوشته شده‌اند، تا بتوانید هر مدل را بدون خرید لایسنس روی سیستم خودتان اجرا کنید. جدول زیر نشان می‌دهد هر ابزار برای چه نوع مسئله‌ای مناسب است و از کجا دریافت می‌شود.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-[var(--site-border)] bg-[var(--site-card)]">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-[var(--site-heading)] bg-[var(--site-bg)]">
                <th class="text-right font-bold px-4 py-3">ابزار</th>
                <th class="text-right font-bold px-4 py-3">کاربرد</th>
                <th class="text-right font-bold px-4 py-3">مجوز</th>
              </tr>
            </thead>
            <tbody class="text-[var(--site-text)]">
              {tools.map((t) => (
                <tr class="border-t border-[var(--site-border)]">
                  <td class="px-4 py-3 font-bold whitespace-nowrap" dir="ltr" style="text-align: right">
                    <a href={t.url} target="_blank" rel="noopener noreferrer" class="text-[var(--site-primary)] hover:underline">{t.name}</a>
                  </td>
                  <td class="px-4 py-3 leading-relaxed">{t.use}</td>
                  <td class="px-4 py-3 whitespace-nowrap text-[var(--site-muted)]">{t.license}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-black text-[var(--site-heading)] mt-12 mb-4">نصب سریع</h2>
        <p class="text-[var(--site-text)] text-sm md:text-base leading-loose mb-4">
          با سه دستور زیر، محیط کاملی برای اجرای تقریباً همهٔ آموزش‌های سایت آماده می‌شود: Pyomo برای مدل‌سازی جبری، HiGHS به‌عنوان سالور رایگان خطی و عدد صحیح، و OR-Tools برای مسائل زمان‌بندی و مسیریابی.
        </p>
        <pre dir="ltr" class="rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] p-4 text-sm overflow-x-auto"><code>pip install pyomo
pip install highspy
pip install ortools</code></pre>
        <p class="text-[var(--site-text)] text-sm md:text-base leading-loose mt-4">
          برای راهنمای کامل نصب و انتخاب سالور، یادداشت <a href="/notes/pyomo-solvers/" class="text-[var(--site-primary)] font-bold hover:underline">سه روش عملی استفاده از سالورها در Pyomo</a> را ببینید. اگر نمی‌خواهید چیزی نصب کنید، همهٔ آموزش‌ها در <a href="/notes/google-colab/" class="text-[var(--site-primary)] font-bold hover:underline">Google Colab</a> هم اجرا می‌شوند. برای شروع یادگیری، از <a href="/pyomo/" class="text-[var(--site-primary)] font-bold hover:underline">راهنمای جامع Pyomo</a> یا <a href="/ortools/" class="text-[var(--site-primary)] font-bold hover:underline">راهنمای جامع OR-Tools</a> استفاده کنید.
        </p>
      </section>
    )}

  </main>

</Layout>