---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const softwares = await getCollection('softwares');
---

<Layout 
  title="نرم‌افزارها و ابزارهای تخصصی" 
  description="مجموعه نرم‌افزارها، ابزارها و اسکریپت‌های کاربردی برای مهندسی و بهینه‌سازی"
>


  <main class="max-w-5xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- هدر صفحه فهرست -->
    <div class="mb-10 text-center md:text-right">
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        نرم‌افزارها و ابزارهای تخصصی
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed">
        مجموعه‌ای از ابزارها، نرم‌افزارهای مهندسی و اسکریپت‌های کاربردی برای حوزه‌های تخصصی و بهینه‌سازی.
      </p>
    </div>

    <!-- شبکه کارت‌های نرم‌افزار -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {softwares.map((software) => {
        const softwareSlug = software.id.replace(/\.md$/, '').split('/').pop();
        return (
          <a 
            href={`/softwares/${softwareSlug}`} 
            class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group shadow-xs hover:shadow-md"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                {software.data.category && (
                  <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1 rounded-full border border-[var(--site-primary)]/20">
                    {software.data.category}
                  </span>
                )}
                {software.data.version && (
                  <span class="text-xs text-[var(--site-heading)] bg-[var(--site-bg)] px-3 py-1 rounded-full border border-[var(--site-border)] shadow-2xs">
                    نسخه {software.data.version}
                  </span>
                )}
              </div>

              <h2 class="text-xl font-bold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition mb-2 leading-snug">
                {software.data.title}
              </h2>

              <p class="text-[var(--site-muted)] text-sm line-clamp-2 leading-relaxed mb-6">
                {software.data.description}
              </p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-[var(--site-border)] text-xs">
              <span class="font-bold text-emerald-500">{software.data.price || "رایگان"}</span>
              <span class="text-[var(--site-primary)] group-hover:translate-x-[-4px] transition inline-flex items-center gap-1 font-medium">
                <span>مشاهده و دانلود</span>
                <i class="fa-solid fa-arrow-left text-[10px]"></i>
              </span>
            </div>
          </a>
        );
      })}
    </div>

  </main>


</Layout>