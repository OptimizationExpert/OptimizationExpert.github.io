---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedContent from '../../components/RelatedContent.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => {
    const cleanSlug = note.id.replace(/\.md$/, '').split('/').pop();
    return {
      params: { noteSlug: cleanSlug },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const { Content } = await render(note);
const noteSlug = note.id.replace(/\.md$/, '').split('/').pop();
---
const siteUrl = "https://optexpert.org";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": note.data.title,
  "description": note.data.description,
  "url": `${siteUrl}/notes/${noteSlug}/`,
  "datePublished": note.data.pubDate.toISOString(),
  "inLanguage": "fa",
  "author": { "@type": "Person", "name": note.data.author },
  "publisher": { "@type": "Organization", "name": "Optimization Expert", "url": `${siteUrl}/` },
  ...(note.data.image && { "image": `${siteUrl}${note.data.image}` }),
};

<Layout title={note.data.title} description={note.data.description} image={note.data.image}>

  <Header />

  <main class="max-w-3xl mx-auto px-6 py-12 flex-grow w-full">
     
    <!-- دکمه بازگشت -->
    <div class="mb-6">
      <a href="/notes" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت به یادداشت‌ها</span>
      </a>
    </div>

    <article>
      <!-- دسته‌بندی، تاریخ انتشار و نویسنده -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          {note.data.category && (
            <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {note.data.category}
            </span>
          )}
          {note.data.pubDate && (
            <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              <i class="fa-regular fa-calendar text-[var(--site-primary)]"></i>
              <span>{note.data.pubDate.toLocaleDateString('fa-IR')}</span>
            </span>
          )}
          {note.data.author && (
            <span class="text-xs font-medium text-[var(--site-primary)] flex items-center gap-1.5 bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              <i class="fa-regular fa-user text-[var(--site-primary)]"></i>
              <span>{note.data.author}</span>
            </span>
          )}
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-6 leading-tight">
        {note.data.title}
      </h1>

      {note.data.description && (
        <p class="text-[var(--site-text)] text-base md:text-lg leading-relaxed mb-6 bg-[var(--site-card)] p-5 rounded-2xl border border-[var(--site-border)] shadow-xs">
          {note.data.description}
        </p>
      )}

      <!-- تصویر یادداشت -->
      {note.data.image && (
        <div class="w-full rounded-2xl overflow-hidden border border-[var(--site-border)] mb-6 bg-[var(--site-card)] flex items-center justify-center shadow-md">
          <img src={note.data.image} alt={note.data.title} class="w-full h-auto object-contain" />
        </div>
      )}

      <hr class="border-[var(--site-border)] mb-10" />

      <!-- محتوای یادداشت -->
      <div class="prose max-w-none leading-loose text-[var(--site-text)] space-y-6">
        <Content />
      </div>

      <!-- کامپوننت مشاوره و ارتباط (جدید) -->
      <div class="mt-12 mb-10 bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-2xl shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-right">
          <h3 class="text-base font-bold text-[var(--site-heading)] mb-1 flex items-center gap-2">
            <i class="fa-solid fa-headset text-[var(--site-primary)]"></i>
            <span>مشاوره و ارتباط با ما</span>
          </h3>
          <p class="text-xs sm:text-sm text-[var(--site-muted)] leading-relaxed">
            برای مشاوره و ثبت‌نام در دوره‌ها و دریافت پروژه‌ها با آیدی <span class="font-bold text-[var(--site-text)]" dir="ltr">@pypyid</span> در تلگرام در تماس باشید.
          </p>
        </div>
        <a 
          href="https://t.me/pypyid" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-sky-500 hover:bg-sky-600 text-white font-medium px-5 py-2.5 rounded-xl transition-all shadow-sm shadow-sky-500/20 text-xs sm:text-sm flex items-center gap-2 shrink-0 hover:-translate-y-0.5"
        >
          <i class="fa-brands fa-telegram text-base"></i>
          <span>ارتباط در تلگرام</span>
        </a>
      </div>

      <!-- برچسب‌ها و مطالب مرتبط -->
      <RelatedContent currentSlug={noteSlug} tags={note.data.tags} />

    </article>

  </main>

  <Footer />

</Layout>

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
