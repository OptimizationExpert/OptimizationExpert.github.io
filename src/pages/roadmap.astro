---
import Layout from '../layouts/Layout.astro';

const learningPaths = [
  {
    title: "مسیر انرژی و سیستم قدرت",
    subtitle: "پخش بار، شبکه‌های توزیع و مدل‌سازی ریسک",
    icon: "fa-solid fa-bolt",
    badge: "حوزه انرژی",
    accentColor: "text-amber-500 bg-amber-500/10 border-amber-500/20",
    steps: [
      { number: "۱", title: "مدل‌سازی مسائل بهینه‌سازی", desc: "آشنایی با متغیرها، تابع هدف و محدودیت‌ها" },
      { number: "۲", title: "بهینه‌سازی سیستم‌های قدرت", desc: "تحلیل و پخش بار بهینه در شبکه‌های الکتریکی" },
      { number: "۳", title: "مدل‌سازی عدم قطعیت", desc: "بررسی ریسک و بهینه‌سازی استوار در انرژی" }
    ]
  },
  {
    title: "مسیر حمل‌ونقل و لجستیک",
    subtitle: "بهینه‌سازی ناوگان، مسیریابی و زنجیره تأمین",
    icon: "fa-solid fa-truck-fast",
    badge: "حوزه لجستیک",
    accentColor: "text-blue-500 bg-blue-500/10 border-blue-500/20",
    steps: [
      { number: "۱", title: "مدل‌سازی مسائل بهینه‌سازی", desc: "آشنایی با متغیرها، تابع هدف و محدودیت‌ها" },
      { number: "۲", title: "آموزش VRP در Python", desc: "حل مسائل مسیریابی وسایل نقلیه با پایتون" },
      { number: "۳", title: "توسعه پروژه‌های واقعی لجستیک", desc: "پیاده‌سازی سناریوهای صنعتی و زنجیره تأمین" }
    ]
  },
  {
    title: "مسیر بهینه سازی حوزه سلامت",
    subtitle: "بهینه‌سازی سرویس دهی حوزه سلامت - تخصیص منابع - مسیریابی",
    icon: "fa-solid fa-message-medical",
    badge: "حوزه سلامت",
    accentColor: "text-blue-500 bg-blue-500/10 border-blue-500/20",
    steps: [
      { number: "۱", title: "مدل‌سازی مسائل بهینه‌سازی", desc: "آشنایی با متغیرها، تابع هدف و محدودیت‌ها" },
      { number: "۲", title: "آموزش Assignment در Python", desc: "حل مسائل مسیریابی آمبولانس با پایتون" },
      { number: "۳", title: "توسعه پروژه‌های واقعی سلامت", desc: "پیاده‌سازی سناریوهای صنعتی و بیمارستانی" }
    ]
  }
];
---

<Layout title="مسیر پیشنهادی یادگیری" description="برای ورود اصولی به بهینه‌سازی، ابتدا مدل‌سازی را یاد بگیرید، سپس وارد حوزه تخصصی مورد علاقه خود شوید." breadcrumbs={[{ name: 'خانه', url: '/' }, { name: 'مسیر یادگیری' }]}>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-16 flex-grow w-full">

    <div class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4">
        <i class="fa-solid fa-map-location-dot"></i>
        <span>نقشه راه تخصصی</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--site-heading)] mb-4 tracking-tight">
        مسیر پیشنهادی یادگیری
      </h1>
      <p class="text-[var(--site-muted)] text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        برای ورود اصولی به بهینه‌سازی، ابتدا مدل‌سازی را یاد بگیرید، سپس وارد حوزه تخصصی مورد علاقه خود شوید.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        learningPaths.map((path) => (
          <div class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 rounded-3xl p-6 md:p-8 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between">
            
            <div>
              <div class="text-center mb-8 pb-6 border-b border-[var(--site-border)]">
                <div class="flex items-center justify-between mb-4">
                  <span class={`w-12 h-12 rounded-2xl ${path.accentColor} border flex items-center justify-center text-base shadow-xs`}>
                    <i class={path.icon}></i>
                  </span>
                  <span class="px-3 py-1 rounded-full bg-[var(--site-border)]/40 text-[var(--site-muted)] text-[10px] font-bold">
                    {path.badge}
                  </span>
                </div>
                <h2 class="text-xl sm:text-2xl font-black text-[var(--site-heading)] mb-2 text-right tracking-tight">
                  {path.title}
                </h2>
                <p class="text-xs sm:text-sm text-[var(--site-muted)] font-medium text-right leading-relaxed">
                  {path.subtitle}
                </p>
              </div>

              <div class="relative space-y-3 pr-3">
                <div class="absolute right-5 top-4 bottom-4 w-0.5 bg-[var(--site-border)]"></div>

                {
                  path.steps.map((step, idx) => (
                    <div class="relative z-10 bg-[var(--site-bg)] border border-[var(--site-border)] p-4 rounded-2xl flex items-center gap-4">
                      
                      <div class={`w-9 h-9 rounded-xl font-bold text-xs flex items-center justify-center shrink-0 text-white ${idx === 2 ? 'bg-[var(--site-accent)]' : 'bg-[var(--site-primary)]'}`}>
                        {step.number}
                      </div>

                      <div class="flex-1 min-w-0 text-right">
                        <div class="text-xs sm:text-sm font-extrabold text-[var(--site-heading)] mb-0.5 truncate">
                          {step.title}
                        </div>
                        <div class="text-[11px] text-[var(--site-muted)] truncate font-normal">
                          {step.desc}
                        </div>
                      </div>

                    </div>
                  ))
                }
              </div>

            </div>

          </div>
        ))
      }
    </div>

  </main>

</Layout>