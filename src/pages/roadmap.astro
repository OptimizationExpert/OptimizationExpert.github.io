---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const learningPaths = [
  {
    title: "مسیر انرژی و سیستم قدرت",
    subtitle: "پخش بار، شبکه‌های توزیع و مدل‌سازی ریسک",
    icon: "fa-solid fa-bolt",
    accentColor: "from-amber-500/25 to-orange-500/25 text-amber-500 border-amber-500/30",
    steps: [
      { number: "۱", title: "مدل‌سازی مسائل بهینه‌سازی", desc: "آشنایی با متغیرها، تابع هدف و محدودیت‌ها" },
      { number: "۲", title: "بهینه‌سازی سیستم‌های قدرت", desc: "تحلیل و پخش بار بهینه در شبکه‌های الکتریکی" },
      { number: "۳", title: "مدل‌سازی عدم قطعیت", desc: "بررسی ریسک و بهینه‌سازی استوار در انرژی" }
    ]
  },
  {
    title: "مسیر حمل‌ونقل و لجستیک",
    subtitle: "بهینه‌سازی ناوگان، مسیریابی و زنجیره تأمین",
    icon: "fa-solid fa-truck-fast",
    accentColor: "from-blue-500/20 to-sky-500/20 text-blue-500 border-blue-500/30",
    steps: [
      { number: "۱", title: "مدل‌سازی مسائل بهینه‌سازی", desc: "آشنایی با متغیرها، تابع هدف و محدودیت‌ها" },
      { number: "۲", title: "آموزش VRP در Python", desc: "حل مسائل مسیریابی وسایل نقلیه با پایتون" },
      { number: "۳", title: "توسعه پروژه‌های واقعی لجستیک", desc: "پیاده‌سازی سناریوهای صنعتی و زنجیره تأمین" }
    ]
  }
];
---

<Layout title="مسیر پیشنهادی یادگیری" description="برای ورود اصولی به بهینه‌سازی، ابتدا مدل‌سازی را یاد بگیرید، سپس وارد حوزه تخصصی مورد علاقه خود شوید.">

  <Header />

  <main class="max-w-5xl mx-auto px-6 py-12 flex-grow w-full">
    
    <!-- هدر صفحه -->
    <div class="mb-14 text-center border-b border-[var(--site-border)] pb-8">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4 shadow-xs">
        <i class="fa-solid fa-map-location-dot"></i>
        <span>نقشه راه تخصصی</span>
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-3 tracking-tight">
        مسیر پیشنهادی یادگیری
      </h1>
      <p class="text-[var(--site-muted)] text-sm md:text-base leading-relaxed max-w-xl mx-auto">
        برای ورود اصولی به بهینه‌سازی، ابتدا مدل‌سازی را یاد بگیرید، سپس وارد حوزه تخصصی مورد علاقه خود شوید.
      </p>
    </div>

    <!-- کارت‌های مسیرها -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        learningPaths.map((path) => (
          <div class="bg-[var(--site-card)] border border-[var(--site-border)] p-6 md:p-8 rounded-3xl shadow-xs hover:border-[var(--site-primary)]/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            
            <div>
              <!-- هدر کارت -->
              <div class="text-center mb-8 pb-6 border-b border-[var(--site-border)]">
                <div class={`w-14 h-14 mx-auto rounded-2xl bg-gradient-to-br ${path.accentColor} border flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform shadow-sm`}>
                  <i class={path.icon}></i>
                </div>
                <h2 class="text-xl font-bold text-[var(--site-heading)] mb-1">
                  {path.title}
                </h2>
                <p class="text-xs text-[var(--site-muted)] font-medium">
                  {path.subtitle}
                </p>
              </div>

              <!-- لیست مراحل با خط اتصال عمودی -->
              <div class="relative space-y-4 pr-3">
                <!-- خط اتصال ظریف بین مراحل -->
                <div class="absolute right-5 top-5 bottom-5 w-0.5 bg-[var(--site-border)] -z-0"></div>

                {
                  path.steps.map((step, idx) => (
                    <div class="relative z-10 bg-[var(--site-bg)] border border-[var(--site-border)] p-4 rounded-2xl flex items-center gap-4 hover:border-[var(--site-primary)]/30 transition shadow-2xs">
                      
                      <!-- شماره مرحله -->
                      <div class={`w-9 h-9 rounded-xl font-bold text-xs flex items-center justify-center shrink-0 shadow-xs ${idx === 2 ? 'bg-emerald-500 text-white shadow-emerald-500/20' : 'bg-[var(--site-primary)] text-white shadow-[var(--site-primary)]/20'}`}>
                        {step.number}
                      </div>

                      <!-- توضیحات مرحله -->
                      <div class="flex-1 min-w-0 text-right">
                        <div class="text-sm font-bold text-[var(--site-heading)] mb-0.5 truncate">
                          {step.title}
                        </div>
                        <div class="text-[11px] text-[var(--site-muted)] truncate">
                          {step.desc}
                        </div>
                      </div>

                    </div>
                  ))
                }
              </div>

            </div>

          </div>
        ))
      }
    </div>

  </main>

  <Footer />

</Layout>