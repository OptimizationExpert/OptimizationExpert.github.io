---
// src/components/ScrollerControls.astro
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="hidden lg:flex items-center gap-2" role="group" aria-label="کنترل‌های جابجایی کارت‌ها">
  <button
    type="button"
    class="scroll-arrow-btn w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-[var(--site-border)] text-gray-400 hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/40 hover:bg-[var(--site-primary)]/10 transition-all duration-300 shadow-sm"
    data-scroll-target={id}
    data-scroll-dir="prev"
    aria-label="کارت‌های قبلی"
    aria-controls={id}
  >
    <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
  </button>
  
  <button
    type="button"
    class="scroll-arrow-btn w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-[var(--site-border)] text-gray-400 hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/40 hover:bg-[var(--site-primary)]/10 transition-all duration-300 shadow-sm"
    data-scroll-target={id}
    data-scroll-dir="next"
    aria-label="کارت‌های بعدی"
    aria-controls={id}
  >
    <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
  </button>
</div>