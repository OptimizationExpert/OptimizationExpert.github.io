---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  instructorSlug?: string;
}

const { instructorSlug } = Astro.props;

const instructors = await getCollection('instructors');
// توجه: عمداً fallback به مدرس دیگر نداریم؛ اگر اسلاگ نامعتبر/خالی باشد
// باید هیچ‌چیز نمایش داده نشود، نه یک مدرس تصادفی و اشتباه.
const instructor = instructorSlug
  ? instructors.find(i => i.id.replace(/\.md$/, '').split('/').pop() === instructorSlug)
  : undefined;
const slug = instructor ? instructor.id.replace(/\.md$/, '').split('/').pop() : '';

let Content = null;
if (instructor) {
  const rendered = await render(instructor);
  Content = rendered.Content;
}
---

{instructor && (
  <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-6 md:p-8 my-10 shadow-xs relative group">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--site-primary)]">
        <i class="fa-solid fa-chalkboard-user"></i>
        <span>مدرس دوره</span>
      </div>
      <a href={`/instructors/${slug}`} class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1 transition font-medium">
        <span>مشاهده پروفایل و آثار</span>
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
      </a>
    </div>

    <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
      {instructor.data.image && (
        <a href={`/instructors/${slug}`} class="w-28 h-28 md:w-32 md:h-32 rounded-2xl overflow-hidden border-2 border-[var(--site-primary)]/30 bg-[var(--site-bg)] flex-shrink-0 shadow-md block">
          {typeof instructor.data.image === 'string' ? (
            <img src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          ) : (
            <Image src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          )}
        </a>
      )}

      <div class="flex-grow text-center md:text-right">
        <a href={`/instructors/${slug}`} class="inline-block">
          <h3 class="text-xl font-bold text-[var(--site-heading)] hover:text-[var(--site-primary)] transition mb-1">
            {instructor.data.name}
          </h3>
        </a>
        {instructor.data.title && (
          <p class="text-xs text-[var(--site-primary)] font-medium mb-4">
            {instructor.data.title}
          </p>
        )}

        <div class="text-[var(--site-text)] text-sm leading-relaxed prose max-w-none">
          {Content && <Content />}
        </div>
      </div>
    </div>
  </div>
)}