---
import Layout from '../layouts/Layout.astro';

const linkCategories = [
  {
    category: "جامعه و کانال‌های تخصصی",
    icon: "fa-solid fa-users-rectangle",
    links: [
      {
        title: "Pyomo, python, optimization",
        description: "بهینه سازی و تحقيق در عمليات در پایتون (@pyomochannel)",
        url: "https://t.me/pyomochannel",
        icon: "fa-brands fa-telegram",
        badge: "کانال تلگرام",
        noLink: false
      },
      {
        title: "Pyomo Q&A",
        description: "گروه پرسش و پاسخ تخصصی پیرامون فریمورک پایتونی Pyomo و مباحث مرتبط.",
        url: "#",
        icon: "fa-brands fa-telegram",
        badge: "گروه تلگرام",
        noLink: true
      },
      {
        title: "Optimization Expert (GitHub)",
        description: "مخازن کد، پروژه‌های بهینه‌سازی و نمونه کدهای تخصصی در گیت‌هاب.",
        url: "https://github.com/OptimizationExpert",
        icon: "fa-brands fa-github",
        badge: "گیت‌هاب",
        noLink: false
      }
    ]
  },
  {
    category: "سالورها و ابزارهای بهینه‌سازی",
    icon: "fa-solid fa-sliders",
    links: [
      {
        title: "Pyomo Documentation",
        description: "مستندات رسمی و راهنمای جامع فریمورک پایتونی Pyomo برای مدل‌سازی ریاضی.",
        url: "https://pyomo.readthedocs.io/",
        icon: "fa-solid fa-book",
        badge: "مستندات",
        noLink: false
      },
      {
        title: "HiGHS Optimization Solver",
        description: "سالور متن‌باز، مدرن و پرسرعت برای مسائل برنامه‌ریزی خطی و اعداد صحیح مختلط (MIP).",
        url: "https://highs.dev/",
        icon: "fa-solid fa-bolt",
        badge: "سالور",
        noLink: false
      },
      {
        title: "COIN-OR Initiative",
        description: "مجموعه ابزارها و سالورهای متن‌باز صنعتی برای بهینه‌سازی (شامل CBC، IPOPT و...).",
        url: "https://www.coin-or.org/",
        icon: "fa-solid fa-cubes",
        badge: "ابزار صنعتی",
        noLink: false
      }
    ]
  },
  {
    category: "برنامه‌نویسی و محیط‌های توسعه پایتون",
    icon: "fa-solid fa-code",
    links: [
      {
        title: "Python Official Website",
        description: "مرجع اصلی زبان برنامه‌نویسی پایتون، دانلود مفسر و مستندات رسمی کتابخانه‌ها.",
        url: "https://www.python.org/",
        icon: "fa-brands fa-python",
        badge: "مرجع پایتون",
        noLink: false
      },
      {
        title: "Jupyter Project",
        description: "محیط برنامه‌نویسی تعاملی و نوت‌بوک‌های قدرتمند برای تحلیل داده و شبیه‌سازی.",
        url: "https://jupyter.org/",
        icon: "fa-solid fa-laptop-code",
        badge: "محیط توسعه",
        noLink: false
      }
    ]
  },
  {
    category: "سیستم‌های قدرت و مهندسی",
    icon: "fa-solid fa-bolt",
    links: [
      {
        title: "IEEE Xplore Digital Library",
        description: "مرجع بین‌المللی مقالات علمی، استانداردها و پژوهش‌های مهندسی برق و سیستم‌های قدرت.",
        url: "https://ieeexplore.ieee.org/",
        icon: "fa-solid fa-graduation-cap",
        badge: "مقالات علمی",
        noLink: false
      }
    ]
  }
];
---

<Layout title="لینک‌های مفید" description="مجموعه‌ای از وب‌سایت‌های مرجع، مستندات رسمی و ابزارهای کاربردی در حوزه بهینه‌سازی، برنامه‌نویسی و مهندسی." breadcrumbs={[{ name: 'خانه', url: '/' }, { name: 'لینک‌های مفید' }]}>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-16 flex-grow w-full">

    <div class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] text-xs font-bold mb-4">
        <i class="fa-solid fa-compass" aria-hidden="true"></i>
        <span>مرجع جامع ابزارها و جوامع تخصصی</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--site-heading)] mb-4 tracking-tight">
        لینک‌های مفید و مراجع تخصصی
      </h1>
      <p class="text-[var(--site-muted)] text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        مجموعه‌ای گلچین‌شده از وب‌سایت‌های مرجع، مستندات رسمی، سالورهای قدرتمند و جوامع تخصصی فعال در حوزه بهینه‌سازی و مهندسی.
      </p>
    </div>

    <div class="space-y-16">
      {linkCategories.map((section) => (
        <section class="space-y-6">
          
          <div class="flex items-center gap-3 border-b border-[var(--site-border)] pb-4">
            <span class="w-9 h-9 rounded-xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] flex items-center justify-center text-sm shadow-xs" aria-hidden="true">
              <i class={section.icon}></i>
            </span>
            <h2 class="text-lg sm:text-xl font-black text-[var(--site-heading)] tracking-tight">
              {section.category}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {section.links.map((item) => {
              if (item.noLink) {
                return (
                  <div class="bg-[var(--site-card)] border border-[var(--site-primary)]/30 hover:border-[var(--site-primary)]/60 rounded-3xl p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all duration-300">
                    <div>
                      <div class="flex items-center justify-between mb-4">
                        <span class="w-12 h-12 rounded-2xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/30 text-[var(--site-primary)] flex items-center justify-center text-base shadow-xs" aria-hidden="true">
                          <i class={item.icon}></i>
                        </span>
                        <div class="flex items-center gap-2">
                          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--site-accent)]/10 border border-[var(--site-accent)]/20 text-[var(--site-accent)] text-[10px] font-bold">
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-accent)] animate-pulse" aria-hidden="true"></span>
                            گروه فعال
                          </span>
                          <span class="px-2.5 py-1 rounded-full bg-[var(--site-border)]/40 text-[var(--site-muted)] text-[10px] font-bold">
                            {item.badge}
                          </span>
                        </div>
                      </div>

                      <h3 class="text-base sm:text-lg font-extrabold text-[var(--site-heading)] mb-2 leading-snug">
                        {item.title}
                      </h3>

                      <p class="text-[var(--site-muted)] text-xs sm:text-sm leading-relaxed font-normal">
                        {item.description}
                      </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-[var(--site-border)]/60 flex items-center justify-between text-xs text-[var(--site-muted)]">
                      <span class="font-medium italic">محیط پرسش و پاسخ تخصصی</span>
                      <i class="fa-solid fa-users text-[var(--site-primary)]" aria-hidden="true"></i>
                    </div>
                  </div>
                );
              } else {
                return (
                  <a 
                    href={item.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="bg-[var(--site-card)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 rounded-3xl p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all duration-300 group"
                  >
                    <div>
                      <div class="flex items-center justify-between mb-4">
                        <span class="w-12 h-12 rounded-2xl bg-[var(--site-primary)]/10 border border-[var(--site-primary)]/20 text-[var(--site-primary)] flex items-center justify-center text-base shadow-xs" aria-hidden="true">
                          <i class={item.icon}></i>
                        </span>
                        <div class="flex items-center gap-2">
                          <span class="px-2.5 py-1 rounded-full bg-[var(--site-border)]/40 text-[var(--site-muted)] text-[10px] font-bold">
                            {item.badge}
                          </span>
                          <span class="w-8 h-8 rounded-xl bg-[var(--site-border)]/30 text-[var(--site-muted)] group-hover:bg-[var(--site-primary)] group-hover:text-white flex items-center justify-center transition-all duration-300" aria-hidden="true">
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                          </span>
                        </div>
                      </div>

                      <h3 class="text-base sm:text-lg font-extrabold text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition-colors mb-2 leading-snug">
                        {item.title}
                      </h3>

                      <p class="text-[var(--site-muted)] text-xs sm:text-sm leading-relaxed line-clamp-2 font-normal">
                        {item.description}
                      </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-[var(--site-border)]/60 flex items-center justify-between text-xs text-[var(--site-muted)] group-hover:text-[var(--site-primary)] transition-colors font-semibold">
                      <span>مشاهده و ورود</span>
                      <i class="fa-solid fa-arrow-left-long group-hover:-translate-x-1.5 transition-transform duration-300" aria-hidden="true"></i>
                    </div>
                  </a>
                );
              }
            })}
          </div>

        </section>
      ))}
    </div>

  </main>

</Layout>