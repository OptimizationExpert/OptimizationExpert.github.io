---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import { imgSrc } from '../../utils/image';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { projectSlug: project.id.replace(/\.md$/, '').split('/').pop() },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectSlug = project.id.replace(/\.md$/, '').split('/').pop();

const displayImage = project.data.image || project.data.minimalImage;
---

<Layout
  title={project.data.seoTitle || project.data.title}
  description={project.data.description}
  image={imgSrc(displayImage)}
  type="article"
  pubDate={project.data.pubDate}
  author="Optimization Expert"
  breadcrumbs={[
    { name: 'خانه', url: '/' },
    { name: 'پروژه‌ها', url: '/projects' },
    { name: project.data.title },
  ]}
>

  <main class="max-w-3xl mx-auto px-6 py-12 flex-grow w-full">
     
    <div class="mb-6">
      <a href="/projects" class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <span>بازگشت به پروژه‌ها</span>
      </a>
    </div>

    <article>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          {project.data.category && (
            <span class="text-xs font-semibold text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {project.data.category}
            </span>
          )}
          
          {project.data.environment && (
            <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {project.data.environment}
            </span>
          )}

          {project.data.status && (
            <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {project.data.status}
            </span>
          )}

          {project.data.level && (
            <span class="text-xs font-medium text-[var(--site-primary)] bg-[var(--site-primary)]/10 px-3.5 py-1.5 rounded-full border border-[var(--site-primary)]/25 shadow-xs">
              {project.data.level}
            </span>
          )}
        </div>

        {project.data.pubDate && (
          <span class="text-xs text-[var(--site-muted)] flex items-center gap-1.5 bg-[var(--site-bg)] px-3.5 py-1.5 rounded-full border border-[var(--site-border)] shadow-xs self-start sm:self-auto shrink-0">
            <i class="fa-regular fa-calendar text-[var(--site-primary)]"></i>
            <span>{project.data.pubDate.toLocaleDateString('fa-IR')}</span>
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--site-heading)] mb-6 leading-tight">
        {project.data.title}
      </h1>

      <p class="text-[var(--site-text)] text-base md:text-lg leading-relaxed mb-6 bg-[var(--site-card)] p-5 rounded-2xl border border-[var(--site-border)] shadow-xs">
        {project.data.description}
      </p>

      {displayImage && (
        <div class="w-full rounded-2xl overflow-hidden border border-[var(--site-border)] mb-8 bg-[var(--site-card)] flex items-center justify-center shadow-md">
          {typeof displayImage === 'string' ? (
            <img src={displayImage} alt={project.data.title} class="w-full h-auto object-contain" />
          ) : (
            <Image src={displayImage} alt={project.data.title} class="w-full h-auto object-contain" />
          )}
        </div>
      )}

      <div class="prose max-w-none leading-loose text-[var(--site-text)] space-y-6 mb-10">
        <Content />
      </div>

      <hr class="border-[var(--site-border)] mb-10" />

      <TelegramCTA
        icon="fa-circle-question"
        heading="ثبت‌نام و دریافت پروژه"
        description="برای دریافت پروژه و راهنمایی، در تلگرام به آیدی"
      />

      <RelatedContent currentSlug={projectSlug} tags={project.data.tags} />

    </article>

  </main>

</Layout>