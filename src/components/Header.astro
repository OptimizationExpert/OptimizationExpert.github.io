---
// Header.astro
const currentPath = Astro.url.pathname;
// مطابقت دقیق یا زیرمسیر (مثلاً /courses/x باید منوی «دوره‌ها» را هم فعال کند)
// بدون اینکه مسیرهای هم‌پیشوند نامرتبط (مثلاً /courses-old) به‌اشتباه match شوند
const isActive = (href: string) => {
  const normalizedCurrentPath = currentPath.replace(/\/$/, '') || '/';
  const normalizedHref = href.replace(/\/$/, '') || '/';
  return normalizedCurrentPath === normalizedHref || normalizedCurrentPath.startsWith(`${normalizedHref}/`);
};

// یک منبع واحد برای آیتم‌های منو — هم در نوار دسکتاپ و هم در پنل موبایل
// استفاده می‌شود تا هیچ آیتمی در دو جا جداگانه نوشته نشود.
const navItems = [
  { title: 'دوره‌ها', href: '/courses/', icon: 'fa-graduation-cap' },
  { title: 'پروژه‌ها', href: '/projects/', icon: 'fa-layer-group' },
  { title: 'یادداشت‌ها', href: '/notes/', icon: 'fa-pen-nib' },
  { title: 'کتاب‌ها و جزوات', href: '/books/', icon: 'fa-book-open' },
  { title: 'دانلود نرم‌افزار', href: '/softwares/', icon: 'fa-download' },
  { title: 'مسیر یادگیری', href: '/roadmap/', icon: 'fa-map' },
  { title: 'لینک‌های مفید', href: '/links/', icon: 'fa-link' },
  { title: 'درباره ما', href: '/about/', icon: 'fa-user-astronaut' },
  { title: 'نظر کاربران', href: '/testimonials/', icon: 'fa-comment-dots' },
  { title: 'تماس با ما', href: '/contact/', icon: 'fa-envelope' },
];

// پنل موبایل علاوه‌بر آیتم‌های اصلی، لینک «مشاوره تخصصی» را هم دارد (چون
// دکمه‌ی جداگانه‌ی مشاوره در نوار بالا فقط از sm به بالا دیده می‌شود).
const mobileNavItems = [
  ...navItems.slice(0, 6),
  { title: 'مشاوره تخصصی', href: '/consultation/', icon: 'fa-headset' },
  ...navItems.slice(6),
];
---
<header class="sticky top-0 z-50 w-full relative bg-[var(--site-card)]/90 backdrop-blur-md border-b border-[var(--site-border)] transition-colors duration-200">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="h-16 sm:h-20 flex items-center justify-between gap-4">
      
      <div class="flex items-center gap-3.5 flex-shrink-0">
        <a href="/" class="group flex items-center gap-3 focus:outline-none">
          <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
            <img src="/favicon.svg" alt="لوگو مدل‌سازی و بهینه‌سازی" class="w-7 h-7 sm:w-8 sm:h-8 object-contain" loading="eager" />
          </div>
          <div class="flex flex-col">
            <span class="text-sm sm:text-base font-black tracking-tight text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition-colors">
              مدل‌سازی و بهینه‌سازی کاربردی
            </span>
            <span class="text-[10px] text-[var(--site-muted)] font-medium hidden sm:block">مرجع تخصصی مهندسی، الگوریتم و پایتون</span>
          </div>
        </a>
      </div>

      <!-- جستجوی دسکتاپ -->
      <div class="hidden md:flex flex-grow max-w-md mx-4">
        <form id="desktop-search-form" action="/search/" method="GET" class="relative w-full group" role="search">
          <button type="submit" aria-label="جستجو" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] group-focus-within:text-[var(--site-primary)] transition-colors cursor-pointer bg-transparent border-none">
            <i class="fa-solid fa-magnifying-glass text-xs sm:text-sm" aria-hidden="true"></i>
          </button>
          
          <input 
            type="text" 
            id="desktop-search-input"
            name="q"
            placeholder="جستجو در دوره‌ها، مقالات، پروژه‌ها..."
            aria-label="جستجو در سایت"
            autocomplete="off"
            class="w-full bg-[var(--site-bg)]/80 hover:bg-[var(--site-bg)] border border-[var(--site-border)] rounded-xl pr-10 pl-16 py-2.5 text-[var(--site-text)] text-xs focus:outline-none focus:bg-[var(--site-card)] focus:border-[var(--site-primary)] focus:ring-2 focus:ring-[var(--site-primary)]/20 transition-all shadow-2xs"
          />

          <div class="absolute inset-y-0 left-0 flex items-center pl-3 gap-1.5">
            <button 
              type="button" 
              id="desktop-clear-search" 
              aria-label="پاک کردن جستجو"
              class="hidden text-[var(--site-muted)] hover:text-[var(--site-heading)] transition-colors p-1 cursor-pointer"
            >
              <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
            </button>
          </div>
        </form>
      </div>

      <div class="flex items-center gap-2.5 flex-shrink-0">
        
        <button id="theme-toggle" class="w-10 h-10 relative flex items-center justify-center text-[var(--site-text)] hover:text-[var(--site-primary)] bg-[var(--site-bg)]/60 border border-[var(--site-border)] rounded-xl focus:outline-none hover:border-[var(--site-primary)]/40 transition-all shadow-2xs group" aria-label="تغییر تم سایت">
          <i id="theme-icon-moon" class="fa-solid fa-moon text-xs relative z-10 transition-transform duration-300 group-hover:-rotate-12" aria-hidden="true"></i>
          <i id="theme-icon-sun" class="fa-solid fa-sun text-xs text-[var(--site-gold)] relative z-10 transition-transform duration-300 group-hover:rotate-45" hidden aria-hidden="true"></i>
        </button>

        <!-- دکمه مشاوره تخصصی -->
        <a href="/consultation/" class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-[var(--site-primary)] to-[var(--site-secondary)] text-white px-4 py-2.5 rounded-xl text-xs font-bold shadow-md shadow-[var(--site-primary)]/20 hover:shadow-lg hover:shadow-[var(--site-primary)]/40 hover:brightness-110 transition-all duration-300 hover:-translate-y-0.5 whitespace-nowrap overflow-hidden group">
          <i class="fa-solid fa-headset text-sm group-hover:animate-bounce" aria-hidden="true"></i>
          <span>مشاوره تخصصی</span>
        </a>

        <button id="menu-btn" class="lg:hidden w-10 h-10 flex items-center justify-center text-[var(--site-text)] hover:text-[var(--site-primary)] bg-[var(--site-bg)]/60 border border-[var(--site-border)] rounded-xl focus:outline-none transition-all shadow-2xs" aria-label="منوی ناوبری موبایل" aria-expanded="false" aria-controls="mobile-menu-panel">
          <i class="fa-solid fa-bars text-xs transition-transform duration-200" id="menu-icon" aria-hidden="true"></i>
        </button>
      </div>

    </div>

    <div class="hidden lg:block py-2.5 border-t border-[var(--site-border)]/40">
      <nav class="flex items-center justify-center gap-1.5 xl:gap-2.5 text-xs font-bold" aria-label="منوی اصلی">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`relative group px-3.5 py-2 transition-colors duration-200 whitespace-nowrap flex items-center gap-2 rounded-xl ${
                active
                  ? 'text-[var(--site-primary)] bg-[var(--site-primary)]/10 font-extrabold'
                  : 'text-[var(--site-text)] hover:text-[var(--site-primary)] hover:bg-[var(--site-primary)]/5'
              }`}
            >
              <i
                class={`fa-solid ${item.icon} text-xs text-[var(--site-primary)] transition-all duration-300 ease-out ${
                  active ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0'
                }`}
                aria-hidden="true"
              ></i>
              <span class="relative z-10 transition-transform duration-200 group-hover:translate-x-0.5">{item.title}</span>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- منوی موبایل و تبلت -->
    <div id="mobile-menu-panel" class="lg:hidden hidden absolute inset-x-0 top-full z-[60] max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-[var(--site-border)]/60 bg-[var(--site-card)] shadow-2xl py-4 px-4 sm:px-6">
      <form id="mobile-search-form" action="/search/" method="GET" class="relative w-full mb-4" role="search">
        <button type="submit" aria-label="جستجو" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors cursor-pointer bg-transparent border-none">
          <i class="fa-solid fa-magnifying-glass text-xs" aria-hidden="true"></i>
        </button>
        <input
          type="text"
          id="mobile-search-input"
          name="q"
          placeholder="جستجو در دوره‌ها، مقالات، پروژه‌ها..."
          aria-label="جستجو در سایت"
          autocomplete="off"
          class="w-full bg-[var(--site-bg)]/80 border border-[var(--site-border)] rounded-xl pr-10 pl-10 py-2.5 text-[var(--site-text)] text-xs focus:outline-none focus:border-[var(--site-primary)] focus:ring-2 focus:ring-[var(--site-primary)]/20 transition-all"
        />
        <div class="absolute inset-y-0 left-0 flex items-center pl-3">
          <button 
            type="button" 
            id="mobile-clear-search" 
            aria-label="پاک کردن جستجو"
            class="hidden text-[var(--site-muted)] hover:text-[var(--site-heading)] transition-colors p-1 cursor-pointer"
          >
            <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
          </button>
        </div>
      </form>
      <nav class="grid grid-cols-2 gap-2 text-xs font-bold" aria-label="منوی موبایل">
        {mobileNavItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`flex items-center gap-2.5 px-3 py-3 rounded-xl border transition-colors ${
                active
                  ? 'text-[var(--site-primary)] bg-[var(--site-primary)]/10 border-[var(--site-primary)]/25 font-extrabold'
                  : 'text-[var(--site-text)] bg-[var(--site-bg)]/50 border-[var(--site-border)] hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/30'
              }`}
            >
              <i class={`fa-solid ${item.icon} text-xs text-[var(--site-primary)] w-4 text-center shrink-0`} aria-hidden="true"></i>
              <span class="truncate">{item.title}</span>
            </a>
          );
        })}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
function initHeaderUI(){
 const btn=document.getElementById('menu-btn'),panel=document.getElementById('mobile-menu-panel');
 if(btn&&panel&&btn.dataset.bound!=='true'){
  btn.dataset.bound='true';
  const setOpen=open=>{panel.classList.toggle('hidden',!open);btn.setAttribute('aria-expanded',String(open));const icon=document.getElementById('menu-icon');icon?.classList.toggle('fa-bars',!open);icon?.classList.toggle('fa-xmark',open);document.body.classList.toggle('mobile-menu-open',open);};
  btn.addEventListener('click',()=>setOpen(panel.classList.contains('hidden')));
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!panel.classList.contains('hidden')){setOpen(false);btn.focus();}});
  panel.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setOpen(false)));
 }
 function searchBox(inputId,clearId){
  const input=document.getElementById(inputId),clear=document.getElementById(clearId);
  if(!input||!clear||clear.dataset.bound==='true')return;clear.dataset.bound='true';
  const update=()=>clear.classList.toggle('hidden',input.value.trim().length===0);update();
  input.addEventListener('input',update);clear.addEventListener('click',e=>{e.preventDefault();input.value='';update();input.focus();});
 }
 searchBox('desktop-search-input','desktop-clear-search');searchBox('mobile-search-input','mobile-clear-search');
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initHeaderUI,{once:true});else initHeaderUI();
document.addEventListener('astro:page-load',initHeaderUI);
</script>