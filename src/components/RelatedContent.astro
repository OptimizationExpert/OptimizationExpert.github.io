---
import { getCollection } from 'astro:content';
import ContentCard from './ContentCard.astro';
import Tags from './Tags.astro';
import HorizontalScroller from './HorizontalScroller.astro';
import ScrollerControls from './ScrollerControls.astro';

interface Props {
  currentSlug?: string;
  tags?: string[];
  relatedCourses?: string[];
  relatedNotes?: string[];
  relatedProjects?: string[];
}

const { 
  currentSlug = '', 
  tags = [], 
  relatedCourses: manualCourses = [], 
  relatedNotes: manualNotes = [], 
  relatedProjects: manualProjects = [] 
} = Astro.props;

const allCourses = await getCollection('courses');
const allNotes = await getCollection('notes');
const allProjects = await getCollection('projects');

const defaultImage = "/images/hero.webp";

// تابع کمکی برای فیلتر و انتخاب هوشمند مطالب
// حداقل ۴ مورد نمایش داده می‌شود؛ اگر در frontmatter (relatedCourses/relatedNotes/relatedProjects)
// دستی بیشتر از ۴ مورد مشخص شده باشد، همان تعداد بیشتر نمایش داده می‌شود.
const MIN_ITEMS = 4;

function getFilteredItems(allCollection: any[], manualSlugs: string[] = []) {
  const others = allCollection.filter(item => {
    const slug = item.id.replace(/\.md$/, '').split('/').pop();
    return slug !== currentSlug;
  });

  let selected: any[] = [];

  if (manualSlugs && manualSlugs.length > 0) {
    selected = manualSlugs
      .map(slug => others.find(item => item.id.replace(/\.md$/, '').split('/').pop() === slug))
      .filter(Boolean);
  }

  if (selected.length < MIN_ITEMS && tags && tags.length > 0) {
    const tagMatches = others.filter(item => {
      if (selected.includes(item)) return false;
      const itemTags = item.data.tags || [];
      return itemTags.some((t: string) => tags.includes(t));
    });
    selected = [...selected, ...tagMatches];
  }

  const targetCount = Math.max(MIN_ITEMS, manualSlugs?.length || 0);

  if (selected.length < targetCount) {
    const remaining = others
      .filter(o => !selected.includes(o))
      .sort(() => Math.random() - 0.5);
    selected = [...selected, ...remaining];
  }

  return selected.slice(0, targetCount);
}

const suggestedCourses = getFilteredItems(allCourses, manualCourses);
const suggestedNotes = getFilteredItems(allNotes, manualNotes);
const suggestedProjects = getFilteredItems(allProjects, manualProjects);
---

<div class="mt-16 pt-10 border-t border-[var(--site-border)] space-y-12">
  
  {/* بخش برچسب‌ها (هشتگ‌ها) - از کامپوننت مشترک Tags استفاده می‌شود */}
  <Tags tags={tags} />

  {/* بخش مطالب پیشنهادی مرتبط */}
  <section class="space-y-10">
    <h3 class="text-xl font-black text-[var(--site-heading)] mb-6">مطالب و دوره‌های پیشنهادی</h3>

    {/* دوره‌های پیشنهادی */}
    {suggestedCourses.length > 0 && (
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--site-primary)] flex items-center gap-2">
            <i class="fa-solid fa-graduation-cap"></i> دوره‌های آموزشی مرتبط
          </h4>
          <div class="flex items-center gap-2.5 shrink-0">
            <ScrollerControls id="related-scroller-courses" />
            <a href="/courses" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-3.5 py-2 rounded-xl transition-colors duration-200 inline-flex items-center gap-1.5 group">
              <span>مشاهده همه</span>
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
            </a>
          </div>
        </div>
        <HorizontalScroller id="related-scroller-courses">
          {suggestedCourses.map(course => {
            const slug = course.id.replace(/\.md$/, '').split('/').pop();
            const courseImg = course.data.minimalImage || course.data.image || defaultImage;
            const courseImgAlt = course.data.minimalImageAlt || course.data.imageAlt || course.data.title;

            return (
              <ContentCard
                widthClass="w-[270px] sm:w-[320px] md:w-[360px]"
                href={`/courses/${slug}`}
                image={courseImg}
                imageAlt={courseImgAlt}
                title={course.data.title}
                description={course.data.description}
                badge={course.data.level}
                metaIcon="fa-regular fa-clock"
                metaText={course.data.duration || "دوره کاربردی"}
                actionText="مشاهده دوره"
              />
            );
          })}
        </HorizontalScroller>
      </div>
    )}

    {/* مقالات پیشنهادی */}
    {suggestedNotes.length > 0 && (
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--site-primary)] flex items-center gap-2">
            <i class="fa-solid fa-note-sticky"></i> مقالات و یادداشت‌ها
          </h4>
          <div class="flex items-center gap-2.5 shrink-0">
            <ScrollerControls id="related-scroller-notes" />
            <a href="/notes" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-3.5 py-2 rounded-xl transition-colors duration-200 inline-flex items-center gap-1.5 group">
              <span>مشاهده همه</span>
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
            </a>
          </div>
        </div>
        <HorizontalScroller id="related-scroller-notes">
          {suggestedNotes.map(note => {
            const slug = note.id.replace(/\.md$/, '').split('/').pop();
            const noteImg = note.data.minimalImage || note.data.image || defaultImage;
            const noteImgAlt = note.data.minimalImageAlt || note.data.imageAlt || note.data.title;

            return (
              <ContentCard
                widthClass="w-[270px] sm:w-[320px] md:w-[360px]"
                href={`/notes/${slug}`}
                image={noteImg}
                imageAlt={noteImgAlt}
                title={note.data.title}
                description={note.data.description}
                metaIcon="fa-regular fa-calendar"
                metaText={note.data.pubDate ? new Date(note.data.pubDate).toLocaleDateString('fa-IR') : "مقاله تخصصی"}
                actionText="مطالعه مقاله"
              />
            );
          })}
        </HorizontalScroller>
      </div>
    )}

    {/* پروژه‌های پیشنهادی */}
    {suggestedProjects.length > 0 && (
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--site-primary)] flex items-center gap-2">
            <i class="fa-solid fa-diagram-project"></i> پروژه‌های مهندسی
          </h4>
          <div class="flex items-center gap-2.5 shrink-0">
            <ScrollerControls id="related-scroller-projects" />
            <a href="/projects" class="text-xs font-bold text-[var(--site-primary)] bg-[var(--site-primary)]/10 hover:bg-[var(--site-primary)] hover:text-white px-3.5 py-2 rounded-xl transition-colors duration-200 inline-flex items-center gap-1.5 group">
              <span>مشاهده همه</span>
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
            </a>
          </div>
        </div>
        <HorizontalScroller id="related-scroller-projects">
          {suggestedProjects.map(project => {
            const slug = project.id.replace(/\.md$/, '').split('/').pop();
            const projectImg = project.data.minimalImage || project.data.image || defaultImage;
            const projectImgAlt = project.data.minimalImageAlt || project.data.imageAlt || project.data.title;

            return (
              <ContentCard
                widthClass="w-[270px] sm:w-[320px] md:w-[360px]"
                href={`/projects/${slug}`}
                image={projectImg}
                imageAlt={projectImgAlt}
                title={project.data.title}
                description={project.data.description}
                metaIcon="fa-solid fa-layer-group"
                metaText={project.data.category || "پروژه تخصصی"}
                actionText="بررسی پروژه"
              />
            );
          })}
        </HorizontalScroller>
      </div>
    )}
  </section>
</div>