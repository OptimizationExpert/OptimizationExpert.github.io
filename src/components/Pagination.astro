---
// src/components/Pagination.astro
// کامپوننت مشترک صفحه‌بندی - برای همه‌ی صفحات لیست (دوره‌ها/یادداشت‌ها/پروژه‌ها/نرم‌افزارها/کتاب‌ها)
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
  basePath: string; // مثل "/notes" یا "/books"
}

const { currentPage, lastPage, prevUrl, nextUrl, basePath } = Astro.props;

const navBtnClass = "flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-[var(--site-card)] border border-[var(--site-border)] text-xs font-semibold transition-all duration-300 shadow-xs";
---

{lastPage > 1 && (
  <nav class="flex justify-center items-center gap-2 mt-14" aria-label="Pagination">

    {prevUrl ? (
      <a href={prevUrl} class={`${navBtnClass} text-[var(--site-heading)] hover:border-[var(--site-primary)] hover:text-[var(--site-primary)]`}>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span>صفحه قبل</span>
      </a>
    ) : (
      <span class={`${navBtnClass} text-[var(--site-muted)] opacity-40 cursor-not-allowed`}>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span>صفحه قبل</span>
      </span>
    )}

    <div class="hidden sm:flex items-center gap-1.5 bg-[var(--site-card)] border border-[var(--site-border)] p-1.5 rounded-2xl shadow-xs">
      {Array.from({ length: lastPage }, (_, i) => i + 1).map((pageNum) => {
        const pageLink = pageNum === 1 ? basePath : `${basePath}/${pageNum}`;
        const isActive = currentPage === pageNum;
        const activeClass = "w-9 h-9 flex items-center justify-center rounded-xl text-xs font-bold transition-all duration-300 bg-[var(--site-primary)] text-white shadow-sm scale-105";
        const normalClass = "w-9 h-9 flex items-center justify-center rounded-xl text-xs font-bold transition-all duration-300 text-[var(--site-heading)] hover:bg-[var(--site-primary)]/10 hover:text-[var(--site-primary)]";

        return (
          <a href={pageLink} class={isActive ? activeClass : normalClass}>
            {pageNum}
          </a>
        );
      })}
    </div>

    <div class="sm:hidden px-4 py-2 rounded-2xl bg-[var(--site-card)] border border-[var(--site-border)] text-xs font-bold text-[var(--site-heading)] shadow-xs">
      {currentPage} از {lastPage}
    </div>

    {nextUrl ? (
      <a href={nextUrl} class={`${navBtnClass} text-[var(--site-heading)] hover:border-[var(--site-primary)] hover:text-[var(--site-primary)]`}>
        <span>صفحه بعد</span>
        <i class="fa-solid fa-chevron-left text-[10px]"></i>
      </a>
    ) : (
      <span class={`${navBtnClass} text-[var(--site-muted)] opacity-40 cursor-not-allowed`}>
        <span>صفحه بعد</span>
        <i class="fa-solid fa-chevron-left text-[10px]"></i>
      </span>
    )}

  </nav>
)}