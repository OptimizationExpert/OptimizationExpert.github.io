---
import { buildTagIndex, slugifyTag, MIN_HUB_USES } from '../utils/tags';
interface Props { tags?: string[] }
const rawTags = Astro.props.tags ?? [];
const index = rawTags.length > 0 ? await buildTagIndex() : null;
const items = rawTags.map(name => {
  const slug = slugifyTag(name);
  const hasHubPage = (index?.get(slug)?.items.length ?? 0) >= MIN_HUB_USES;
  return { slug, name, hasHubPage };
});
---
{items.length>0&&<div class="flex flex-wrap items-center gap-2 mb-8" aria-label="برچسب‌ها"><span class="text-xs text-[var(--site-muted)] flex items-center gap-1"><i class="fa-solid fa-tags text-[var(--site-primary)]" aria-hidden="true"></i>برچسب‌ها:</span>{items.map(tag=>tag.hasHubPage?<a href={`/tags/${tag.slug}/`} class="text-xs bg-[var(--site-card)] text-[var(--site-text)] hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/50 px-3 py-1 rounded-full border border-[var(--site-border)] transition-all shadow-2xs"><span class="text-[var(--site-primary)]">#</span>{tag.name}</a>:<a href={`/search/?tag=${encodeURIComponent(tag.name)}`} class="text-xs bg-[var(--site-card)] text-[var(--site-text)] hover:text-[var(--site-primary)] hover:border-[var(--site-primary)]/50 px-3 py-1 rounded-full border border-[var(--site-border)] transition-all shadow-2xs"><span class="text-[var(--site-primary)]">#</span>{tag.name}</a>)}</div>}
