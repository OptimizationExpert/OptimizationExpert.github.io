---
// Footer.astro
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/content';
import { buildTagIndex, MIN_HUB_USES } from '../utils/tags';

const [courses, projects, notes, index] = await Promise.all([
  getCollection('courses', isPublished),
  getCollection('projects', isPublished),
  getCollection('notes', isPublished),
  buildTagIndex(),
]);

const topTags = [...index.values()]
  .filter(b => b.items.length >= MIN_HUB_USES)
  .sort((a, b) => b.items.length - a.items.length)
  .slice(0, 6);

const stats = [
  { icon: 'fa-graduation-cap', value: courses.length, label: 'دوره' },
  { icon: 'fa-layer-group', value: projects.length, label: 'پروژه' },
  { icon: 'fa-pen-nib', value: notes.length, label: 'یادداشت' },
];
---

<footer
  class="relative w-full bg-[var(--site-card)] border-t border-[var(--site-border)] text-[var(--site-text)] pt-16 sm:pt-20 pb-10 sm:pb-12 mt-24 sm:mt-32 transition-colors"
>
  <!-- بخش اصلی فوتر -->
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-12 md:gap-12 pb-12 sm:pb-14 border-b border-[var(--site-border)]"
  >

    <!-- ========================================================= -->
    <!-- برند و معرفی -->
    <!-- ========================================================= -->

    <div class="col-span-2 md:col-span-5 space-y-5">
      <a
        href="/"
        class="group inline-flex items-center gap-3.5 focus:outline-none"
        aria-label="صفحه اصلی"
      >
        <div
          class="flex items-center justify-center transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3"
        >
          <img
            src="/favicon.svg"
            alt="لوگو مرجع تخصصی مدل‌سازی و بهینه‌سازی"
            class="w-9 h-9 object-contain"
            width="36"
            height="36"
          />
        </div>

        <span
          class="text-base sm:text-lg font-black tracking-tight text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition-colors"
        >
          مرجع تخصصی مدل‌سازی و بهینه‌سازی
        </span>
      </a>

      <p
        class="text-xs sm:text-sm leading-relaxed text-[var(--site-muted)] max-w-md font-normal"
      >
        مرجع تخصصی آموزش مدل‌های ریاضی، سالورهای پیشرفته پایتون،
        تحلیل شبکه‌های قدرت و ارائه راهکارهای مهندسی با رویکردی
        کاملاً کاربردی و پروژه‌محور.
      </p>

      <div class="flex items-center gap-5 sm:gap-6 pt-1">
        {stats.map(s => (
          <div class="flex items-center gap-2">
            <i class={`fa-solid ${s.icon} text-[var(--site-primary)] text-xs`} aria-hidden="true"></i>
            <span class="text-xs font-bold text-[var(--site-heading)]">{s.value}<span class="text-[var(--site-muted)] font-medium mr-1">{s.label}</span></span>
          </div>
        ))}
      </div>

      {topTags.length > 0 && (
        <div class="pt-1">
          <p class="text-[10px] font-bold text-[var(--site-muted)] uppercase tracking-widest mb-2.5">پرکاربردترین تگ‌ها</p>
          <div class="flex flex-wrap gap-2">
            {topTags.map(t => (
              <a href={`/tags/${t.slug}/`} class="text-[11px] font-bold text-[var(--site-text)] bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:text-[var(--site-primary)] px-2.5 py-1 rounded-full transition-colors">
                #{t.name}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>


    <!-- ========================================================= -->
    <!-- دسترسی سریع -->
    <!-- ========================================================= -->

    <div class="col-span-1 md:col-span-3 space-y-4">
      <h4
        class="text-xs font-black text-[var(--site-heading)] uppercase tracking-widest flex items-center gap-2"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-[var(--site-primary)] shrink-0"
          aria-hidden="true"
        ></span>

        دسترسی سریع
      </h4>

      <!--
        موبایل: دو ستون
        دسکتاپ: یک ستون
      -->
      <ul
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-2.5 gap-x-4 text-xs font-semibold"
      >
        <li>
          <a
            href="/courses/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              دوره‌های آموزشی
            </span>
          </a>
        </li>

        <li>
          <a
            href="/projects/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              پروژه‌های مهندسی
            </span>
          </a>
        </li>

        <li>
          <a
            href="/notes/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              مقالات و یادداشت‌ها
            </span>
          </a>
        </li>

        <li>
          <a
            href="/books/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              کتاب‌ها و جزوات
            </span>
          </a>
        </li>

        <li>
          <a
            href="/softwares/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              دانلود نرم‌افزار
            </span>
          </a>
        </li>

        <li>
          <a
            href="/links/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              لینک‌های مفید
            </span>
          </a>
        </li>
      </ul>
    </div>


    <!-- ========================================================= -->
    <!-- ارتباط و پشتیبانی -->
    <!-- ========================================================= -->

    <div class="col-span-1 md:col-span-4 space-y-4">
      <h4
        class="text-xs font-black text-[var(--site-heading)] uppercase tracking-widest flex items-center gap-2"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-[var(--site-primary)] shrink-0"
          aria-hidden="true"
        ></span>

        ارتباط و پشتیبانی
      </h4>

      <!--
        موبایل: دو ستون
        دسکتاپ: یک ستون
      -->
      <ul
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-2.5 gap-x-4 text-xs font-semibold"
      >
        <li>
          <a
            href="/consultation/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              درخواست مشاوره
            </span>
          </a>
        </li>

        <li>
          <a
            href="/roadmap/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              مسیر یادگیری
            </span>
          </a>
        </li>

        <li>
          <a
            href="/about/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              درباره ما
            </span>
          </a>
        </li>

        <li>
          <a
            href="/contact/"
            class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors"
          >
            <span
              class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all shrink-0"
              aria-hidden="true"
            ></span>

            <span class="group-hover:translate-x-1 transition-transform">
              تماس با ما
            </span>
          </a>
        </li>
      </ul>
    </div>

  </div>


  <!-- ========================================================= -->
  <!-- بخش پایینی: کپی‌رایت + شبکه‌های اجتماعی -->
  <!-- ========================================================= -->

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-5 text-xs text-[var(--site-muted)]"
  >

    <!-- کپی‌رایت -->
    <p class="font-semibold tracking-tight text-center sm:text-right">
      © ۱۴۰۵ تمامی حقوق محفوظ است.
    </p>


    <!-- ========================================================= -->
    <!-- شبکه‌های اجتماعی -->
    <!-- ========================================================= -->

    <div class="flex items-center justify-center gap-2.5 sm:gap-3">

      <!-- GitHub -->
      <a
        href="https://github.com/OptimizationExpert"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] text-[var(--site-muted)] hover:border-[var(--site-heading)] hover:text-[var(--site-heading)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group"
        aria-label="گیت‌هاب"
      >
        <i
          class="fa-brands fa-github text-sm transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        ></i>
      </a>


      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/soroudi/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] text-[var(--site-muted)] hover:border-blue-500 hover:text-blue-500 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group"
        aria-label="لینکدین"
      >
        <i
          class="fa-brands fa-linkedin text-sm transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        ></i>
      </a>


      <!-- Telegram -->
      <a
        href="https://t.me/pypyid"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] text-[var(--site-muted)] hover:border-sky-400 hover:text-sky-400 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group"
        aria-label="تلگرام"
      >
        <i
          class="fa-brands fa-telegram text-sm transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        ></i>
      </a>


      <!-- YouTube -->
      <a
        href="https://www.youtube.com/@optexpert-org"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] text-[var(--site-muted)] hover:border-red-500 hover:text-red-500 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group"
        aria-label="یوتیوب"
      >
        <i
          class="fa-brands fa-youtube text-sm transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        ></i>
      </a>


      <!-- ===================================================== -->
      <!-- Aparat -->
      <!-- ===================================================== -->

      <a
        href="https://www.aparat.com/OptimizationOnline"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] text-[var(--site-muted)] hover:border-pink-500 hover:text-pink-500 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group"
        aria-label="آپارات"
      >
        <!--
          کلاس .aparat-icon-mask (تعریف‌شده در global.css) باعث می‌شود:
          1. شکل واقعی لوگوی آپارات حفظ شود.
          2. رنگ لوگو از currentColor گرفته شود.
          3. در حالت عادی همان رنگ سایر آیکون‌ها باشد.
          4. هنگام hover به رنگ صورتی تغییر کند.
          5. دیگر مربع توپر نمایش داده نشود.
        -->
        <span
          class="aparat-icon-mask transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        ></span>
      </a>

    </div>
  </div>
</footer>