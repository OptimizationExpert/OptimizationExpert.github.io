---
// Footer.astro - Perfect Theme-Adaptive Edition
---

<footer class="relative w-full bg-[var(--site-card)] border-t border-[var(--site-border)] text-[var(--site-text)] pt-20 pb-12 mt-32 transition-colors">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-[var(--site-border)]">
    
    <!-- ستون اول: برند و معرفی تخصصی (۵ ستون) - بدون کادر دور لوگو -->
    <div class="md:col-span-5 space-y-5">
      <a href="/" class="group inline-flex items-center gap-3.5 focus:outline-none">
        <div class="flex items-center justify-center transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3">
          <img src="/favicon.svg" alt="لوگو مرجع تخصصی مدل‌سازی و بهینه‌سازی" class="w-9 h-9 object-contain" />
        </div>
        <span class="text-base sm:text-lg font-black tracking-tight text-[var(--site-heading)] group-hover:text-[var(--site-primary)] transition-colors">
          مرجع تخصصی مدل‌سازی و بهینه‌سازی
        </span>
      </a>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--site-muted)] max-w-md font-normal">
        مرجع تخصصی آموزش مدل‌های ریاضی، سالورهای پیشرفته پایتون، تحلیل شبکه‌های قدرت و ارائه راهکارهای مهندسی با رویکردی کاملاً کاربردی و پروژه‌محور.
      </p>
    </div>

    <!-- ستون دوم: دسترسی سریع (۳ ستون) -->
    <div class="md:col-span-3 space-y-4">
      <h4 class="text-xs font-black text-[var(--site-heading)] uppercase tracking-widest flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-primary)]"></span>
        دسترسی سریع
      </h4>
      <ul class="space-y-2.5 text-xs font-semibold">
        <li>
          <a href="/courses" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">دوره‌های آموزشی</span>
          </a>
        </li>
        <li>
          <a href="/projects" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">پروژه‌های مهندسی</span>
          </a>
        </li>
        <li>
          <a href="/notes" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">مقالات و یادداشت‌ها</span>
          </a>
        </li>
        <li>
          <a href="/books" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">کتاب‌ها و جزوات</span>
          </a>
        </li>
        <li>
          <a href="/softwares" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">دانلود نرم‌افزار</span>
          </a>
        </li>
        <li>
          <a href="/links" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">لینک‌های مفید</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- ستون سوم: ارتباط و پشتیبانی (۴ ستون) -->
    <div class="md:col-span-4 space-y-4">
      <h4 class="text-xs font-black text-[var(--site-heading)] uppercase tracking-widest flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-primary)]"></span>
        ارتباط و پشتیبانی
      </h4>
      <ul class="space-y-2.5 text-xs font-semibold">
        <li>
          <a href="/consultation" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">درخواست مشاوره</span>
          </a>
        </li>
        <li>
          <a href="/roadmap" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">مسیر یادگیری</span>
          </a>
        </li>
        <li>
          <a href="/about" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">درباره ما</span>
          </a>
        </li>
        <li>
          <a href="/contact" class="group inline-flex items-center gap-2.5 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-colors">
            <span class="w-1 h-1 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span class="group-hover:translate-x-1 transition-transform">تماس با ما</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- بخش پایینی: کپی‌رایت و شبکه‌های اجتماعی هماهنگ با تم تیره و روشن -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--site-muted)]">
    <p class="font-semibold tracking-tight">© ۱۴۰۵ تمامی حقوق محفوظ است.</p>
    
    <!-- دکمه‌های اجتماعی: عمداً با رنگ برند خودِ هر پلتفرم، نه رنگ سایت -->
    <div class="flex items-center gap-3">
      
      <a 
        href="https://github.com/OptimizationExpert" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-heading)] hover:text-[var(--site-heading)] text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group" 
        aria-label="گیت‌هاب"
      >
        <i class="fa-brands fa-github text-sm transition-transform duration-300 group-hover:scale-110"></i>
      </a>

      <a 
        href="https://www.linkedin.com/in/soroudi/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-blue-500 hover:text-blue-500 text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group" 
        aria-label="لینکدین"
      >
        <i class="fa-brands fa-linkedin text-sm transition-transform duration-300 group-hover:scale-110"></i>
      </a>

      <a 
        href="https://t.me/pypyid" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-sky-400 hover:text-sky-400 text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group" 
        aria-label="تلگرام"
      >
        <i class="fa-brands fa-telegram text-sm transition-transform duration-300 group-hover:scale-110"></i>
      </a>

      <a 
        href="https://www.youtube.com/@optexpert-org" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-red-500 hover:text-red-500 text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group" 
        aria-label="یوتیوب"
      >
        <i class="fa-brands fa-youtube text-sm transition-transform duration-300 group-hover:scale-110"></i>
      </a>

      <a 
        href="https://www.aparat.com/OptimizationOnline" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-pink-500 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 group" 
        aria-label="آپارات"
      >
        <span 
          class="w-3.5 h-3.5 bg-current text-[var(--site-muted)] group-hover:hidden"
          style="mask-image: url('/aparat_logo.svg'); -webkit-mask-image: url('/aparat_logo.svg'); mask-size: contain; -webkit-mask-size: contain; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center;"
        ></span>
        <img 
          src="/aparat_logo.svg" 
          alt="آپارات" 
          class="w-3.5 h-3.5 object-contain hidden group-hover:block transition-transform duration-300 group-hover:scale-110" 
        />
      </a>

    </div>
  </div>
</footer>