---
// Footer.astro
---

<footer class="relative bg-[var(--site-card)]/80 backdrop-blur-xl border-t border-[var(--site-border)]/60 text-[var(--site-text)] pt-16 pb-10 mt-24 transition-colors overflow-hidden">
  
  <!-- خط نورانی بالای فوتر -->
  <div class="absolute top-0 right-1/2 translate-x-1/2 w-3/4 max-w-2xl h-[1px] bg-gradient-to-r from-transparent via-[var(--site-primary)]/40 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-10 lg:gap-12 pb-12">
    
    <!-- ستون اول: لوگو دقیقاً مطابق هدر (بدون هیچ هاله یا کادر اضافی) -->
    <div class="md:col-span-2 space-y-4">
      <a href="/" class="group inline-flex items-center gap-3 flex-shrink-0">
        <img src="/favicon.svg" alt="لوگو" class="w-8 h-8 rounded-lg group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 drop-shadow-sm" />
        <span class="text-base sm:text-lg font-extrabold text-[var(--site-heading)] tracking-tight group-hover:text-[var(--site-primary)] transition-colors duration-300">
          مرجع تخصصی مدل‌سازی و بهینه‌سازی
        </span>
      </a>
      <p class="text-xs sm:text-sm leading-relaxed text-[var(--site-muted)] max-w-md font-normal">
        توسعه مرجع تخصصی آموزش مدل‌های ریاضی، سالورهای پیشرفته پایتون، تحلیل شبکه‌های قدرت و ارائه راهکارهای مهندسی با رویکردی کاملاً کاربردی و پروژه‌محور.
      </p>
    </div>

    <!-- ستون دوم: دسترسی سریع -->
    <div class="space-y-4">
      <h4 class="text-xs font-bold text-[var(--site-heading)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--site-primary)]"></span>
        دسترسی سریع
      </h4>
      <ul class="space-y-2.5 text-xs font-medium">
        <li>
          <a href="/courses" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>دوره‌های آموزشی</span>
          </a>
        </li>
        <li>
          <a href="/projects" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>پروژه‌های مهندسی</span>
          </a>
        </li>
        <li>
          <a href="/notes" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>مقالات و یادداشت‌ها</span>
          </a>
        </li>
        <li>
          <a href="/books" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>کتاب‌ها و جزوات</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- ستون سوم: ارتباط و پشتیبانی -->
    <div class="space-y-4">
      <h4 class="text-xs font-bold text-[var(--site-heading)] uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--site-primary)]"></span>
        ارتباط و پشتیبانی
      </h4>
      <ul class="space-y-2.5 text-xs font-medium">
        <li>
          <a href="/consultation" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>درخواست مشاوره</span>
          </a>
        </li>
        <li>
          <a href="/roadmap" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>مسیر یادگیری</span>
          </a>
        </li>
        <li>
          <a href="/about" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>درباره ما</span>
          </a>
        </li>
        <li>
          <a href="/contact" class="group inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-primary)] transition-all duration-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--site-border)] group-hover:bg-[var(--site-primary)] group-hover:scale-125 transition-all"></span>
            <span>تماس با ما</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- بخش پایینی، کپی‌رایت و شبکه‌های اجتماعی -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 border-t border-[var(--site-border)]/40 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--site-muted)]">
    <p class="font-medium">© ۱۴۰۵ تمامی حقوق محفوظ است.</p>
    
    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/OptimizationExpert" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-2xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:text-[var(--site-heading)] hover:bg-[var(--site-card)] text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-md" 
        aria-label="GitHub"
      >
        <i class="fa-brands fa-github text-base"></i>
      </a>
      <a 
        href="https://www.linkedin.com/in/soroudi/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-2xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[#0A66C2]/40 hover:text-[#0A66C2] hover:bg-[#0A66C2]/10 text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-md" 
        aria-label="LinkedIn"
      >
        <i class="fa-brands fa-linkedin text-base"></i>
      </a>
      <a 
        href="https://t.me/pypyid" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-10 h-10 rounded-2xl bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[#24A1DE]/40 hover:text-[#24A1DE] hover:bg-[#24A1DE]/10 text-[var(--site-muted)] flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-md" 
        aria-label="Telegram"
      >
        <i class="fa-brands fa-telegram text-base"></i>
      </a>
    </div>
  </div>
</footer>