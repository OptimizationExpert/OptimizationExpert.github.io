---
// src/components/HorizontalScroller.astro
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<!-- کلاس scroll-smooth حذف شد تا دستی و کاملاً نرم انیمیشن را کنترل کنیم -->
<div
  id={id}
  class="horizontal-scroller flex overflow-x-auto gap-4 sm:gap-6 pt-4 pb-8 snap-x snap-mandatory custom-scrollbar