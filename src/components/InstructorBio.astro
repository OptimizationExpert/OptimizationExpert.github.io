---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { entrySlug, isPublished } from '../utils/content';

interface Props {
  instructorSlug?: string;
  headingLevel?: 'h1' | 'h2';
  linkToProfile?: boolean;
}

const {
  instructorSlug,
  headingLevel = 'h2',
  linkToProfile = true,
} = Astro.props;

const instructors = await getCollection('instructors', isPublished);
const instructor = instructorSlug
  ? instructors.find((item) => entrySlug(item) === instructorSlug)
  : undefined;

const slug = instructor ? entrySlug(instructor) : '';

let Content = null;
if (instructor) {
  const rendered = await render(instructor);
  Content = rendered.Content;
}

const profileUrl = instructor ? `/instructors/${slug}/` : '';
const imageAlt = instructor?.data.imageAlt || instructor?.data.name || '';
---

{instructor && (
  <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-3xl p-6 md:p-10 mb-12 shadow-xs">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
      {instructor.data.image && (
        linkToProfile ? (
          <a
            href={profileUrl}
            class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden border-2 border-[var(--site-primary)]/30 bg-[var(--site-bg)] flex-shrink-0 shadow-md block"
            aria-label={`مشاهده پروفایل ${instructor.data.name}`}
          >
            {typeof instructor.data.image === 'string' ? (
              <img src={instructor.data.image} alt={imageAlt} class="w-full h-full object-cover" />
            ) : (
              <Image src={instructor.data.image} alt={imageAlt} class="w-full h-full object-cover" />
            )}
          </a>
        ) : (
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden border-2 border-[var(--site-primary)]/30 bg-[var(--site-bg)] flex-shrink-0 shadow-md">
            {typeof instructor.data.image === 'string' ? (
              <img src={instructor.data.image} alt={imageAlt} class="w-full h-full object-cover" />
            ) : (
              <Image src={instructor.data.image} alt={imageAlt} class="w-full h-full object-cover" />
            )}
          </div>
        )
      )}

      <div class="flex-grow text-center md:text-right">
        {headingLevel === 'h1' ? (
          <h1 class="text-2xl md:text-3xl font-extrabold text-[var(--site-heading)] mb-2">
            {instructor.data.name}
          </h1>
        ) : linkToProfile ? (
          <a href={profileUrl} class="inline-block">
            <h2 class="text-2xl md:text-3xl font-extrabold text-[var(--site-heading)] hover:text-[var(--site-primary)] transition mb-2">
              {instructor.data.name}
            </h2>
          </a>
        ) : (
          <h2 class="text-2xl md:text-3xl font-extrabold text-[var(--site-heading)] mb-2">
            {instructor.data.name}
          </h2>
        )}

        {instructor.data.jobTitle && (
          <p class="text-sm text-[var(--site-primary)] font-medium mb-4">
            {instructor.data.jobTitle}
          </p>
        )}

        <div class="text-[var(--site-text)] text-sm leading-relaxed prose max-w-none">
          {Content && <Content />}
        </div>
      </div>
    </div>
  </div>
)}
