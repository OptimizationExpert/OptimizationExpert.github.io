---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { entrySlug, isPublished } from '../utils/content';

interface Props {
  instructorSlug?: string;
}

const { instructorSlug } = Astro.props;

const instructors = await getCollection('instructors', isPublished);
// توجه: عمداً fallback به مدرس دیگر نداریم؛ اگر اسلاگ نامعتبر/خالی باشد
// باید هیچ‌چیز نمایش داده نشود، نه یک مدرس تصادفی و اشتباه.
const instructor = instructorSlug
  ? instructors.find(i => entrySlug(i) === instructorSlug)
  : undefined;
const slug = instructor ? entrySlug(instructor) : '';

// Verifiable credentials: the instructor's own public profiles and published books.
// Built from the instructor's frontmatter, so the row updates itself.
const PROFILE_LABELS: Array<[RegExp, string, string]> = [
  [/scholar\.google\./, 'Google Scholar', 'fa-solid fa-graduation-cap'],
  [/orcid\.org/, 'ORCID', 'fa-brands fa-orcid'],
  [/linkedin\.com/, 'LinkedIn', 'fa-brands fa-linkedin'],
  [/researchgate\.net/, 'ResearchGate', 'fa-brands fa-researchgate'],
  [/ieee\.org/, 'IEEE', 'fa-solid fa-certificate'],
  [/github\.com/, 'GitHub', 'fa-brands fa-github'],
];
const profileLinks = instructor
  ? [...new Set([instructor.data.githubUrl, instructor.data.linkedinUrl, ...(instructor.data.sameAs ?? [])].filter(Boolean) as string[])]
      .map((url) => {
        const match = PROFILE_LABELS.find(([re]) => re.test(url));
        return match ? { url, label: match[1], icon: match[2] } : null;
      })
      .filter((x): x is { url: string; label: string; icon: string } => Boolean(x))
  : [];
const bookLinks = instructor
  ? (instructor.data.books ?? []).map((b) => ({
      url: b.url,
      label: `کتاب ${b.publisher ?? ''}`.trim(),
      title: b.name,
      icon: 'fa-solid fa-book',
    }))
  : [];
const credentialLinks = [...bookLinks, ...profileLinks];

let Content = null;
if (instructor) {
  const rendered = await render(instructor);
  Content = rendered.Content;
}
---

{instructor && (
  <div class="bg-[var(--site-card)] border border-[var(--site-border)] rounded-2xl p-6 md:p-8 my-10 shadow-xs relative group">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--site-primary)]">
        <i class="fa-solid fa-chalkboard-user"></i>
        <span>مدرس دوره</span>
      </div>
      <a href={`/instructors/${slug}/`} class="text-xs text-[var(--site-primary)] hover:opacity-80 inline-flex items-center gap-1 transition font-medium">
        <span>مشاهده پروفایل و آثار</span>
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
      </a>
    </div>

    <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
      {instructor.data.image && (
        <a href={`/instructors/${slug}/`} class="w-28 h-28 md:w-32 md:h-32 rounded-2xl overflow-hidden border-2 border-[var(--site-primary)]/30 bg-[var(--site-bg)] flex-shrink-0 shadow-md block">
          {typeof instructor.data.image === 'string' ? (
            <img src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          ) : (
            <Image src={instructor.data.image} alt={instructor.data.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
          )}
        </a>
      )}

      <div class="flex-grow text-center md:text-right">
        <a href={`/instructors/${slug}/`} class="inline-block">
          <h3 class="text-xl font-bold text-[var(--site-heading)] hover:text-[var(--site-primary)] transition mb-1">
            {instructor.data.name}
          </h3>
        </a>
        {instructor.data.jobTitle && (
          <p class="text-sm text-[var(--site-primary)] font-medium mb-4">
            {instructor.data.jobTitle}
          </p>
        )}

        <div class="text-[var(--site-text)] text-sm leading-relaxed prose max-w-none">
          {Content && <Content />}
        </div>

        {credentialLinks.length > 0 && (
          <div class="mt-5 pt-4 border-t border-[var(--site-border)]">
            <p class="text-xs font-semibold text-[var(--site-muted)] mb-2.5">سوابق قابل بررسی</p>
            <ul class="flex flex-wrap justify-center md:justify-start gap-2">
              {credentialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={'title' in link ? (link as any).title : link.label}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--site-text)] bg-[var(--site-bg)] border border-[var(--site-border)] hover:border-[var(--site-primary)]/50 hover:text-[var(--site-primary)] px-3 py-1.5 rounded-full transition-colors"
                  >
                    <i class={`${link.icon} text-[var(--site-primary)]`} aria-hidden="true"></i>
                    <span dir="auto">{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
)}